@model JamesPetBoarding.Models.IndexViewModel

@{
    ViewBag.Title = "Account Settings";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1>Paws &amp; Reservations, LLC</h1>
    <h2>Account Settings</h2>
    <p class="lead">
        Manage your profile and account security settings.
    </p>
</div>

@if (!string.IsNullOrWhiteSpace(ViewBag.StatusMessage))
{
    <div class="alert alert-success" role="alert">
        @ViewBag.StatusMessage
    </div>
}

<div class="row justify-content-center">
    <div class="col-md-6">

        <div class="card mb-4">
            <div class="card-body">

                <h4 class="card-title">My Profile</h4>

                <p class="card-text">
                    View or update your employee profile information.
                </p>

                @Html.ActionLink(
                    "View My Profile",
                    "MyProfile",
                    "Employees",
                    null,
                    new { @class = "btn btn-primary me-2" })

                @Html.ActionLink(
                    "Update My Profile",
                    "UpdateMyProfile",
                    "Employees",
                    null,
                    new { @class = "btn btn-secondary" })

            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">

                <h4 class="card-title">Password</h4>

                <p class="card-text">
                    Update the password used to access your account.
                </p>

                @if (Model.HasPassword)
                {
                    @Html.ActionLink(
                        "Change Password",
                        "ChangePassword",
                        "Manage",
                        null,
                        new { @class = "btn btn-primary" })
                }
                else
                {
                    @Html.ActionLink(
                        "Create Password",
                        "SetPassword",
                        "Manage",
                        null,
                        new { @class = "btn btn-primary" })
                }

            </div>

        </div>
        <div class="card mb-4">
            <div class="card-body">

                <h4 class="card-title">Two-Factor Authentication</h4>

                @if (Model.TwoFactor)
                {
                    <p class="card-text">
                        Two-factor authentication is currently enabled.
                        A security code will be sent to your email address when you sign in.
                    </p>

                    using (Html.BeginForm(
                        "DisableTwoFactorAuthentication",
                        "Manage",
                        FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <button type="submit" class="btn btn-danger">
                            Disable Two-Factor Authentication
                        </button>
                    }
                }
                else
                {
                    <p class="card-text">
                        Add an extra layer of security to your account.
                        When enabled, a security code will be sent to your email address when you sign in.
                    </p>

                    using (Html.BeginForm(
                        "EnableTwoFactorAuthentication",
                        "Manage",
                        FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <button type="submit" class="btn btn-primary">
                            Enable Two-Factor Authentication
                        </button>
                    }
                }

            </div>
        </div>
    </div>
</div>
