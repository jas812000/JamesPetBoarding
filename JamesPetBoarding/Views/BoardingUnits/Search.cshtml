@model JamesPetBoarding.ViewModels.BoardingUnitSearchVM
@{
    ViewBag.Title = "Search Boarding Units";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Search Boarding Units</h2>
    <p class="lead">
        Search by one or more fields to find an existing boarding unit profile.
    </p>
</div>

@using (Html.BeginForm("Search", "BoardingUnits", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    @* Unit Type / Unit Name / Unit Number *@


            <div class="col-auto" style="width: 350px;">
        <label class="form-label">Unit Type</label>

                @Html.EnumDropDownListFor(
                    x => x.UnitType,
                    "Select...",
                    new
                    {
                        @class = "form-select",
                        style = "max-width: none;"
                    })
            </div>

            <div class="col-auto" style="width: 350px;">
        <label class="form-label">Unit Name</label>

                @Html.EnumDropDownListFor(
                    x => x.UnitName,
                    "Select...",
                    new
                    {
                        @class = "form-select",
                        style = "max-width: none;"
                    })
            </div>

            <div class="col-auto" style="width: 350px;">
        <label class="form-label">Unit Number</label>

                @Html.TextBoxFor(
                    x => x.UnitNumber,
                    new
                    {
                        @class = "form-control",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.UnitNumber,
                    "",
                    new { @class = "text-danger" })
            </div>




    @* Species Allowed / Size Category / Active Status *@


            <div class="w-100"></div>

    <div class="col-auto" style="width: 350px;">
        <label class="form-label">Species Allowed</label>

                @Html.EnumDropDownListFor(
                    x => x.SpeciesAllowed,
                    "Select...",
                    new
                    {
                        @class = "form-select",
                        style = "max-width: none;"
                    })
            </div>

            <div class="col-auto" style="width: 350px;">
        <label class="form-label">Size Category</label>

                @Html.EnumDropDownListFor(
                    x => x.SizeCategory,
                    "Select...",
                    new
                    {
                        @class = "form-select",
                        style = "max-width: none;"
                    })
            </div>

            <div class="col-auto" style="width: 350px;">
        <label class="form-label">Active Status</label>

                @Html.DropDownListFor(
                    x => x.IsActive,
                    new List<SelectListItem>
                    {
                        new SelectListItem
                        {
                            Text = "All Boarding Units",
                            Value = ""
                        },
                        new SelectListItem
                        {
                            Text = "Active",
                            Value = "true"
                        },
                        new SelectListItem
                        {
                            Text = "Inactive",
                            Value = "false"
                        }
                    },
                    new
                    {
                        @class = "form-select",
                        style = "max-width: none;"
                    })

                <small class="text-muted">
                    Select All Boarding Units, Active or Inactive.
                </small>
            </div>




    <div class="col-12 text-center mt-4">
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <button type="submit"
                    class="btn btn-primary"
                    style="width: 300px;">
                Search Boarding Units
            </button>

            @if (ViewBag.CanManageBoardingUnits)
            {
                @Html.ActionLink(
                    "Create Boarding Unit",
                    "Create",
                    "BoardingUnits",
                    null,
                    new
                    {
                        @class = "btn btn-success",
                        style = "width: 300px;"
                    })
            }
        </div>

        <div class="d-flex justify-content-center gap-3 flex-wrap mt-3">
            @Html.ActionLink(
                "Clear Search",
                "Search",
                "BoardingUnits",
                null,
                new
                {
                    @class = "btn btn-secondary",
                    style = "width: 300px;"
                })

            @Html.ActionLink(
                "Back to Dashboard",
                "Index",
                "Dashboard",
                null,
                new
                {
                    @class = "btn btn-secondary",
                    style = "width: 300px;"
                })
        </div>
    </div>
}

@if (Model.BoardingUnitResults != null && Model.BoardingUnitResults.Any())
{
    <h4 class="mt-4">
        Results Found: @Model.BoardingUnitResults.Count
    </h4>

    <div class="mt-3">

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Full Unit Name</th>
                    <th>Unit Type</th>
                    <th>Species Allowed</th>
                    <th>Size Category</th>
                    <th>Active Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var boardingUnit in Model.BoardingUnitResults)
                {
                    <tr>
                        <td>@boardingUnit.FullUnitNameDisplay</td>
                        <td>@boardingUnit.UnitTypeDisplay</td>
                        <td>@boardingUnit.SpeciesAllowedDisplay</td>
                        <td>@boardingUnit.SizeCategoryDisplay</td>

                        <td>
                            @if (boardingUnit.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>

                        <td>
                            @Html.ActionLink(
                               "View",
                               "Read",
                               "BoardingUnits",
                               new { boardingUnitId = boardingUnit.BoardingUnitId },
                               new { @class = "btn btn-primary btn-sm me-1" })

                            @if (ViewBag.CanManageBoardingUnits)
                            {
                                @Html.ActionLink(
                                    "Update",
                                    "Update",
                                    "BoardingUnits",
                                    new { boardingUnitId = boardingUnit.BoardingUnitId },
                                    new { @class = "btn btn-warning btn-sm me-1" })

                                @Html.ActionLink(
                                    "Delete",
                                    "Delete",
                                    "BoardingUnits",
                                    new { boardingUnitId = boardingUnit.BoardingUnitId },
                                    new { @class = "btn btn-danger btn-sm" })
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (Request.HttpMethod == "POST")
{
    <div class="alert alert-info mt-4">
        No boarding units found.
    </div>

}
