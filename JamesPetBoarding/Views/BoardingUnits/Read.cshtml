@model JamesPetBoarding.ViewModels.BoardingUnitDetailsVM
@{
    ViewBag.Title = "Read Boarding Unit";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>View Boarding Unit Profile</h2>
    <p class="lead">
        View boarding unit profile information.
    </p>
</div>

<div class="row g-3 justify-content-center">

    <div class="col-auto" style="width: 400px;">
        <label class="form-label">Boarding Unit ID</label>
        @Html.TextBoxFor(x => x.BoardingUnitId, new { @class = "form-control", @readonly = "readonly", style = "max-width: none;" })
    </div>

    <div class="col-auto" style="width: 450px;">
        <label class="form-label">Full Unit Name</label>
        @Html.TextBoxFor(x => x.FullUnitNameDisplay, new { @class = "form-control", @readonly = "readonly", style = "max-width: none;" })
    </div>

    <div class="col-auto" style="width: 350px;">
        <label class="form-label">Unit Type</label>
        @Html.TextBoxFor(x => x.UnitTypeDisplay, new { @class = "form-control", @readonly = "readonly", style = "max-width: none;" })
    </div>

    <div class="w-100"></div>

    <div class="col-auto" style="width: 350px;">
        <label class="form-label">Species Allowed</label>
        @Html.TextBoxFor(x => x.SpeciesAllowedDisplay, new { @class = "form-control", @readonly = "readonly", style = "max-width: none;" })
    </div>

    <div class="col-auto" style="width: 350px;">
        <label class="form-label">Size Category</label>
        @Html.TextBoxFor(x => x.SizeCategoryDisplay, new { @class = "form-control", @readonly = "readonly", style = "max-width: none;" })
    </div>

    <div class="col-auto" style="width: 350px;">
        <label class="form-label">Active Status</label>
        @Html.TextBoxFor(x => x.ActiveStatusDisplay, new { @class = "form-control", @readonly = "readonly", style = "max-width: none;" })
    </div>

    <div class="w-100"></div>

    <div class="col-auto" style="width: 1000px;">
        <label class="form-label">Notes</label>
        @Html.TextAreaFor(x => x.Notes, new { @class = "form-control", rows = "3", @readonly = "readonly", style = "max-width: none;" })
    </div>

    <div class="col-12 text-center mt-4">
        <div class="d-flex justify-content-center gap-3 flex-wrap">
        @Html.ActionLink(
            "Update Boarding Unit",
            "Update",
            "BoardingUnits",
            new { boardingUnitId = Model.BoardingUnitId },
            new { @class = "btn btn-primary me-2", style = "width: 300px;" })

        @Html.ActionLink(
            "Delete Boarding Unit",
            "Delete",
            "BoardingUnits",
            new { boardingUnitId = Model.BoardingUnitId },
            new { @class = "btn btn-danger me-2", style = "width: 300px;" })

        @Html.ActionLink(
            "Back to Search",
            "Search",
            "BoardingUnits",
            null,
            new { @class = "btn btn-secondary", style = "width: 300px;" })

        </div>
    </div>

</div>
