@model JamesPetBoarding.ViewModels.BoardingUnitDeleteVM
@{
    ViewBag.Title = "Delete Boarding Unit";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Delete Boarding Unit Profile</h2>
    <p class="lead">
        View boarding unit profile information before deletion.
    </p>
</div>


@using (Html.BeginForm("Delete", "BoardingUnits", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    @Html.HiddenFor(x => x.BoardingUnitId)


    <div class="col-md-4">
        <label class="form-label">Boarding Unit ID</label>
        @Html.TextBoxFor(x => x.BoardingUnitId, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Unit Type</label>
        @Html.TextBoxFor(x => x.UnitTypeDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Full Unit Name</label>
        @Html.TextBoxFor(x => x.FullUnitNameDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Species Allowed</label>
        @Html.TextBoxFor(x => x.SpeciesAllowedDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-3">
        <label class="form-label">Size Category</label>
        @Html.TextBoxFor(x => x.SizeCategoryDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-3">
        <label class="form-label">Active Status</label>
        @Html.TextBoxFor(x => x.ActiveStatusDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-12">
        <label class="form-label">Notes</label>
        @Html.TextAreaFor(x => x.Notes, new { @class = "form-control", rows = "3", @readonly = "readonly" })
    </div>

    <div class="col-md-12">
        <div class="alert alert-warning">
            This action will permanently delete this boarding unit profile and cannot be undone.
            Deletion will be blocked if the boarding unit is associated with any boarding records.
        </div>
    </div>

    <div class="col-md-12 text-center mt-4">
        <button type="submit" class="btn btn-danger me-2">Delete Boarding Unit Profile</button>

        @Html.ActionLink(
            "Cancel", 
            "Read", 
            "BoardingUnits",
            new { boardingUnitId = Model.BoardingUnitId },
            new { @class = "btn btn-secondary ms-2" }
         )
    </div>

}
