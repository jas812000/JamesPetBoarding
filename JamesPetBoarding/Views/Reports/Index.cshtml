@{
    ViewBag.Title = "Reports";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1>Paws &amp; Reservations, LLC</h1>
    <h2>Reports</h2>
    <p class="lead">
        Select a report to generate.
    </p>
</div>

<h3 class="text-center mt-4 mb-3">Customer &amp; Pet Reports</h3>

<div class="row g-3 justify-content-center">

    <div class="col-auto" style="width: 340px;">
        @Html.ActionLink(
            "Customer Activity Report",
            "CustomerActivityReport",
            "Reports",
            null,
            new
            {
                @class = "btn btn-primary w-100 d-flex align-items-center justify-content-center",
                style = "min-height: 70px;"
            })
    </div>

    <div class="col-auto" style="width: 340px;">
        @Html.ActionLink(
            "Pet Report",
            "PetReport",
            "Reports",
            null,
            new
            {
                @class = "btn btn-primary w-100 d-flex align-items-center justify-content-center",
                style = "min-height: 70px;"
            })
    </div>

    <div class="col-auto" style="width: 340px;">
        @Html.ActionLink(
            "Pet Care Report",
            "PetCareReport",
            "Reports",
            null,
            new
            {
                @class = "btn btn-primary w-100 d-flex align-items-center justify-content-center",
                style = "min-height: 70px;"
            })
    </div>

    <div class="col-auto" style="width: 340px;">
        @Html.ActionLink(
            "Species Report",
            "SpeciesReport",
            "Reports",
            null,
            new
            {
                @class = "btn btn-primary w-100 d-flex align-items-center justify-content-center",
                style = "min-height: 70px;"
            })
    </div>

    <div class="col-auto" style="width: 340px;">
        @Html.ActionLink(
            "Vaccine Compliance Report",
            "VaccineComplianceReport",
            "Reports",
            null,
            new
            {
                @class = "btn btn-primary w-100 d-flex align-items-center justify-content-center",
                style = "min-height: 70px;"
            })
    </div>

</div>

