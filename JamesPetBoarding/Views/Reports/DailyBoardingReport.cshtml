@model JamesPetBoarding.ViewModels.DailyBoardingReportVM
@{
    ViewBag.Title = "Daily Boarding Report";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1>Paws &amp; Reservations, LLC</h1>
    <h2>Daily Boarding Report</h2>

    <p class="lead">
        Enter one or more optional filters to generate a daily boarding report.
    </p>
</div>

@using (Html.BeginForm(
    "DailyBoardingReport",
    "Reports",
    FormMethod.Post,
    new { @class = "row g-3 justify-content-center" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(
        false,
        "",
        new { @class = "text-danger" })

    <div class="col-12">
        <div class="d-flex gap-3 justify-content-center flex-nowrap">

            <div style="width: 250px;">
                <label class="form-label">Start Date</label>

                @Html.TextBoxFor(
                    x => x.DailyBoardingReportFilter.StartDate,
                    "{0:yyyy-MM-dd}",
                    new
                    {
                        @class = "form-control",
                        type = "date",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.DailyBoardingReportFilter.StartDate,
                    "",
                    new { @class = "text-danger" })
            </div>

            <div style="width: 250px;">
                <label class="form-label">End Date</label>

                @Html.TextBoxFor(
                    x => x.DailyBoardingReportFilter.EndDate,
                    "{0:yyyy-MM-dd}",
                    new
                    {
                        @class = "form-control",
                        type = "date",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.DailyBoardingReportFilter.EndDate,
                    "",
                    new { @class = "text-danger" })
            </div>

        </div>
    </div>

    <div class="col-12">
        <div class="d-flex gap-3 justify-content-center flex-nowrap">

            <div style="width: 350px;">
                <label class="form-label">Customer Name</label>

                @Html.DropDownListFor(
                    x => x.DailyBoardingReportFilter.CustomerId,
                    Model.CustomerSelectList,
                    "Select Customer...",
                    new
                    {
                        @class = "form-select",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.DailyBoardingReportFilter.CustomerId,
                    "",
                    new { @class = "text-danger" })
            </div>

            <div style="width: 300px;">
                <label class="form-label">Pet Name</label>

                @Html.DropDownListFor(
                    x => x.DailyBoardingReportFilter.PetId,
                    Model.PetSelectList,
                    "Select Pet...",
                    new
                    {
                        @class = "form-select",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.DailyBoardingReportFilter.PetId,
                    "",
                    new { @class = "text-danger" })
            </div>

        </div>
    </div>

    <div class="col-12">
        <div style="width: 300px; margin: 0 auto;">
            <label class="form-label">Boarding Status</label>

            @Html.EnumDropDownListFor(
                x => x.DailyBoardingReportFilter.BoardingStatus,
                "Select...",
                new
                {
                    @class = "form-select",
                    style = "max-width: none;"
                })

            @Html.ValidationMessageFor(
                x => x.DailyBoardingReportFilter.BoardingStatus,
                "",
                new { @class = "text-danger" })
        </div>
    </div>

    <div class="col-12 text-center mt-4">
        <button type="submit"
                class="btn btn-primary me-2">
            Generate Report
        </button>

        @Html.ActionLink(
            "Back to Reports",
            "Index",
            "Reports",
            null,
            new { @class = "btn btn-secondary ms-2" })
    </div>
}

@if (Model.DailyBoardingReportRows != null &&
     Model.DailyBoardingReportRows.Any())
{
    <div class="border rounded p-4 mt-5 mb-4">
        <h3 class="text-center mb-4">
            Daily Boarding Summary
        </h3>

        <div class="row text-center justify-content-center">
            <div class="col-md-3 mb-3">
                <strong>Scheduled Arrivals</strong>
                <div>@Model.ScheduledArrivalCount</div>
            </div>

            <div class="col-md-3 mb-3">
                <strong>Actual Arrivals</strong>
                <div>@Model.ActualArrivalCount</div>
            </div>

            <div class="col-md-3 mb-3">
                <strong>Scheduled Departures</strong>
                <div>@Model.ScheduledDepartureCount</div>
            </div>

            <div class="col-md-3 mb-3">
                <strong>Actual Departures</strong>
                <div>@Model.ActualDepartureCount</div>
            </div>
        </div>
    </div>

    using (Html.BeginForm(
        "ExportDailyBoardingReportPdf",
        "Reports",
        FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(
            x => x.DailyBoardingReportFilter.StartDate)

        @Html.HiddenFor(
            x => x.DailyBoardingReportFilter.EndDate)

        @Html.HiddenFor(
            x => x.DailyBoardingReportFilter.CustomerId)

        @Html.HiddenFor(
            x => x.DailyBoardingReportFilter.PetId)

        @Html.HiddenFor(
            x => x.DailyBoardingReportFilter.BoardingStatus)

        <div class="text-center mb-4">
            <button type="submit" class="btn btn-success">
                Export PDF
            </button>
        </div>
    }

    <div class="table-responsive mt-4">
        <table class="table table-striped table-bordered align-middle">
            <thead>
                <tr>
                    <th>Pet</th>
                    <th>Customer</th>
                    <th>Boarding Unit</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Check-In Date</th>
                    <th>Check-Out Date</th>
                    <th>Status</th>
                    <th>Vaccine Compliance</th>
                    <th>Balance</th>
                    <th>Notes</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (
                    var boarding in
                    Model.DailyBoardingReportRows)
                {
                    <tr>
                        <td>@boarding.PetNameDisplay</td>
                        <td>@boarding.CustomerNameDisplay</td>
                        <td>@boarding.BoardingUnitDisplay</td>
                        <td>@boarding.StartDateDisplay</td>
                        <td>@boarding.EndDateDisplay</td>
                        <td>@boarding.CheckInDateTimeDisplay</td>
                        <td>@boarding.CheckOutDateTimeDisplay</td>
                        <td>@boarding.BoardingStatusDisplay</td>
                        <td>@boarding.VaccineComplianceDisplay</td>
                        <td>@boarding.BalanceDisplay</td>
                        <td>@boarding.NotesDisplay</td>

                        <td>
                            @Html.ActionLink(
                                "View",
                                "Read",
                                "Boardings",
                                new
                                {
                                    boardingId =
                                        boarding.BoardingId
                                },
                                new
                                {
                                    @class =
                                        "btn btn-sm btn-outline-primary"
                                })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (Model.HasSearched)
{
    <div class="alert alert-info text-center mt-4">
        No boardings matched the selected report filters.
    </div>
}
