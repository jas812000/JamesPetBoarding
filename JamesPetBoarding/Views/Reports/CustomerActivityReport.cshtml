@model JamesPetBoarding.ViewModels.CustomerActivityReportVM
@{
    ViewBag.Title = "Customer Activity Report";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1>Paws &amp; Reservations, LLC</h1>
    <h2>Customer Activity Report</h2>

    <p class="lead">
        Enter one or more optional filters to generate a customer activity report.
    </p>
</div>

@using (Html.BeginForm(
    "CustomerActivityReport",
    "Reports",
    FormMethod.Post,
    new { @class = "row g-3 justify-content-center" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(
        false,
        "",
        new { @class = "text-danger" })

    <div class="col-12">
        <div class="d-flex gap-3 justify-content-center flex-nowrap">

            <div style="width: 350px;">
                <label class="form-label">Customer Name</label>

                @Html.DropDownListFor(
                    x => x.CustomerActivityReportFilter.CustomerId,
                    Model.CustomerSelectList,
                    "Select Customer...",
                    new
                    {
                        @class = "form-select",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.CustomerActivityReportFilter.CustomerId,
                    "",
                    new { @class = "text-danger" })
            </div>

            <div style="width: 300px;">
                <label class="form-label">Active Status</label>

                @Html.EnumDropDownListFor(
                    x => x.CustomerActivityReportFilter.ActiveStatus,
                    "Select...",
                    new
                    {
                        @class = "form-select",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.CustomerActivityReportFilter.ActiveStatus,
                    "",
                    new { @class = "text-danger" })
            </div>

        </div>
    </div>

    <div class="col-12">
        <div class="d-flex gap-3 justify-content-center flex-nowrap">

            <div style="width: 300px;">
                <label class="form-label">First Name</label>

                @Html.TextBoxFor(
                    x => x.CustomerActivityReportFilter.FirstName,
                    new
                    {
                        @class = "form-control",
                        placeholder = "John",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.CustomerActivityReportFilter.FirstName,
                    "",
                    new { @class = "text-danger" })
            </div>

            <div style="width: 300px;">
                <label class="form-label">Last Name</label>

                @Html.TextBoxFor(
                    x => x.CustomerActivityReportFilter.LastName,
                    new
                    {
                        @class = "form-control",
                        placeholder = "Doe",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.CustomerActivityReportFilter.LastName,
                    "",
                    new { @class = "text-danger" })
            </div>

        </div>
    </div>

    <div class="col-12">
        <div class="d-flex gap-3 justify-content-center flex-nowrap">

            <div style="width: 350px;">
                <label class="form-label">City</label>

                @Html.TextBoxFor(
                    x => x.CustomerActivityReportFilter.City,
                    new
                    {
                        @class = "form-control",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.CustomerActivityReportFilter.City,
                    "",
                    new { @class = "text-danger" })
            </div>

            <div style="width: 250px;">
                <label class="form-label">State</label>

                @Html.EnumDropDownListFor(
                    x => x.CustomerActivityReportFilter.State,
                    "Select...",
                    new
                    {
                        @class = "form-select",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.CustomerActivityReportFilter.State,
                    "",
                    new { @class = "text-danger" })
            </div>

            <div style="width: 250px;">
                <label class="form-label">Zip Code</label>

                @Html.TextBoxFor(
                    x => x.CustomerActivityReportFilter.ZipCode,
                    new
                    {
                        @class = "form-control",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.CustomerActivityReportFilter.ZipCode,
                    "",
                    new { @class = "text-danger" })
            </div>

        </div>
    </div>

    <div class="col-12">
        <div class="d-flex gap-3 justify-content-center flex-nowrap">

            <div style="width: 300px;">
                <label class="form-label">Phone</label>

                @Html.TextBoxFor(
                    x => x.CustomerActivityReportFilter.Phone,
                    new
                    {
                        @class = "form-control",
                        placeholder = "202-555-1212",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.CustomerActivityReportFilter.Phone,
                    "",
                    new { @class = "text-danger" })
            </div>

            <div style="width: 300px;">
                <label class="form-label">Email</label>

                @Html.TextBoxFor(
                    x => x.CustomerActivityReportFilter.Email,
                    new
                    {
                        @class = "form-control",
                        placeholder = "johndoe@anymail.com",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.CustomerActivityReportFilter.Email,
                    "",
                    new { @class = "text-danger" })
            </div>

        </div>
    </div>

    <div class="col-12 text-center mt-4">
        <button type="submit"
                class="btn btn-primary me-2">
            Generate Report
        </button>

        @Html.ActionLink(
            "Back to Reports",
            "Index",
            "Reports",
            null,
            new { @class = "btn btn-secondary ms-2" })
    </div>
}

@if (Request.HttpMethod == "POST" &&
     ViewData.ModelState.IsValid)
{
    <hr class="my-5" />

    <div class="text-center mb-4">
        <h3>Report Summary</h3>
    </div>

    <div class="row g-3 justify-content-center mb-4">
        <div class="col-md-4">
            <div class="border rounded p-3 text-center">
                <h5>Total Customers</h5>
                <p class="fs-4 mb-0">@Model.TotalCount</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="border rounded p-3 text-center">
                <h5>Active Customers</h5>
                <p class="fs-4 mb-0">@Model.ActiveCount</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="border rounded p-3 text-center">
                <h5>Inactive Customers</h5>
                <p class="fs-4 mb-0">@Model.InactiveCount</p>
            </div>
        </div>
    </div>

    if (Model.CustomerActivityReportRows != null &&
        Model.CustomerActivityReportRows.Count > 0)
    {
        using (Html.BeginForm(
            "ExportCustomerActivityReportPdf",
            "Reports",
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(
                x => x.CustomerActivityReportFilter.CustomerId)

            @Html.HiddenFor(
                x => x.CustomerActivityReportFilter.ActiveStatus)

            @Html.HiddenFor(
                x => x.CustomerActivityReportFilter.FirstName)

            @Html.HiddenFor(
                x => x.CustomerActivityReportFilter.LastName)

            @Html.HiddenFor(
                x => x.CustomerActivityReportFilter.City)

            @Html.HiddenFor(
                x => x.CustomerActivityReportFilter.State)

            @Html.HiddenFor(
                x => x.CustomerActivityReportFilter.ZipCode)

            @Html.HiddenFor(
                x => x.CustomerActivityReportFilter.Phone)

            @Html.HiddenFor(
                x => x.CustomerActivityReportFilter.Email)

            <div class="text-center mb-4">
                <button type="submit" class="btn btn-success">
                    Export PDF
                </button>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle report-sortable">
                <thead>
                    <tr>
                        <th scope="col" data-sort-type="text" aria-sort="none"><button type="button" class="report-sort-button">Customer<span class="report-sort-indicator" aria-hidden="true"> ↕</span></button></th>
                        <th scope="col" data-sort-type="text" aria-sort="none"><button type="button" class="report-sort-button">Status<span class="report-sort-indicator" aria-hidden="true"> ↕</span></button></th>
                        <th scope="col" data-sort-type="text" aria-sort="none"><button type="button" class="report-sort-button">Address<span class="report-sort-indicator" aria-hidden="true"> ↕</span></button></th>
                        <th scope="col" data-sort-type="text" aria-sort="none"><button type="button" class="report-sort-button">Phone<span class="report-sort-indicator" aria-hidden="true"> ↕</span></button></th>
                        <th scope="col" data-sort-type="text" aria-sort="none"><button type="button" class="report-sort-button">Email<span class="report-sort-indicator" aria-hidden="true"> ↕</span></button></th>
                        <th scope="col" data-sort-type="number" aria-sort="none"><button type="button" class="report-sort-button">Emergency Contacts<span class="report-sort-indicator" aria-hidden="true"> ↕</span></button></th>
                        <th scope="col" data-sort-type="number" aria-sort="none"><button type="button" class="report-sort-button">Pets<span class="report-sort-indicator" aria-hidden="true"> ↕</span></button></th>
                        <th scope="col" data-sort-type="number" aria-sort="none"><button type="button" class="report-sort-button">Boardings<span class="report-sort-indicator" aria-hidden="true"> ↕</span></button></th>
                        <th scope="col" data-sort-type="date" aria-sort="none"><button type="button" class="report-sort-button">Last Boarding<span class="report-sort-indicator" aria-hidden="true"> ↕</span></button></th>
                        <th scope="col" data-sort-type="number" aria-sort="none"><button type="button" class="report-sort-button">Invoices<span class="report-sort-indicator" aria-hidden="true"> ↕</span></button></th>
                        <th scope="col" data-sort-type="number" aria-sort="none"><button type="button" class="report-sort-button">Total Invoiced<span class="report-sort-indicator" aria-hidden="true"> ↕</span></button></th>
                        <th scope="col" data-sort-type="number" aria-sort="none"><button type="button" class="report-sort-button">Total Payments<span class="report-sort-indicator" aria-hidden="true"> ↕</span></button></th>
                        <th scope="col" data-sort-type="number" aria-sort="none"><button type="button" class="report-sort-button">Outstanding Balance<span class="report-sort-indicator" aria-hidden="true"> ↕</span></button></th>
                        <th scope="col" data-sort-type="date" aria-sort="none"><button type="button" class="report-sort-button">Last Activity<span class="report-sort-indicator" aria-hidden="true"> ↕</span></button></th>
                        <th scope="col" data-sort-type="text" aria-sort="none"><button type="button" class="report-sort-button">Frequent Customer<span class="report-sort-indicator" aria-hidden="true"> ↕</span></button></th>
                        <th scope="col" data-sort-type="text" aria-sort="none"><button type="button" class="report-sort-button">Notes<span class="report-sort-indicator" aria-hidden="true"> ↕</span></button></th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (
                        JamesPetBoarding.ViewModels.CustomerActivityReportRowVM
                        customer in Model.CustomerActivityReportRows)
                    {
                        <tr>
                            <td>@customer.CustomerNameDisplay</td>
                            <td>@customer.ActiveStatusDisplay</td>

                            <td>
                                @customer.AddressDisplay<br />
                                @customer.CityDisplay,
                                @customer.StateDisplay
                                @customer.ZipCodeDisplay
                            </td>

                            <td>@customer.PhoneDisplay</td>
                            <td>@customer.EmailDisplay</td>
                            <td>@customer.EmergencyContactCount</td>
                            <td>@customer.PetCount</td>
                            <td>@customer.BoardingCount</td>
                            <td>@customer.LastBoardingDateDisplay</td>
                            <td>@customer.InvoiceCount</td>
                            <td>@customer.TotalInvoiceAmountDisplay</td>
                            <td>@customer.TotalPaymentAmountDisplay</td>
                            <td>@customer.OutstandingBalanceDisplay</td>
                            <td>@customer.LastActivityDateDisplay</td>
                            <td>@customer.IsFrequentCustomerDisplay</td>
                            <td>@customer.NotesDisplay</td>

                            <td>
                                @Html.ActionLink(
                                    "View Customer",
                                    "Read",
                                    "Customers",
                                    new
                                    {
                                        customerId =
                                            customer.CustomerId
                                    },
                                    new
                                    {
                                        @class =
                                            "btn btn-sm btn-primary"
                                    })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            No customers matched the selected report filters.
        </div>
    }
}
