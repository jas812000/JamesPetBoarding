@model JamesPetBoarding.ViewModels.CurrentBoardersReportVM
@{
    ViewBag.Title = "Current Boarders Report";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1>Paws &amp; Reservations, LLC</h1>
    <h2>Current Boarders Report</h2>

    <p class="lead">
        Enter one or more optional filters to generate a current boarders report.
    </p>
</div>

@using (Html.BeginForm(
    "CurrentBoardersReport",
    "Reports",
    FormMethod.Post,
    new { @class = "row g-3 justify-content-center" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(
        false,
        "",
        new { @class = "text-danger" })

    <div class="col-12">
        <div class="d-flex gap-3 justify-content-center flex-nowrap">

            <div style="width: 350px;">
                <label class="form-label">Customer Name</label>

                @Html.DropDownListFor(
                    x => x.CurrentBoardersReportFilter.CustomerId,
                    Model.CustomerSelectList,
                    "Select Customer...",
                    new
                    {
                        @class = "form-select",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.CurrentBoardersReportFilter.CustomerId,
                    "",
                    new { @class = "text-danger" })
            </div>

            <div style="width: 300px;">
                <label class="form-label">Pet Name</label>

                @Html.DropDownListFor(
                    x => x.CurrentBoardersReportFilter.PetId,
                    Model.PetSelectList,
                    "Select Pet...",
                    new
                    {
                        @class = "form-select",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.CurrentBoardersReportFilter.PetId,
                    "",
                    new { @class = "text-danger" })
            </div>

        </div>
    </div>

    <div class="col-12">
        <div class="d-flex gap-3 justify-content-center flex-nowrap">

            <div style="width: 300px;">
                <label class="form-label">Boarding Unit</label>

                @Html.DropDownListFor(
                    x => x.CurrentBoardersReportFilter.BoardingUnitId,
                    Model.BoardingUnitSelectList,
                    "Select Boarding Unit...",
                    new
                    {
                        @class = "form-select",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.CurrentBoardersReportFilter.BoardingUnitId,
                    "",
                    new { @class = "text-danger" })
            </div>

            <div style="width: 300px;">
                <label class="form-label">Species</label>

                @Html.EnumDropDownListFor(
                    x => x.CurrentBoardersReportFilter.Species,
                    "Select...",
                    new
                    {
                        @class = "form-select",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.CurrentBoardersReportFilter.Species,
                    "",
                    new { @class = "text-danger" })
            </div>

        </div>
    </div>

    <div class="col-12 text-center mt-4">
        <button type="submit"
                class="btn btn-primary me-2">
            Generate Report
        </button>

        @Html.ActionLink(
            "Back to Reports",
            "Index",
            "Reports",
            null,
            new { @class = "btn btn-secondary ms-2" })
    </div>
}

@if (Model.CurrentBoardersReportRows != null &&
     Model.CurrentBoardersReportRows.Any())
{
    <div class="border rounded p-4 mt-5 mb-4">
        <h3 class="text-center mb-4">
            Current Boarders Summary
        </h3>

        <div class="row text-center justify-content-center">
            <div class="col-md-4 mb-3">
                <strong>Total Current Boarders</strong>
                <div>@Model.TotalCurrentBoarderCount</div>
            </div>
        </div>
    </div>

    using (Html.BeginForm(
        "ExportCurrentBoardersReportPdf",
        "Reports",
        FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(
            x => x.CurrentBoardersReportFilter.CustomerId)

        @Html.HiddenFor(
            x => x.CurrentBoardersReportFilter.PetId)

        @Html.HiddenFor(
            x => x.CurrentBoardersReportFilter.BoardingUnitId)

        @Html.HiddenFor(
            x => x.CurrentBoardersReportFilter.Species)

        <div class="text-center mb-4">
            <button type="submit" class="btn btn-success">
                Export PDF
            </button>
        </div>
    }

    <div class="table-responsive mt-4">
        <table class="table table-striped table-bordered align-middle">
            <thead>
                <tr>
                    <th>Pet</th>
                    <th>Customer</th>
                    <th>Boarding Unit</th>
                    <th>Species</th>
                    <th>Check-In Date/Time</th>
                    <th>Scheduled Check-Out Date/Time</th>
                    <th>Length of Stay</th>
                    <th>Diet</th>
                    <th>Medication Status</th>
                    <th>Vaccine Compliance</th>
                    <th>Notes</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (
                    var boarder in
                    Model.CurrentBoardersReportRows)
                {
                    <tr>
                        <td>@boarder.PetNameDisplay</td>
                        <td>@boarder.CustomerNameDisplay</td>
                        <td>@boarder.BoardingUnitDisplay</td>
                        <td>@boarder.SpeciesDisplay</td>
                        <td>@boarder.CheckInDateTimeDisplay</td>
                        <td>@boarder.ScheduledCheckOutDateTimeDisplay</td>
                        <td>@boarder.LengthOfStayDisplay</td>
                        <td>@boarder.DietDisplay</td>
                        <td>@boarder.MedicationStatusDisplay</td>
                        <td>@boarder.VaccineComplianceDisplay</td>
                        <td>@boarder.NotesDisplay</td>

                        <td>
                            @Html.ActionLink(
                                "View",
                                "Read",
                                "Boardings",
                                new
                                {
                                    boardingId =
                                        boarder.BoardingId
                                },
                                new
                                {
                                    @class =
                                        "btn btn-sm btn-outline-primary"
                                })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (Model.HasSearched)
{
    <div class="alert alert-info text-center mt-4">
        No current boarders matched the selected report filters.
    </div>
}
