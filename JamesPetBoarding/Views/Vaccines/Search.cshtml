@model JamesPetBoarding.ViewModels.VaccineSearchVM
@{
    ViewBag.Title = "Search Vaccines";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1>Paws &amp; Reservations, LLC</h1>
    <h2>Search Vaccines</h2>

    <p class="lead">
        Search by one or more fields to find an existing vaccine profile.
    </p>
</div>

@using (Html.BeginForm(
    "Search",
    "Vaccines",
    FormMethod.Post,
    new { @class = "row g-3 justify-content-center" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(
        false,
        "",
        new { @class = "text-danger" })

    <div class="col-12">
        <div class="d-flex gap-3 justify-content-center flex-nowrap">

            <div style="width: 420px;">
                <label class="form-label">Vaccine Name</label>

                @Html.TextBoxFor(
                    x => x.VaccineName,
                    new
                    {
                        @class = "form-control",
                        placeholder = "Enter all or part of a vaccine name",
                        style = "max-width: none;"
                    })
            </div>

            <div style="width: 304px;">
                <label class="form-label">Species</label>

                @Html.EnumDropDownListFor(
                    x => x.Species,
                    "Select...",
                    new
                    {
                        @class = "form-select",
                        style = "max-width: none;"
                    })
            </div>

            <div style="width: 304px;">
                <label class="form-label">Required Status</label>

                @Html.DropDownListFor(
                    x => x.RequiredFlag,
                    new List<SelectListItem>
                    {
                        new SelectListItem
                        {
                            Text = "All Vaccines",
                            Value = ""
                        },
                        new SelectListItem
                        {
                            Text = "Required",
                            Value = "true"
                        },
                        new SelectListItem
                        {
                            Text = "Not Required",
                            Value = "false"
                        }
                    },
                    new
                    {
                        @class = "form-select",
                        style = "max-width: none;"
                    })

                <small class="text-muted">
                    Select All Vaccines, Required or Not Required.
                </small>
            </div>

        </div>
    </div>

    <div class="col-12 text-center mt-4">
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <button type="submit"
                    class="btn btn-primary"
                    style="width: 300px;">
                Search Vaccines
            </button>

            @if (ViewBag.CanManageVaccines)
            {
                @Html.ActionLink(
                    "Create Vaccine",
                    "Create",
                    "Vaccines",
                    null,
                    new
                    {
                        @class = "btn btn-success",
                        style = "width: 300px;"
                    })
            }
        </div>

        <div class="d-flex justify-content-center gap-3 flex-wrap mt-3">
            @Html.ActionLink(
                "Clear Search",
                "Search",
                "Vaccines",
                null,
                new
                {
                    @class = "btn btn-secondary",
                    style = "width: 300px;"
                })

            @Html.ActionLink(
                "Back to Dashboard",
                "Index",
                "Dashboard",
                null,
                new
                {
                    @class = "btn btn-secondary",
                    style = "width: 300px;"
                })
        </div>
    </div>
}

@if (Model.VaccineSummaryResults != null &&
     Model.VaccineSummaryResults.Any())
{
    <h4 class="mt-4">
        Results Found: @Model.VaccineSummaryResults.Count
    </h4>

    <div class="mt-3">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Vaccine Name</th>
                    <th>Species</th>
                    <th>Required Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var vaccine in Model.VaccineSummaryResults)
                {
                    <tr>
                        <td>@vaccine.VaccineName</td>
                        <td>@vaccine.SpeciesDisplay</td>
                        <td>@vaccine.RequiredDisplay</td>

                        <td>
                            @Html.ActionLink(
                                "View",
                                "Read",
                                "Vaccines",
                                new { vaccineId = vaccine.VaccineId },
                                new { @class = "btn btn-primary btn-sm me-1" })

                            @if (ViewBag.CanManageVaccines)
                            {
                                @Html.ActionLink(
                                    "Update",
                                    "Update",
                                    "Vaccines",
                                    new { vaccineId = vaccine.VaccineId },
                                    new { @class = "btn btn-warning btn-sm me-1" })

                                @Html.ActionLink(
                                    "Delete",
                                    "Delete",
                                    "Vaccines",
                                    new { vaccineId = vaccine.VaccineId },
                                    new { @class = "btn btn-danger btn-sm" })
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Request.HttpMethod == "POST" &&
     Model.VaccineSummaryResults != null &&
     !Model.VaccineSummaryResults.Any())
{
    <div class="alert alert-info mt-4">
        No vaccines matched the search criteria.
    </div>
}
