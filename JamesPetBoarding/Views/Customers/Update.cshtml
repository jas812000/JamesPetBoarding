@model JamesPetBoarding.ViewModels.CustomerFormVM
@{
    ViewBag.Title = "Update Customer";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1>Paws &amp; Reservations, LLC</h1>
    <h2>Update Customer Profile</h2>
    <p class="lead">
        Update customer contact information and profile details.
    </p>
</div>

@using (Html.BeginForm(
    "Update",
    "Customers",
    FormMethod.Post,
    new { @class = "row g-3 justify-content-center" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(
        false,
        "",
        new { @class = "text-danger" })

    @Html.HiddenFor(x => x.CustomerId)

    @* Customer ID *@
    <div class="col-auto" style="width: 600px;">
        <label class="form-label">Customer ID</label>

        <input type="text"
               class="form-control"
               value="@Model.CustomerId"
               style="max-width: none;"
               readonly />
    </div>

    <div class="w-100"></div>

    @* Last Name / First Name *@
    <div class="col-auto" style="width: 600px;">
        <div class="row g-3">

            <div class="col-md-6">
                <label class="form-label">Last Name</label>

                @Html.TextBoxFor(
                    x => x.LastName,
                    new
                    {
                        @class = "form-control",
                        placeholder = "Doe",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.LastName,
                    "",
                    new { @class = "text-danger" })
            </div>

            <div class="col-md-6">
                <label class="form-label">First Name</label>

                @Html.TextBoxFor(
                    x => x.FirstName,
                    new
                    {
                        @class = "form-control",
                        placeholder = "John",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.FirstName,
                    "",
                    new { @class = "text-danger" })
            </div>

        </div>
    </div>

    <div class="w-100"></div>

    @* Address *@
    <div class="col-auto" style="width: 600px;">
        <label class="form-label">Address</label>

        @Html.TextBoxFor(
            x => x.Address,
            new
            {
                @class = "form-control",
                placeholder = "1234 Main Street",
                style = "max-width: none;"
            })

        @Html.ValidationMessageFor(
            x => x.Address,
            "",
            new { @class = "text-danger" })
    </div>

    <div class="w-100"></div>

    @* City / State / Zip Code *@
    <div class="col-auto" style="width: 600px;">
        <div class="row g-3">

            <div class="col-md-4">
                <label class="form-label">City</label>

                @Html.TextBoxFor(
                    x => x.City,
                    new
                    {
                        @class = "form-control",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.City,
                    "",
                    new { @class = "text-danger" })
            </div>

            <div class="col-md-4">
                <label class="form-label">State</label>

                @Html.EnumDropDownListFor(
                    x => x.State,
                    "Select...",
                    new
                    {
                        @class = "form-select",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.State,
                    "",
                    new { @class = "text-danger" })
            </div>

            <div class="col-md-4">
                <label class="form-label">Zip Code</label>

                @Html.TextBoxFor(
                    x => x.ZipCode,
                    new
                    {
                        @class = "form-control",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.ZipCode,
                    "",
                    new { @class = "text-danger" })
            </div>

        </div>
    </div>

    <div class="w-100"></div>

    @* Phone / Email *@
    <div class="col-auto" style="width: 600px;">
        <div class="row g-3">

            <div class="col-md-6">
                <label class="form-label">Phone</label>

                @Html.TextBoxFor(
                    x => x.Phone,
                    new
                    {
                        @class = "form-control",
                        placeholder = "972-555-1212",
                        maxlength = "12",
                        inputmode = "numeric",
                        id = "Phone",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.Phone,
                    "",
                    new { @class = "text-danger" })
            </div>

            <div class="col-md-6">
                <label class="form-label">Email</label>

                @Html.TextBoxFor(
                    x => x.Email,
                    new
                    {
                        @class = "form-control",
                        placeholder = "johndoe@anymail.com",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.Email,
                    "",
                    new { @class = "text-danger" })
            </div>

        </div>
    </div>

    <div class="w-100"></div>

    @* Notes *@
    <div class="col-auto" style="width: 600px;">
        <label class="form-label">Notes</label>

        @Html.TextAreaFor(
            x => x.Notes,
            new
            {
                @class = "form-control",
                rows = "4",
                placeholder = "Enter notes",
                style = "max-width: none;"
            })

        @Html.ValidationMessageFor(
            x => x.Notes,
            "",
            new { @class = "text-danger" })
    </div>

    <div class="w-100"></div>

    @* Actions *@
    <div class="col-12 mt-4">
        <div class="d-flex justify-content-center gap-3 flex-wrap">

            <button type="submit"
                    class="btn btn-primary"
                    style="width: 240px;">
                Update Customer Profile
            </button>

            @Html.ActionLink(
                "Cancel",
                "Read",
                "Customers",
                new { customerId = Model.CustomerId },
                new
                {
                    @class = "btn btn-secondary",
                    style = "width: 240px;"
                })

        </div>
    </div>
}

@section Scripts
{
    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                var phoneInput =
                    document.getElementById("Phone");

                if (phoneInput) {

                    phoneInput.addEventListener(
                        "input",
                        function () {

                            var digits =
                                this.value
                                    .replace(/\D/g, "")
                                    .substring(0, 10);

                            if (digits.length > 6) {

                                this.value =
                                    digits.substring(0, 3) + "-" +
                                    digits.substring(3, 6) + "-" +
                                    digits.substring(6);
                            }
                            else if (digits.length > 3) {

                                this.value =
                                    digits.substring(0, 3) + "-" +
                                    digits.substring(3);
                            }
                            else {
                                this.value = digits;
                            }
                        });
                }
            });
    </script>
}
