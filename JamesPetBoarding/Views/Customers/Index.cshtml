
@{
    ViewBag.Title = "Customer Dashboard";
}

<div class="text-center border-bottom pb-4 mb-5">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2 class="mb-4">Customer Dashboard</h2>

    <h5 class="text=muted">Welcome, @User.Identity.Name</h5>
</div>

<div class="text-center mb-5">
    <p class="lead">
        Create new customer profiles or search existing customer records.
    </p>
</div>

<div class="container text-center">

    <div class="row justify-content-center mb-5">
        <div class="col-md-4 text-center">
            @Html.ActionLink(
                "Search Customers", 
                "Search", 
                "Customers", 
                null, 
                new { @class = "btn btn-primary btn-lg w-100 py-5" })
        </div>

        <div class="col-md-1"></div>

        <div class="col-md-4 text-center">
            @Html.ActionLink(
                "Create Customer", 
                "Create", 
                "Customers", 
                null, 
                new { @class = "btn btn-success btn-lg w-100 py-5" })
        </div>
    </div>

    <div class="row justify-content-center mt-5">
        <div class="col-md-3 text-center">
            @Html.ActionLink(
                "Back to Dashboard", 
                "Index", 
                "Dashboard", 
                null, 
                new { @class = "btn btn-secondary btn-lg w-100 py-4" })
        </div>

        <div class="col-md-1"></div>

        <div class="col-md-3 mb-3">
            @Html.ActionLink(
                "Logout", 
                "LogOff", 
                "Account", 
                null, 
                new { @class = "btn btn-danger btn-lg w-100 py-4" })
        </div>
    </div>
</div>














