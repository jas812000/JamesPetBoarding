@model JamesPetBoarding.ViewModels.BoardingSearchVM
@using JamesPetBoarding.Models
@using JamesPetBoarding.Enums
@{
    ViewBag.Title = "Search Boardings";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Search Boardings</h2>
    <p class="lead">
        Search by one or more fields to find an existing boarding.
    </p>
</div>

@using (Html.BeginForm("Search", "Boardings", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    <div class="col-auto" style="width: 420px;">
        <label class="form-label">Customer</label>

        @Html.DropDownListFor(
            x => x.CustomerId,
            Model.CustomerSelectList,
            "Select Customer...",
            new
            {
                @class = "form-select",
                style = "max-width: none;"
            })
    </div>

    <div class="col-auto" style="width: 420px;">
        <label class="form-label">Pet</label>

        @Html.DropDownListFor(
            x => x.PetId,
            Model.PetSelectList,
            "Select Pet...",
            new
            {
                @class = "form-select",
                style = "max-width: none;"
            })
    </div>

    <div class="col-auto" style="width: 420px;">
        <label class="form-label">Boarding Unit</label>

        @Html.DropDownListFor(
            x => x.BoardingUnitId,
            Model.BoardingUnitSelectList,
            "Select Boarding Unit...",
            new
            {
                @class = "form-select",
                style = "max-width: none;"
            })
    </div>

    <div class="col-auto" style="width: 420px;">
        <label class="form-label">Boarding Status</label>

        @Html.EnumDropDownListFor(
            x => x.BoardingStatus,
            "Select Status...",
            new
            {
                @class = "form-select",
                style = "max-width: none;"
            })
    </div>

    <div class="col-auto" style="width: 420px;">
        <label class="form-label">Start Date/Time</label>

        @Html.TextBoxFor(
            x => x.StartDateTime,
            "{0:yyyy-MM-ddTHH:mm}",
            new
            {
                @class = "form-control",
                type = "datetime-local",
                style = "max-width: none;"
            })
    </div>

    <div class="col-auto" style="width: 420px;">
        <label class="form-label">End Date/Time</label>

        @Html.TextBoxFor(
            x => x.EndDateTime,
            "{0:yyyy-MM-ddTHH:mm}",
            new
            {
                @class = "form-control",
                type = "datetime-local",
                style = "max-width: none;"
            })
    </div>

    <div class="col-12 text-center mt-4">

        <div class="d-flex justify-content-center gap-3 flex-wrap mb-3">

            <button type="submit"
                    class="btn btn-primary"
                    style="width: 300px;">
                Search Boardings
            </button>

            @if (ViewBag.CanManageBoardings)
            {
                @Html.ActionLink(
                    "Create Boarding",
                    "Create",
                    "Boardings",
                    null,
                    new
                    {
                        @class = "btn btn-success",
                        style = "width: 300px;"
                    })
            }

        </div>

        <div class="d-flex justify-content-center gap-3 flex-wrap">

            @Html.ActionLink(
                "Clear Search",
                "Search",
                "Boardings",
                null,
                new
                {
                    @class = "btn btn-secondary",
                    style = "width: 300px;"
                })

            @Html.ActionLink(
                "Back to Boarding Management",
                "BoardingManagement",
                "Staff",
                null,
                new
                {
                    @class = "btn btn-secondary",
                    style = "width: 300px;"
                })

        </div>

    </div>

}

@if (Model.BoardingSummaryResults != null && Model.BoardingSummaryResults.Any())
{
    <h4 class="mt-4">
        Results Found: @Model.BoardingSummaryResults.Count
    </h4>

    <div class="mt-3">

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Customer Name</th>
                    <th>Pet Name</th>
                    <th>Boarding Unit</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Boarding Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var boarding in Model.BoardingSummaryResults)
                {
                    <tr>
                        <td>@boarding.CustomerNameDisplay</td>
                        <td>@boarding.PetNameDisplay</td>
                        <td>@boarding.BoardingUnitDisplay</td>
                        <td>@boarding.StartDateTimeDisplay</td>
                        <td>@boarding.EndDateTimeDisplay</td>
                        <td>@boarding.StatusDisplay</td>

                        <td>
                            @Html.ActionLink(
                                 "View",
                                 "Read",
                                 "Boardings",
                                 new { boardingId = boarding.BoardingId },
                                 new { @class = "btn btn-primary btn-sm me-1" })

                            @if (ViewBag.CanManageBoardings)
                            {
                                if (boarding.BoardingStatus == BoardingStatusEnum.Scheduled ||
                                     boarding.BoardingStatus == BoardingStatusEnum.Confirmed)
                                {

                                    @Html.ActionLink(
                                        "Update",
                                        "Update",
                                        "Boardings",
                                        new { boardingId = boarding.BoardingId },
                                        new { @class = "btn btn-warning btn-sm me-1" })

                                    @Html.ActionLink(
                                        "Cancel",
                                        "Cancel",
                                        "Boardings",
                                        new { boardingId = boarding.BoardingId },
                                        new { @class = "btn btn-danger btn-sm" })

                                    @Html.ActionLink(
                                        "Check In",
                                        "CheckIn",
                                        "Boardings",
                                        new { boardingId = boarding.BoardingId },
                                        new { @class = "btn btn-success btn-sm" })

                                    @Html.ActionLink(
                                        "No Show",
                                        "NoShow",
                                        "Boardings",
                                        new { boardingId = boarding.BoardingId },
                                        new { @class = "btn btn-success btn-sm" })

                                }
                                else if (boarding.BoardingStatus == BoardingStatusEnum.CheckedIn)
                                {

                                    @Html.ActionLink(
                                        "Check Out",
                                        "CheckOut",
                                        "Boardings",
                                        new { boardingId = boarding.BoardingId },
                                        new { @class = "btn btn-success btn-sm" })

                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Request.HttpMethod == "POST" &&
    Model.BoardingSummaryResults != null &&
    !Model.BoardingSummaryResults.Any())
{
    <div class="alert alert-info mt-4">
        No boarding matched the search criteria.
    </div>
}
