@model JamesPetBoarding.ViewModels.BoardingSearchVM
@using System.Linq
@using JamesPetBoarding.Enums
@{
    ViewBag.Title = ViewBag.PageTitle;
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1>Paws &amp; Reservations, LLC</h1>
    <h2>@ViewBag.PageTitle</h2>
    <p class="lead">
        @ViewBag.PageDescription
    </p>
</div>

@using (Html.BeginForm(
    (string)ViewBag.SearchAction,
    "Boardings",
    FormMethod.Post,
    new { @class = "row g-3 justify-content-center" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(
        false,
        "",
        new { @class = "text-danger" })

    <div class="col-auto" style="width: 300px;">
        <label class="form-label">Boarding Start Date</label>

        @Html.TextBoxFor(
            x => x.BoardingDate,
            "{0:yyyy-MM-dd}",
            new
            {
                @class = "form-control",
                type = "date",
                style = "max-width: none;"
            })
    </div>

    <div class="col-auto" style="width: 350px;">
        <label class="form-label">Pet Name</label>

        @Html.TextBoxFor(
            x => x.PetName,
            new
            {
                @class = "form-control",
                placeholder = "Enter all or part of the pet name",
                style = "max-width: none;"
            })
    </div>

    <div class="col-auto" style="width: 300px;">
        <label class="form-label">Species</label>

        @Html.EnumDropDownListFor(
            x => x.Species,
            "Select Species...",
            new
            {
                @class = "form-select",
                style = "max-width: none;"
            })
    </div>

    <div class="w-100"></div>

    <div class="col-12 text-center mt-4">
        <div class="d-flex justify-content-center gap-3 flex-wrap">

            <button type="submit"
                    class="btn btn-primary"
                    style="width: 300px;">
                Search
            </button>

            @Html.ActionLink(
                "Clear Search",
                (string)ViewBag.SearchAction,
                "Boardings",
                null,
                new
                {
                    @class = "btn btn-secondary",
                    style = "width: 300px;"
                })

        </div>

        <div class="d-flex justify-content-center mt-3">

            @Html.ActionLink(
                "Back to Boarding Management",
                "BoardingManagement",
                "Staff",
                null,
                new
                {
                    @class = "btn btn-secondary",
                    style = "width: 300px;"
                })

        </div>
    </div>
}

@if (Model.BoardingSummaryResults != null &&
     Model.BoardingSummaryResults.Any())
{
    <h4 class="mt-5">
        Eligible Boardings: @Model.BoardingSummaryResults.Count
    </h4>

    <div class="table-responsive mt-3">
        <table class="table table-striped table-bordered align-middle">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Pet</th>
                    <th>Species</th>
                    <th>Boarding Unit</th>
                    <th>Status</th>
                    <th>Start Date/Time</th>
                    <th>End Date/Time</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var boarding in Model.BoardingSummaryResults)
                {
                    <tr>
                        <td>@boarding.CustomerNameDisplay</td>
                        <td>@boarding.PetNameDisplay</td>
                        <td>@boarding.SpeciesDisplay</td>
                        <td>@boarding.BoardingUnitDisplay</td>
                        <td>@boarding.StatusDisplay</td>
                        <td>@boarding.StartDateTimeDisplay</td>
                        <td>@boarding.EndDateTimeDisplay</td>
                        <td>
                            @Html.ActionLink(
                                (string)ViewBag.ResultButtonText,
                                (string)ViewBag.ResultAction,
                                "Boardings",
                                new
                                {
                                    boardingId = boarding.BoardingId
                                },
                                new
                                {
                                    @class =
                                        "btn " +
                                        (string)ViewBag.ResultButtonClass +
                                        " btn-sm",
                                    style = "width: 130px;"
                                })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info mt-5">
        No eligible boardings were found.
    </div>
}
