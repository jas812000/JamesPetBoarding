@model JamesPetBoarding.ViewModels.EmployeeFormVM
@{
    ViewBag.Title = "Create Employee";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Create Employee Profile</h2>
    <p class="lead">
        Enter employee information to create a new employee profile.
    </p>
</div>

@using (Html.BeginForm(
    "Create",
    "Employees",
    FormMethod.Post,
    new
    {
        @class = "row g-3 justify-content-center",
        enctype = "multipart/form-data"
    }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    if (ViewBag.PossibleDuplicate == true)
    {
        <div class="col-md-12">
            <div class="alert alert-warning">
                <strong>Possible duplicate employee found.</strong>

                <p class="mb-2">
                    An existing employee has similar identifying information.
                    Review the existing employee information before proceeding.
                </p>

                <div class="form-check">
                    @Html.CheckBoxFor(
                        x => x.ConfirmPossibleDuplicate,
                        new { @class = "form-check-input" })

                    <label class="form-check-label">
                        I reviewed the possible duplicate information and confirm this is a different employee.
                    </label>
                </div>
            </div>
        </div>
    }

    <div class="col-md-6">
        <label class="form-label">Profile Photo</label>

        <input type="file"
               name="ProfileImageFile"
               class="form-control"
               accept=".jpg,.jpeg,.png,image/jpeg,image/png" />

        @Html.ValidationMessageFor(
            x => x.ProfileImageFile,
            "",
            new { @class = "text-danger" })

        <div class="form-text">
            JPG, JPEG, or PNG. Maximum file size: 5 MB.
        </div>
    </div>

    <div class="col-md-4">
        <label class="form-label">Last Name</label>
        @Html.TextBoxFor(x => x.LastName, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.LastName, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-4">
        <label class="form-label">First Name</label>
        @Html.TextBoxFor(x => x.FirstName, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.FirstName, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Role</label>
        @Html.EnumDropDownListFor(
            x => x.Role,
            "Select...",
            new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.Role, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Email Address</label>
        @Html.TextBoxFor(x => x.Email, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.Email, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Phone Number</label>
        @Html.TextBoxFor(
            x => x.Phone,
            new
            {
                @class = "form-control",
                maxLength = "12",
                inputmode = "numeric",
                id = "Phone"
            })
        @Html.ValidationMessageFor(x => x.Phone, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-12">
        <label class="form-label">Notes</label>
        @Html.TextAreaFor(
            x => x.Notes,
            new
            {
                @class = "form-control",
                rows = "4",
                placeholder = "Enter notes"
            })
        @Html.ValidationMessageFor(x => x.Notes, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-12 text-center mt-4">
        <button type="submit" class="btn btn-primary me-2">
            Create Employee Profile
        </button>

        @Html.ActionLink(
            "Cancel",
            "Search",
            "Employees",
            null,
            new { @class = "btn btn-secondary ms-2" })
    </div>
}

@section Scripts
{
    <script>
        document.getElementById("Phone").addEventListener("input", function () {

            var phone = this.value.replace(/\D/g, "").substring(0, 10);

            if (phone.length > 6) {
                phone =
                    phone.substring(0, 3) + "-" +
                    phone.substring(3, 6) + "-" +
                    phone.substring(6);
            }
            else if (phone.length > 3) {
                phone =
                    phone.substring(0, 3) + "-" +
                    phone.substring(3);
            }

            this.value = phone;
        });
    </script>
}
