@model JamesPetBoarding.ViewModels.EmployeeDetailsVM
@{
    ViewBag.Title = "Read Employee";

    string profileImagePath = string.IsNullOrWhiteSpace(Model.ProfileImagePath)
        ? "~/Content/Images/Employees/default-profile.png"
        : Model.ProfileImagePath;
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1>Paws &amp; Reservations, LLC</h1>
    <h2>View Employee Profile</h2>
    <p class="lead">
        View Employee profile information.
    </p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["SuccessMessage"]
    </div>
}

<div class="text-center mb-4">
    <img src="@Url.Content(profileImagePath)"
         alt="@Model.EmployeeNameDisplay"
         class="img-thumbnail"
         style="width: 200px; height: 200px; object-fit: cover;" />
</div>

<div class="row g-3 justify-content-center">

    <div class="col-12">
        <div style="width: 960px; margin: 0 auto; position: relative; left: 40px;">
            <div class="d-flex gap-3">

                <div style="width: 304px;">
                    <label class="form-label">Employee ID</label>

                    @Html.TextBoxFor(
                        x => x.EmployeeId,
                        new
                        {
                            @class = "form-control",
                            @readonly = "readonly"
                        })
                </div>

                <div style="width: 304px;">
                    <label class="form-label">Employee Name</label>

                    @Html.TextBoxFor(
                        x => x.EmployeeNameDisplay,
                        new
                        {
                            @class = "form-control",
                            @readonly = "readonly"
                        })
                </div>

                <div style="width: 304px;">
                    <label class="form-label">Active Status</label>

                    @Html.TextBoxFor(
                        x => x.ActiveStatusDisplay,
                        new
                        {
                            @class = "form-control",
                            @readonly = "readonly"
                        })
                </div>

            </div>
        </div>
    </div>

    <div class="col-12">
        <div style="width: 960px; margin: 0 auto; position: relative; left: 40px;">
            <div class="d-flex gap-3">

                <div style="width: 304px;">
                    <label class="form-label">Role</label>

                    @Html.TextBoxFor(
                        x => x.RoleDisplay,
                        new
                        {
                            @class = "form-control",
                            @readonly = "readonly"
                        })
                </div>

                <div style="width: 304px;">
                    <label class="form-label">Email Address</label>

                    @Html.TextBoxFor(
                        x => x.EmailDisplay,
                        new
                        {
                            @class = "form-control",
                            @readonly = "readonly"
                        })
                </div>

                <div style="width: 304px;">
                    <label class="form-label">Phone Number</label>

                    @Html.TextBoxFor(
                        x => x.PhoneDisplay,
                        new
                        {
                            @class = "form-control",
                            @readonly = "readonly"
                        })
                </div>

            </div>
        </div>
    </div>

    @if (!Model.IsActive)
    {
        <div class="col-12">
            <div style="width: 632px; margin: 0 auto; position: relative; left: 40px;">
                <div class="d-flex gap-3">

                    <div style="width: 304px;">
                        <label class="form-label">Inactivation Reason</label>

                        @Html.TextBoxFor(
                            x => x.InactivationReasonDisplay,
                            new
                            {
                                @class = "form-control",
                                @readonly = "readonly"
                            })
                    </div>

                    <div style="width: 304px;">
                        <label class="form-label">Inactivation Date</label>

                        @Html.TextBoxFor(
                            x => x.InactivationDateDisplay,
                            new
                            {
                                @class = "form-control",
                                @readonly = "readonly"
                            })
                    </div>

                </div>
            </div>
        </div>

        <div class="col-12">
            <div style="width: 360px; margin: 0 auto; position: relative; left: -80px;">
                <label class="form-label">Inactivation Notes</label>

                @Html.TextAreaFor(
                    x => x.InactivationNotesDisplay,
                    new
                    {
                        @class = "form-control",
                        rows = "4",
                        @readonly = "readonly",
                        style = "width: 550px; max-width: none;"
                    })
            </div>
        </div>
    }
    }

    <div class="col-12">
        <div style="width: 360px; margin: 0 auto; position: relative; left: -80px;">
            <label class="form-label">Notes</label>

            @Html.TextAreaFor(
                x => x.NotesDisplay,
                new
                {
                    @class = "form-control",
                    rows = "4",
                    @readonly = "readonly",
                    style = "width: 550px; max-width: none;"
                })
        </div>
    </div>

    <div class="col-md-10 text-center mt-3">

        @Html.ActionLink(
            "Update Employee",
            "Update",
            "Employees",
            new { employeeId = Model.EmployeeId },
            new { @class = "btn btn-primary me-2" })

        @if (Model.IsActive)
        {
            @Html.ActionLink(
                "Deactivate Employee",
                "Delete",
                "Employees",
                new { employeeId = Model.EmployeeId },
                new { @class = "btn btn-danger me-2" })
        }
        else
        {
            @Html.ActionLink(
                "Reactivate Employee",
                "Reactivate",
                "Employees",
                new { employeeId = Model.EmployeeId },
                new { @class = "btn btn-success me-2" })
        }

        @Html.ActionLink(
            "Back to Search",
            "Search",
            "Employees",
            null,
            new { @class = "btn btn-secondary" })

    </div>

</div>
