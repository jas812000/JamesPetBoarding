@model JamesPetBoarding.ViewModels.EmployeeReactivateVM
@{
    ViewBag.Title = "Reactivate Employee";

    string profileImagePath = string.IsNullOrWhiteSpace(Model.ProfileImagePath)
        ? "~/Content/Images/Employees/default-profile.png"
        : Model.ProfileImagePath;
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1>Paws &amp; Reservations, LLC</h1>
    <h2>Reactivate Employee Profile</h2>
    <p class="lead">
        View employee profile information before reactivation.
    </p>
</div>

@using (Html.BeginForm(
    "Reactivate",
    "Employees",
    FormMethod.Post,
    new { @class = "row g-3 justify-content-center" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    @Html.HiddenFor(x => x.EmployeeId)

    <div class="col-12 text-center">
        <img src="@Url.Content(profileImagePath)"
             alt="@Model.EmployeeNameDisplay"
             class="img-thumbnail"
             style="width: 200px; height: 200px; object-fit: cover;" />
    </div>


    @* Employee ID / Employee Name / Active Status *@
    <div class="col-12">
        <div style="width: 960px; margin: 0 auto; position: relative; left: 40px;">
            <div class="d-flex gap-3">

                <div style="width: 304px;">
                    <label class="form-label">Employee ID</label>

                    @Html.TextBoxFor(
                        x => x.EmployeeId,
                        new
                        {
                            @class = "form-control",
                            @readonly = "readonly"
                        })
                </div>

                <div style="width: 304px;">
                    <label class="form-label">Employee Name</label>

                    @Html.TextBoxFor(
                        x => x.EmployeeNameDisplay,
                        new
                        {
                            @class = "form-control",
                            @readonly = "readonly"
                        })
                </div>

                <div style="width: 304px;">
                    <label class="form-label">Active Status</label>

                    @Html.TextBoxFor(
                        x => x.ActiveStatusDisplay,
                        new
                        {
                            @class = "form-control",
                            @readonly = "readonly"
                        })
                </div>

            </div>
        </div>
    </div>


    @* Role / Email Address / Phone Number *@
    <div class="col-12">
        <div style="width: 960px; margin: 0 auto; position: relative; left: 40px;">
            <div class="d-flex gap-3">

                <div style="width: 304px;">
                    <label class="form-label">Role</label>

                    @Html.TextBoxFor(
                        x => x.RoleDisplay,
                        new
                        {
                            @class = "form-control",
                            @readonly = "readonly"
                        })
                </div>

                <div style="width: 304px;">
                    <label class="form-label">Email Address</label>

                    @Html.TextBoxFor(
                        x => x.EmailDisplay,
                        new
                        {
                            @class = "form-control",
                            @readonly = "readonly"
                        })
                </div>

                <div style="width: 304px;">
                    <label class="form-label">Phone Number</label>

                    @Html.TextBoxFor(
                        x => x.PhoneDisplay,
                        new
                        {
                            @class = "form-control",
                            @readonly = "readonly"
                        })
                </div>

            </div>
        </div>
    </div>


    @* Inactivation Reason / Inactivation Date *@
    <div class="col-12">
        <div style="width: 632px; margin: 0 auto; position: relative; left: 40px;">
            <div class="d-flex gap-3">

                <div style="width: 304px;">
                    <label class="form-label">Inactivation Reason</label>

                    @Html.TextBoxFor(
                        x => x.InactivationReasonDisplay,
                        new
                        {
                            @class = "form-control",
                            @readonly = "readonly"
                        })
                </div>

                <div style="width: 304px;">
                    <label class="form-label">Inactivation Date</label>

                    @Html.TextBoxFor(
                        x => x.InactivationDateDisplay,
                        new
                        {
                            @class = "form-control",
                            @readonly = "readonly"
                        })
                </div>

            </div>
        </div>
    </div>


    @* Inactivation Notes *@
    <div class="col-12">
        <div style="width: 360px; margin: 0 auto; position: relative; left: -80px;">
            <label class="form-label">Inactivation Notes</label>

            @Html.TextAreaFor(
                x => x.InactivationNotesDisplay,
                new
                {
                    @class = "form-control",
                    rows = "4",
                    @readonly = "readonly",
                    style = "width: 550px; max-width: none;"
                })
        </div>
    </div>


    @* Reactivation Date *@
    <div class="col-12">
        <div style="width: 304px; margin: 0 auto;">
            <label class="form-label">Reactivation Date</label>

            <input type="text"
                   class="form-control"
                   value="@DateTime.Now.ToString("MM/dd/yyyy")"
                   readonly />
        </div>
    </div>


    @* Reactivation Notes *@
    <div class="col-12">
        <div style="width: 360px; margin: 0 auto; position: relative; left: -80px;">
            <label class="form-label">Reactivation Notes</label>

            @Html.TextAreaFor(
                x => x.ReactivationNotes,
                new
                {
                    @class = "form-control",
                    rows = "4",
                    placeholder = "Enter notes",
                    style = "width: 550px; max-width: none;"
                })

            @Html.ValidationMessageFor(
                x => x.ReactivationNotes,
                "",
                new { @class = "text-danger" })
        </div>
    </div>


    @* Reactivation Warning *@
    <div class="col-md-12">
        <div class="alert alert-warning">
            This action will reactivate this employee profile.
        </div>
    </div>


    @* Actions *@
    <div class="col-md-12 text-center mt-4">
        <button type="submit"
                class="btn btn-success me-2">
            Reactivate Employee Profile
        </button>

        @Html.ActionLink(
            "Cancel",
            "Read",
            "Employees",
            new { employeeId = Model.EmployeeId },
            new { @class = "btn btn-secondary ms-2" })
    </div>
}
