@model JamesPetBoarding.ViewModels.EmployeeReactivateVM
@{
    ViewBag.Title = "Reactivate Employee";

    string profileImagePath = string.IsNullOrWhiteSpace(Model.ProfileImagePath)
        ? "~/Content/Images/Employees/default-profile.png"
        : Model.ProfileImagePath;
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1>Paws &amp; Reservations, LLC</h1>
    <h2>Reactivate Employee Profile</h2>
    <p class="lead">
        View employee profile information before reactivation.
    </p>
</div>

@using (Html.BeginForm(
    "Reactivate",
    "Employees",
    FormMethod.Post,
    new { @class = "row g-3 justify-content-center" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.EmployeeId)

    <div class="col-12">
        @Html.ValidationSummary(
            false,
            "",
            new { @class = "text-danger text-center" })
    </div>

    <div class="col-12 text-center">
        <img src="@Url.Content(profileImagePath)"
             alt="@Model.EmployeeNameDisplay"
             class="img-thumbnail"
             style="width: 200px; height: 200px; object-fit: cover;" />
    </div>

    <div class="col-12">
        <div class="row g-3 justify-content-center">

            <div class="col-auto" style="width: 300px;">
                <label class="form-label">Employee ID</label>
                @Html.TextBoxFor(
                    x => x.EmployeeId,
                    new
                    {
                        @class = "form-control",
                        @readonly = "readonly",
                        style = "max-width: none;"
                    })
            </div>

            <div class="col-auto" style="width: 300px;">
                <label class="form-label">Employee Name</label>
                @Html.TextBoxFor(
                    x => x.EmployeeNameDisplay,
                    new
                    {
                        @class = "form-control",
                        @readonly = "readonly",
                        style = "max-width: none;"
                    })
            </div>

            <div class="col-auto" style="width: 300px;">
                <label class="form-label">Active Status</label>
                @Html.TextBoxFor(
                    x => x.ActiveStatusDisplay,
                    new
                    {
                        @class = "form-control",
                        @readonly = "readonly",
                        style = "max-width: none;"
                    })
            </div>

        </div>
    </div>

    <div class="col-12">
        <div class="row g-3 justify-content-center">

            <div class="col-auto" style="width: 300px;">
                <label class="form-label">Role</label>
                @Html.TextBoxFor(
                    x => x.RoleDisplay,
                    new
                    {
                        @class = "form-control",
                        @readonly = "readonly",
                        style = "max-width: none;"
                    })
            </div>

            <div class="col-auto" style="width: 300px;">
                <label class="form-label">Email Address</label>
                @Html.TextBoxFor(
                    x => x.EmailDisplay,
                    new
                    {
                        @class = "form-control",
                        @readonly = "readonly",
                        style = "max-width: none;"
                    })
            </div>

            <div class="col-auto" style="width: 300px;">
                <label class="form-label">Phone Number</label>
                @Html.TextBoxFor(
                    x => x.PhoneDisplay,
                    new
                    {
                        @class = "form-control",
                        @readonly = "readonly",
                        style = "max-width: none;"
                    })
            </div>

        </div>
    </div>

    <div class="col-12">
        <div class="row g-3 justify-content-center">

            <div class="col-auto" style="width: 300px;">
                <label class="form-label">Inactivation Reason</label>
                @Html.TextBoxFor(
                    x => x.InactivationReasonDisplay,
                    new
                    {
                        @class = "form-control",
                        @readonly = "readonly",
                        style = "max-width: none;"
                    })
            </div>

            <div class="col-auto" style="width: 300px;">
                <label class="form-label">Inactivation Date</label>
                @Html.TextBoxFor(
                    x => x.InactivationDateDisplay,
                    new
                    {
                        @class = "form-control",
                        @readonly = "readonly",
                        style = "max-width: none;"
                    })
            </div>

            <div class="col-auto" style="width: 300px;">
                <label class="form-label">Reactivation Date</label>

                <input type="text"
                       class="form-control"
                       value="@DateTime.Now.ToString("MM/dd/yyyy")"
                       readonly
                       style="max-width: none;" />
            </div>

        </div>
    </div>

    <div class="col-12">
        <div style="width: 960px; max-width: 100%; margin: 0 auto;">
            <label class="form-label">Inactivation Notes</label>

            @Html.TextAreaFor(
                x => x.InactivationNotesDisplay,
                new
                {
                    @class = "form-control",
                    rows = "5",
                    @readonly = "readonly",
                    style = "max-width: none;"
                })
        </div>
    </div>

    <div class="col-12">
        <div style="width: 960px; max-width: 100%; margin: 0 auto;">
            <label class="form-label">Reactivation Notes</label>

            @Html.TextAreaFor(
                x => x.ReactivationNotes,
                new
                {
                    @class = "form-control",
                    rows = "5",
                    placeholder = "Enter notes",
                    style = "max-width: none;"
                })

            @Html.ValidationMessageFor(
                x => x.ReactivationNotes,
                "",
                new { @class = "text-danger" })
        </div>
    </div>

    <div class="col-12" style="max-width: 960px;">
        <div class="alert alert-warning mb-0">
            This action will reactivate this employee profile.
        </div>
    </div>

    <div class="col-12 text-center mt-4">
        <button type="submit" class="btn btn-success me-2">
            Reactivate Employee Profile
        </button>

        @Html.ActionLink(
            "Cancel",
            "Read",
            "Employees",
            new { employeeId = Model.EmployeeId },
            new { @class = "btn btn-secondary ms-2" })
    </div>
}
