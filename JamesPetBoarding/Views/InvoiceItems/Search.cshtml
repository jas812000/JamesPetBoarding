@model JamesPetBoarding.ViewModels.InvoiceItemSearchVM
@using JamesPetBoarding.Models
@using JamesPetBoarding.Enums
@{
    ViewBag.Title = "Search Invoice Items";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Search Invoice Items</h2>
    <p class="lead">
        Search by one or more fields to find an existing invoice item.
    </p>
</div>

@using (Html.BeginForm("Search", "InvoiceItems", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    @Html.DropDownListFor(x => x.InvoiceId, Model.InvoiceSelectList, "Select Invoice...", new { @class = "form-select" })

    @Html.DropDownListFor(x => x.BoardingId, Model.BoardingSelectList, "Select Boarding...", new { @class = "form-select" })

    @Html.DropDownListFor(x => x.ServiceId, Model.ServiceSelectList, "Select Service...", new { @class = "form-select" })

    @Html.EnumDropDownListFor(x => x.ItemType, "Select Item Type...", new { @class = "form-select" })

    @Html.TextBoxFor(x => x.Description, new { @class = "form-control", placeholder = "Description" })

    <div class="col-12 text-center mt-4">
        <button type="submit" class="btn btn-primary me-2">Search Invoice Items</button>

        @Html.ActionLink(
            "Clear Search",
            "Search",
            "InvoiceItems",
            null,
            new { @class = "btn btn-secondary ms-2" })
    </div>
}

@if (Model.InvoiceItemSearchResults != null && Model.InvoiceItemSearchResults.Any())
{
    <h4 class="mt-4">
        Results Found: @Model.InvoiceItemSearchResults.Count
    </h4>

    <div class="mt-3">

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Invoice</th>
                    <th>Boarding</th>
                    <th>Service</th>
                    <th>Item Type</th>
                    <th>Description</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Line Total</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var invoiceItem in Model.InvoiceItemSearchResults)
                {
                    <tr>
                        <td>@invoiceItem.InvoiceDisplay</td>
                        <td>@invoiceItem.BoardingDisplay</td>
                        <td>@invoiceItem.ServiceNameDisplay</td>
                        <td>@invoiceItem.ItemTypeDisplay</td>
                        <td>@invoiceItem.DescriptionDisplay</td>
                        <td>@invoiceItem.QuantityDisplay</td>
                        <td>@invoiceItem.UnitPriceDisplay</td>
                        <td>@invoiceItem.LineTotalDisplay</td>

                        <td>
                            @Html.ActionLink(
                                 "View",
                                 "Read",
                                 "InvoiceItems",
                                 new { invoiceItemId = invoiceItem.InvoiceItemId },
                                 new { @class = "btn btn-primary btn-sm me-1" })

                            @if (invoiceItem.InvoiceStatus != InvoiceStatusEnum.Void)
                            { 
                                @Html.ActionLink(
                                    "Update",
                                    "Update",
                                    "InvoiceItems",
                                    new { invoiceItemId = invoiceItem.InvoiceItemId },
                                    new { @class = "btn btn-warning btn-sm me-1" })

                                @Html.ActionLink(
                                    "Delete",
                                    "Delete",
                                    "InvoiceItems",
                                    new { invoiceItemId = invoiceItem.InvoiceItemId },
                                    new { @class = "btn btn-danger btn-sm" })
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Request.HttpMethod == "POST" &&
    Model.InvoiceItemSearchResults != null &&
    !Model.InvoiceItemSearchResults.Any())
{
    <div class="alert alert-info mt-4">
        No invoice item matched the search criteria.
    </div>
}

