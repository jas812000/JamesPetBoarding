@model List<JamesPetBoarding.ViewModels.OurTeamMemberDisplayVM>

@{
    ViewBag.Title = "Our Team";
}

<main>
    <section class="py-5" aria-labelledby="teamTitle">
        <h1 id="teamTitle">Our Team</h1>

        <p class="lead">
            Meet the people who help make Paws &amp; Reservations a safe,
            comfortable, and welcoming place for every pet.
        </p>

        <p>
            Our team brings together management, pet-care, grooming,
            veterinary, and facilities experience to support pets and
            their owners.
        </p>
    </section>

    @if (Model != null && Model.Any())
    {
        <section class="row g-4"
                 aria-label="Paws and Reservations team members">

            @foreach (var teamMember in Model)
            {
                <div class="col-sm-6 col-lg-4">
                    <article class="card h-100">

                        <img src="@Url.Content(teamMember.ProfileImagePath)"
                             class="card-img-top border-bottom"
                             alt="@teamMember.EmployeeNameDisplay"
                             style="height: 285px; object-fit: cover;" />

                        <div class="card-body">
                            <h2 class="card-title h4">
                                @teamMember.EmployeeNameDisplay
                            </h2>

                            <p class="card-text">
                                @teamMember.PublicJobTitle
                            </p>
                        </div>
                    </article>
                </div>
            }

        </section>
    }
    else
    {
        <div class="alert alert-info text-center">
            Team information is currently being updated.
        </div>
    }

    <section class="mt-5" aria-labelledby="contactTeamTitle">
        <h2 id="contactTeamTitle">How Can We Help?</h2>

        <p>
            Contact us with questions about our team, services, or caring
            for your pet.
        </p>

        <a class="btn btn-primary"
           href="@Url.Action("Contact", "Home")">
            Contact Us
        </a>
    </section>

    <section class="mt-5 pt-4 border-top"
             aria-label="Page navigation">

        <a class="btn btn-outline-secondary"
           href="@Url.Action("Index", "Home")">
            &larr; Return to Home
        </a>
    </section>
</main>
