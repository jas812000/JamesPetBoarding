@model JamesPetBoarding.ViewModels.PaymentSearchVM
@using JamesPetBoarding.Enums
@{
    ViewBag.Title = "Search Payments";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Search Payments</h2>
    <p class="lead">
        Search by one or more fields to find an existing Payment.
    </p>
</div>

@using (Html.BeginForm("Search", "Payments", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    @* Invoice *@
    <div class="col-12">
        <div style="width: 420px; margin: 0 auto;">
            <label class="form-label">Invoice</label>

            @Html.DropDownListFor(
                x => x.InvoiceId,
                Model.InvoiceSelectList,
                "Select Invoice...",
                new
                {
                    @class = "form-select",
                    style = "max-width: none;"
                })
        </div>
    </div>

    @* Customer / Pet *@
    <div class="col-12">
        <div class="d-flex justify-content-center gap-3 flex-wrap">

            <div style="width: 420px;">
                <label class="form-label">Customer</label>

                @Html.DropDownListFor(
                    x => x.CustomerId,
                    Model.CustomerSelectList,
                    "Select Customer...",
                    new
                    {
                        @class = "form-select",
                        style = "max-width: none;"
                    })
            </div>

            <div style="width: 420px;">
                <label class="form-label">Pet</label>

                @Html.DropDownListFor(
                    x => x.PetId,
                    Model.PetSelectList,
                    "Select Pet...",
                    new
                    {
                        @class = "form-select",
                        style = "max-width: none;"
                    })
            </div>

        </div>
    </div>

    @* Processed Employee *@
    <div class="col-12">
        <div style="width: 420px; margin: 0 auto;">
            <label class="form-label">Processed Employee</label>

            @Html.DropDownListFor(
                x => x.ProcessedByEmployeeId,
                Model.EmployeeSelectList,
                "Select Processed Employee...",
                new
                {
                    @class = "form-select",
                    style = "max-width: none;"
                })
        </div>
    </div>

    @* Start Date / End Date *@
    <div class="col-12">
        <div class="d-flex justify-content-center gap-3 flex-wrap">

            <div style="width: 420px;">
                <label class="form-label">Start Payment Date</label>

                @Html.TextBoxFor(
                    x => x.StartPaymentDateTime,
                    "{0:yyyy-MM-dd}",
                    new
                    {
                        @class = "form-control",
                        type = "date",
                        style = "max-width: none;"
                    })
            </div>

            <div style="width: 420px;">
                <label class="form-label">End Payment Date</label>

                @Html.TextBoxFor(
                    x => x.EndPaymentDateTime,
                    "{0:yyyy-MM-dd}",
                    new
                    {
                        @class = "form-control",
                        type = "date",
                        style = "max-width: none;"
                    })
            </div>

        </div>
    </div>

    @* Transaction Reference *@
    <div class="col-12">
        <div style="width: 420px; margin: 0 auto;">
            <label class="form-label">Transaction Reference</label>

            @Html.TextBoxFor(
                x => x.TransactionReference,
                new
                {
                    @class = "form-control",
                    placeholder = "Transaction Reference",
                    style = "max-width: none;"
                })
        </div>
    </div>

    @* Payment Method / Payment Status *@
    <div class="col-12">
        <div class="d-flex justify-content-center gap-3 flex-wrap">

            <div style="width: 420px;">
                <label class="form-label">Payment Method</label>

                @Html.EnumDropDownListFor(
                    x => x.PaymentMethod,
                    "Select Payment Method...",
                    new
                    {
                        @class = "form-select",
                        style = "max-width: none;"
                    })
            </div>

            <div style="width: 420px;">
                <label class="form-label">Payment Status</label>

                @Html.DropDownListFor(
                    x => x.IsVoided,
                    new List<SelectListItem>
                    {
                        new SelectListItem
                        {
                            Text = "Processed",
                            Value = "false"
                        },
                        new SelectListItem
                        {
                            Text = "Voided",
                            Value = "true"
                        }
                    },
                    "Select Payment Status...",
                    new
                    {
                        @class = "form-select",
                        style = "max-width: none;"
                    })
            </div>

        </div>
    </div>

    <div class="col-12 text-center mt-4">
        <button type="submit" class="btn btn-primary me-2">Search Payments</button>

        @Html.ActionLink(
            "Clear Search",
            "Search",
            "Payments",
            null,
            new { @class = "btn btn-secondary ms-2" })

        @Html.ActionLink(
            "Back to Billing",
            "Billing",
            "Staff",
            null,
            new { @class = "btn btn-secondary ms-2" })
    </div>

}

@if (Model.PaymentSearchResults != null && Model.PaymentSearchResults.Any())
{
    <h4 class="mt-4">
        Results Found: @Model.PaymentSearchResults.Count
    </h4>

    <div class="mt-3">

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Invoice</th>
                    <th>Customer</th>
                    <th>Pet</th>
                    <th>Amount</th>
                    <th>Payment Method</th>
                    <th>Payment Date</th>
                    <th>Processed By</th>
                    <th>Transaction Reference</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var payment in Model.PaymentSearchResults)
                {
                    <tr>
                        <td>@payment.InvoiceDisplay</td>
                        <td>@payment.CustomerNameDisplay</td>
                        <td>@payment.PetNameDisplay</td>
                        <td>@payment.AmountDisplay</td>
                        <td>@payment.PaymentMethodDisplay</td>
                        <td>@payment.PaymentDateTimeDisplay</td>
                        <td>@payment.ProcessedByEmployeeDisplay</td>
                        <td>@payment.TransactionReferenceDisplay</td>
                        <td>@payment.StatusDisplay</td>

                        <td>
                            @Html.ActionLink(
                                 "View",
                                 "Read",
                                 "Payments",
                                 new { paymentId = payment.PaymentId },
                                 new { @class = "btn btn-primary btn-sm me-1" })


                            @if (!payment.IsVoided)
                            {

                                @Html.ActionLink(
                                    "Update",
                                    "Update",
                                    "Payments",
                                    new { paymentId = payment.PaymentId },
                                    new { @class = "btn btn-warning btn-sm me-1" })

                                @Html.ActionLink(
                                    "Void",
                                    "Void",
                                    "Payments",
                                    new { paymentId = payment.PaymentId },
                                    new { @class = "btn btn-danger btn-sm me-1" })

                            }

                            @Html.ActionLink(
                                "Invoice",
                                "Read",
                                "Invoices",
                                new { invoiceId = payment.InvoiceId },
                                new { @class = "btn btn-secondary btn-sm" })

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Request.HttpMethod == "POST" &&
    Model.PaymentSearchResults != null &&
    !Model.PaymentSearchResults.Any())
{
    <div class="alert alert-info mt-4">
        No payments matched the search criteria.
    </div>
}

@section Scripts
{
    <script>
        (function () {
            var invoice = document.getElementById("InvoiceId");
            var customer = document.getElementById("CustomerId");
            var pet = document.getElementById("PetId");
            var searchButton =
                document.querySelector('button[type="submit"]');

            var selectionsUrl =
                '@Url.Action("GetPaymentSearchSelections", "Payments")';

            var requestNumber = 0;

            function selectedValue(element) {
                var value = element.value;

                return value &&
                    value !== "00000000-0000-0000-0000-000000000000"
                    ? value
                    : "";
            }

            function contains(items, value) {
                return items.some(function (item) {
                    return item.Value.toLowerCase() === value.toLowerCase();
                });
            }

            function render(element, placeholder, items, value) {
                element.innerHTML = "";

                var first = document.createElement("option");
                first.value = "";
                first.textContent = placeholder;
                element.appendChild(first);

                items.forEach(function (item) {
                    var option = document.createElement("option");
                    option.value = item.Value;
                    option.textContent = item.Text;
                    element.appendChild(option);
                });

                element.value =
                    value && contains(items, value) ? value : "";
            }

            function setInvoiceLock() {
                var locked = !!selectedValue(invoice);
                customer.disabled = locked;
                pet.disabled = locked;
            }

            function loadSelections(changedField) {
                var invoiceId = selectedValue(invoice);
                var customerId = selectedValue(customer);
                var petId = selectedValue(pet);

                if (changedField === "customer" ||
                    changedField === "pet") {
                    invoiceId = "";
                    invoice.value = "";
                }

                var currentRequest = ++requestNumber;
                searchButton.disabled = true;

                var parameters = new URLSearchParams();

                if (invoiceId) {
                    parameters.append("invoiceId", invoiceId);
                }

                if (customerId) {
                    parameters.append("customerId", customerId);
                }

                if (petId) {
                    parameters.append("petId", petId);
                }

                fetch(selectionsUrl + "?" + parameters.toString())
                    .then(function (response) {
                        if (!response.ok) {
                            throw new Error("Unable to load selections.");
                        }

                        return response.json();
                    })
                    .then(function (result) {
                        if (currentRequest !== requestNumber) {
                            return;
                        }

                        if (result.Error) {
                            throw new Error(result.Error);
                        }

                        if (changedField === "customer" &&
                            petId &&
                            !contains(result.Pets, petId)) {
                            pet.value = "";
                            loadSelections("customer");
                            return;
                        }

                        if (changedField === "pet" &&
                            customerId &&
                            !contains(result.Customers, customerId)) {
                            customer.value = "";
                            loadSelections("pet");
                            return;
                        }

                        if (invoiceId) {
                            customerId = result.CustomerId;
                            petId = result.PetId;
                        }

                        render(
                            invoice,
                            "Select Invoice...",
                            result.Invoices,
                            invoiceId
                        );

                        render(
                            customer,
                            "Select Customer...",
                            result.Customers,
                            customerId
                        );

                        render(
                            pet,
                            "Select Pet...",
                            result.Pets,
                            petId
                        );

                        setInvoiceLock();
                        searchButton.disabled = false;
                    })
                    .catch(function () {
                        if (currentRequest !== requestNumber) {
                            return;
                        }

                        searchButton.disabled = false;
                        alert(
                            "Unable to load payment search selections. " +
                            "Please try again."
                        );
                    });
            }

            invoice.addEventListener("change", function () {
                loadSelections("invoice");
            });

            customer.addEventListener("change", function () {
                loadSelections("customer");
            });

            pet.addEventListener("change", function () {
                loadSelections("pet");
            });

            setInvoiceLock();
        })();
    </script>
}
