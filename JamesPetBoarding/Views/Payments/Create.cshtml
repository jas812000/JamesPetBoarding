@model JamesPetBoarding.ViewModels.PaymentFormVM
@{
    ViewBag.Title = "Process Payment";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Process Payment</h2>
    <p class="lead">
        Enter payment information to process a new payment.
    </p>
</div>

@using (Html.BeginForm("Create", "Payments", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })


    @Html.HiddenFor(x => x.InvoiceId)
    <div class="col-auto" style="width: 900px;">
        <label class="form-label">Invoice</label>
        <input type="text"
               class="form-control" style="max-width: none;"
               value="@Model.InvoiceDisplay"
               readonly="readonly" />
        @Html.ValidationMessageFor(x => x.InvoiceId, "", new { @class = "text-danger" })
    </div>

    <div class="w-100"></div>

    <div class="col-auto" style="width: 350px;">
        <label class="form-label">Payment Method</label>
        @Html.EnumDropDownListFor(x => x.PaymentMethod, "Select Payment Method...", new { @class = "form-select", style = "max-width: none;" })
        @Html.ValidationMessageFor(x => x.PaymentMethod, "", new { @class = "text-danger" })
    </div>

    <div class="col-auto" style="width: 300px;">
        <label class="form-label">Amount</label>
        @Html.TextBoxFor(x => x.Amount, new { @class = "form-control", style = "max-width: none;" })
        @Html.ValidationMessageFor(x => x.Amount, "", new { @class = "text-danger" })
    </div>

    <div class="w-100"></div>

    <div class="col-auto" style="width: 1000px;">
        <label class="form-label">Notes</label>
        @Html.TextAreaFor(x => x.Notes, new { @class = "form-control", rows = "4", placeholder = "Enter notes", style = "max-width: none;" })
        @Html.ValidationMessageFor(x => x.Notes, "", new { @class = "text-danger" })
    </div>

    <div class="col-12 text-center mt-4">
        <div class="d-flex justify-content-center gap-3 flex-wrap">
        <button type="submit" class="btn btn-primary" style="width: 300px;">Process Payment</button>

        @Html.ActionLink(
            "Back to Invoice",
            "Read",
            "Invoices",
            new { invoiceId = Model.InvoiceId },
            new { @class = "btn btn-secondary ms-2", style = "width: 300px;" })

        </div>
    </div>

}
