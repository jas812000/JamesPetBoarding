@model JamesPetBoarding.ViewModels.ContactUsSubmissionVM

@{
    ViewBag.Title = "Contact Us";
}

<main aria-labelledby="contactFormTitle">
    <section class="py-5">
        <h1 id="contactFormTitle">Get in Touch</h1>

        <p>
            We understand your pets are part of your family. If you have questions,
            concerns, or would like additional information about our boarding and pet
            services, please complete the form below and a member of our team will be
            happy to assist you.
        </p>
    </section>

    @using (Html.BeginForm("Index", "ContactUsSubmission", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        if (!ViewData.ModelState.IsValid)
        {
            @Html.ValidationSummary(
                false,
                "Please correct the following errors before submitting the form:",
                new { @class = "text-danger" }
            )
        }

        <div class="row g-3">

            <div class="col-md-5">
                <label class="form-label">Last Name</label>
                @Html.TextBoxFor(
                    x => x.LastName,
                    new
                    {
                        @class = "form-control",
                        placeholder = "Doe"
                    })
                @Html.ValidationMessageFor(x => x.LastName, "", new { @class = "text-danger" })
            </div>

            <div class="col-md-5">
                <label class="form-label">First Name</label>
                @Html.TextBoxFor(
                    x => x.FirstName,
                    new
                    {
                        @class = "form-control",
                        placeholder = "John"
                    })
                @Html.ValidationMessageFor(x => x.FirstName, "", new { @class = "text-danger" })
            </div>

            <div class="col-md-5">
                <label class="form-label">Phone Number</label>
                @Html.TextBoxFor(
                    x => x.Phone,
                    new
                    {
                        @class = "form-control",
                        placeholder = "214-555-1212"
                    })
                @Html.ValidationMessageFor(x => x.Phone, "", new { @class = "text-danger" })
            </div>

            <div class="col-md-5">
                <label class="form-label">Email Address</label>
                @Html.TextBoxFor(
                    x => x.Email,
                    new
                    {
                        @class = "form-control",
                        placeholder = "jdoe@example.com"
                    })
                @Html.ValidationMessageFor(x => x.Email, "", new { @class = "text-danger" })
            </div>

            <div class="col-md-10">
                <label class="form-label">Message</label>
                @Html.TextAreaFor(
                    x => x.Message,
                    new
                    {
                        @class = "form-control",
                        rows = "5",
                        style = "max-width: 88%;"
                    })
                @Html.ValidationMessageFor(x => x.Message, "", new { @class = "text-danger" })
            </div>

        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary me-2">
                Submit
            </button>

            <button type="reset" class="btn btn-secondary">
                Clear Form
            </button>
        </div>
    }

    <section class="mt-5 pt-4 border-top" aria-label="Page navigation">
        <a class="btn btn-outline-secondary"
           href="@Url.Action("Contact", "Home")">
            &larr; Return to Contact
        </a>
    </section>
</main>