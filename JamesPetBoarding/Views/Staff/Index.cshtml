@{
    ViewBag.Title = "Staff Dashboard";
}

<div class="text-center border-bottom pb-4 mb-5">
    <h1>Paws &amp; Reservations, LLC</h1>
    <h2>Staff Dashboard</h2>
</div>

<div class="row g-4 justify-content-center">

    <div class="col-md-5">
        @Html.ActionLink(
            "Boarding Management",
            "BoardingManagement",
            "Staff",
            null,
            new { @class = "btn btn-primary w-100 py-5" })
    </div>

    <div class="col-md-5">
        @Html.ActionLink(
            "Pet Search",
            "Search",
            "Pets",
            null,
            new { @class = "btn btn-primary w-100 py-5" })
    </div>

    <div class="col-md-5">
        @Html.ActionLink(
            "Customer Search",
            "Search",
            "Customers",
            null,
            new { @class = "btn btn-primary w-100 py-5" })
    </div>

    <div class="col-md-5">
        @Html.ActionLink(
            "Billing",
            "Billing",
            "Staff",
            null,
            new { @class = "btn btn-primary w-100 py-5" })
    </div>

</div>

<div class="text-center border-top mt-5 pt-4">

    @using (Html.BeginForm("LogOff", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-secondary px-5 py-3">
            Logout
        </button>
    }

</div>