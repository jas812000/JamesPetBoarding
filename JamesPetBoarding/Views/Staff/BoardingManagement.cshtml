@{
    ViewBag.Title = "Boarding Management";
}

<div class="text-center border-bottom pb-4 mb-5">
    <h1>Paws &amp; Reservations, LLC</h1>
    <h2>Boarding Management</h2>
</div>

<div class="row g-4 justify-content-center">

    <div class="col-md-5">
        @Html.ActionLink(
            "Create Boarding",
            "Create",
            "Boardings",
            null,
            new { @class = "btn btn-primary w-100 py-4" })
    </div>

    <div class="col-md-5">
        @Html.ActionLink(
            "Search Boardings",
            "Search",
            "Boardings",
            null,
            new { @class = "btn btn-primary w-100 py-4" })
    </div>

    <div class="col-md-5">
        @Html.ActionLink(
            "Check In / Check Out",
            "Search",
            "Boardings",
            null,
            new { @class = "btn btn-primary w-100 py-4" })
    </div>

    <div class="col-md-5">
        @Html.ActionLink(
            "Cancel / No Show",
            "Search",
            "Boardings",
            null,
            new { @class = "btn btn-primary w-100 py-4" })
    </div>

</div>

<div class="text-center mt-5">
    @Html.ActionLink(
        "Back to Dashboard",
        "Index",
        "Dashboard",
        null,
        new { @class = "btn btn-secondary" })
</div>