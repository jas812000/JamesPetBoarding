@{
    ViewBag.Title = "Boarding Management";
}

<div class="text-center border-bottom pb-4 mb-5">
    <h1>Paws &amp; Reservations, LLC</h1>
    <h2>Boarding Management</h2>
</div>

<div class="row g-4 justify-content-center">

    <div class="col-md-5">
        @Html.ActionLink(
            "Create Boarding",
            "Create",
            "Boardings",
            null,
            new { @class = "btn btn-primary w-100 py-4" })
    </div>

    <div class="col-md-5">
        @Html.ActionLink(
            "Search Boardings",
            "Search",
            "Boardings",
            null,
            new { @class = "btn btn-primary w-100 py-4" })
    </div>

    <div class="col-md-5">
        @Html.ActionLink(
            "Check In Boardings",
            "CheckInSearch",
            "Boardings",
            null,
            new { @class = "btn btn-primary w-100 py-4" })
    </div>

    <div class="col-md-5">
        @Html.ActionLink(
            "Check Out Boardings",
            "CheckOutSearch",
            "Boardings",
            null,
            new { @class = "btn btn-primary w-100 py-4" })
    </div>

    <div class="col-md-5">
        @Html.ActionLink(
            "Cancel Boardings",
            "CancelSearch",
            "Boardings",
            null,
            new { @class = "btn btn-primary w-100 py-4" })
    </div>

    <div class="col-md-5">
        @Html.ActionLink(
            "Mark Boardings as No Show",
            "NoShowSearch",
            "Boardings",
            null,
            new { @class = "btn btn-primary w-100 py-4" })
    </div>

</div>

<div class="text-center mt-5">
    @Html.ActionLink(
        "Back to Dashboard",
        "Index",
        "Dashboard",
        null,
        new
        {
            @class = "btn btn-secondary",
            style = "width: 300px;"
        })
</div>
