@model JamesPetBoarding.ViewModels.VeterinarianSearchVM
@{
    ViewBag.Title = "Search Veterinarians";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Search Veterinarians</h2>
    <p class="lead">
        Search by one or more fields to find an existing veterinarian.
    </p>
</div>

@using (Html.BeginForm("Search", "Veterinarians", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    <div class="col-md-4">
        <label class="form-label">First Name</label>
        @Html.TextBoxFor(x => x.FirstName, new { @class = "form-control" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Last Name</label>
        @Html.TextBoxFor(x => x.LastName, new { @class = "form-control" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Clinic Name</label>
        @Html.TextBoxFor(x => x.ClinicName, new { @class = "form-control" })
    </div>

    <div class="col-md-4">
        <label class="form-label">City</label>
        @Html.TextBoxFor(x => x.City, new { @class = "form-control" })
    </div>

    <div class="col-md-4">
        <label class="form-label">State</label>
        @Html.EnumDropDownListFor(x => x.State, "Select...", new { @class = "form-select" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Zip Code</label>
        @Html.TextBoxFor(x => x.ZipCode, new { @class = "form-control" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Phone Number</label>
        @Html.TextBoxFor(
            x => x.Phone,
            new
            {
                @class = "form-control",
                maxlength = "12",
                inputmode = "numeric",
                id = "Phone"
            })
    </div>

    <div class="col-md-4">
        <label class="form-label">Email Address</label>
        @Html.TextBoxFor(x => x.Email, new { @class = "form-control" })
    </div>

    <div class="col-12 text-center mt-4">
        <button type="submit" class="btn btn-primary me-2">Search Veterinarians</button>

        @Html.ActionLink(
            "Create Veterinarian",
            "Create",
            "Veterinarians",
            null,
            new { @class = "btn btn-success ms-2" })

        @Html.ActionLink(
            "Clear Search",
            "Search",
            "Veterinarians",
            null,
            new { @class = "btn btn-secondary ms-2" })

    </div>

}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const phoneInput = document.getElementById("Phone");

            if (phoneInput) {
                phoneInput.addEventListener("input", function () {
                    let digits = this.value.replace(/\D/g, "").substring(0, 10);

                    if (digits.length > 6) {
                        this.value =
                            digits.substring(0, 3) + "-" +
                            digits.substring(3, 6) + "-" +
                            digits.substring(6);
                    }
                    else if (digits.length > 3) {
                        this.value =
                            digits.substring(0, 3) + "-" +
                            digits.substring(3);
                    }
                    else {
                        this.value = digits;
                    }
                });
            }
        });
    </script>
}

@if (Model.VeterinarianSummaryResults != null && Model.VeterinarianSummaryResults.Any())
{
    <h4 class="mt-4">
        Results Found: @Model.VeterinarianSummaryResults.Count
    </h4>

    <div class="mt-3">

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Veterinarian Name</th>
                    <th>Clinic Name</th>
                    <th>City, State</th>
                    <th>Phone Number</th>
                    <th>Email Address</th>
                    <th>Active Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var veterinarian in Model.VeterinarianSummaryResults)
                {
                    <tr>
                        <td>@veterinarian.FullNameCredentialsDisplay</td>
                        <td>@veterinarian.ClinicNameDisplay</td>
                        <td>@veterinarian.CityStateDisplay</td>
                        <td>@veterinarian.PhoneDisplay</td>
                        <td>@veterinarian.EmailDisplay</td>
                        <td>@veterinarian.ActiveStatusDisplay</td>

                        <td>
                            @Html.ActionLink(
                                 "View",
                                 "Read",
                                 "Veterinarians",
                                 new { vetId = veterinarian.VetId },
                                 new { @class = "btn btn-primary btn-sm me-1" })

                            @Html.ActionLink(
                                 "Update",
                                 "Update",
                                 "Veterinarians",
                                 new { vetId = veterinarian.VetId },
                                 new { @class = "btn btn-warning btn-sm me-1" })

                            @if (veterinarian.IsActive)
                            {
                                @Html.ActionLink(
                                     "Deactivate",
                                     "Deactivate",
                                     "Veterinarians",
                                     new { vetId = veterinarian.VetId },
                                     new { @class = "btn btn-danger btn-sm" })
                            }
                            else
                            {
                                @Html.ActionLink(
                                     "Reactivate",
                                     "Reactivate",
                                     "Veterinarians",
                                     new { vetId = veterinarian.VetId },
                                     new { @class = "btn btn-success btn-sm" })
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Request.HttpMethod == "POST" &&
    Model.VeterinarianSummaryResults != null &&
    !Model.VeterinarianSummaryResults.Any())
{
    <div class="alert alert-info mt-4">
        No veterinarians matched the search criteria.
    </div>
}
