@model JamesPetBoarding.ViewModels.VeterinarianFormVM
@{
    ViewBag.Title = "Update Veterinarian";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Update Veterinarian Profile</h2>
    <p class="lead">
        Enter veterinarian information to update an existing veterinarian profile.
    </p>
</div>


@using (Html.BeginForm("Update", "Veterinarians", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    @Html.HiddenFor(x => x.VetId)


    <div class="col-md-4">
        <label class="form-label">Last Name</label>
        @Html.TextBoxFor(x => x.LastName, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.LastName, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-4">
        <label class="form-label">First Name</label>
        @Html.TextBoxFor(x => x.FirstName, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.FirstName, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Credentials</label>
        @Html.TextBoxFor(x => x.Credentials, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.Credentials, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Clinic Name</label>
        @Html.TextBoxFor(x => x.ClinicName, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.ClinicName, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Address</label>
        @Html.TextBoxFor(x => x.Address, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.Address, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-4">
        <label class="form-label">City</label>
        @Html.TextBoxFor(x => x.City, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.City, "", new { @class = "text-danger" })
    </div>


    <div class="col-md-4">
        <label class="form-label">State</label>
        @Html.EnumDropDownListFor(x => x.State, "Select...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.State, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Zip Code</label>
        @Html.TextBoxFor(x => x.ZipCode, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.ZipCode, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Phone Number</label>
        @Html.TextBoxFor(
            x => x.Phone,
            new
            {
                @class = "form-control",
                placeholder = "972-555-1212",
                maxlength = "12",
                inputmode = "numeric",
                id = "Phone"
            })
        @Html.ValidationMessageFor(x => x.Phone, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Email Address</label>
        @Html.TextBoxFor(x => x.Email, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.Email, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-12">
        <label class="form-label">Notes</label>
        @Html.TextAreaFor(x => x.Notes, new { @class = "form-control", rows = "4", placeholder = "Enter notes" })
        @Html.ValidationMessageFor(x => x.Notes, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-12 text-center mt-4">
        <button type="submit" class="btn btn-primary me-2">Update Veterinarian Profile</button>

        @Html.ActionLink(
            "Cancel",
            "Read",
            "Veterinarians",
            new { vetId = Model.VetId },
            new { @class = "btn btn-secondary ms-2" })
    </div>

}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const phoneInput = document.getElementById("Phone");

            if (phoneInput) {
                phoneInput.addEventListener("input", function () {
                    let digits = this.value.replace(/\D/g, "").substring(0, 10);

                    if (digits.length > 6) {
                        this.value =
                            digits.substring(0, 3) + "-" +
                            digits.substring(3, 6) + "-" +
                            digits.substring(6);
                    }
                    else if (digits.length > 3) {
                        this.value =
                            digits.substring(0, 3) + "-" +
                            digits.substring(3);
                    }
                    else {
                        this.value = digits;
                    }
                });
            }
        });
    </script>
}
