@model JamesPetBoarding.ViewModels.ServiceFormVM
@{
    ViewBag.Title = "Create Service";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Create Service Profile</h2>
    <p class="lead">
        Enter service information to create a new service profile.
    </p>
</div>


@using (Html.BeginForm("Create", "Services", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    <div class="col-auto" style="width: 420px;">
        <label class="form-label">Service Name</label>

        @Html.EnumDropDownListFor(
            x => x.ServiceName,
            "Select...",
            new
            {
                @class = "form-select",
                style = "max-width: none;"
            })

        @Html.ValidationMessageFor(
            x => x.ServiceName,
            "",
            new { @class = "text-danger" })
    </div>

    <div class="col-auto" style="width: 420px;">
        <label class="form-label">Species</label>

        @Html.EnumDropDownListFor(
            x => x.Species,
            "Select...",
            new
            {
                @class = "form-select",
                style = "max-width: none;"
            })

        @Html.ValidationMessageFor(
            x => x.Species,
            "",
            new { @class = "text-danger" })
    </div>

    <div class="w-100"></div>

    <div class="col-auto" style="width: 420px;">
        <label class="form-label">Base Price</label>

        @Html.TextBoxFor(
            x => x.BasePrice,
            new
            {
                @class = "form-control",
                type = "number",
                min = "0.01",
                step = "0.01",
                style = "max-width: none;"
            })

        @Html.ValidationMessageFor(
            x => x.BasePrice,
            "",
            new { @class = "text-danger" })
    </div>

    <div class="col-auto" style="width: 420px;">
        <label class="form-label">Pricing Type</label>

        @Html.EnumDropDownListFor(
            x => x.PricingType,
            "Select...",
            new
            {
                @class = "form-select",
                style = "max-width: none;"
            })

        @Html.ValidationMessageFor(
            x => x.PricingType,
            "",
            new { @class = "text-danger" })
    </div>

    <div class="w-100"></div>

    <div class="col-auto" style="width: 900px;">
        <label class="form-label">Notes</label>

        @Html.TextAreaFor(
            x => x.Notes,
            new
            {
                @class = "form-control",
                rows = "4",
                placeholder = "Enter notes",
                style = "max-width: none;"
            })

        @Html.ValidationMessageFor(
            x => x.Notes,
            "",
            new { @class = "text-danger" })
    </div>

    <div class="col-12 text-center mt-4">
        <div class="d-flex justify-content-center gap-3 flex-wrap">
        <button type="submit"
                id="CreateServiceButton"
                class="btn btn-secondary"
                disabled style="width: 300px;">
            Create Service Profile
        </button>

        @Html.ActionLink(
            "Cancel",
            "Search",
            "Services",
            null,
            new { @class = "btn btn-secondary ms-2", style = "width: 300px;" })

        </div>
    </div>
    }

    @section Scripts
    {
    <script>
        (function () {

            var serviceName =
                document.getElementById("ServiceName");

            var species =
                document.getElementById("Species");

            var basePrice =
                document.getElementById("BasePrice");

            var pricingType =
                document.getElementById("PricingType");

            var createButton =
                document.getElementById("CreateServiceButton");

            function hasSelection(element) {
                return element && element.value !== "";
            }

            function hasValidPrice(element) {
                return element &&
                    element.value !== "" &&
                    parseFloat(element.value) > 0;
            }

            function updateCreateButton() {

                var formIsComplete =
                    hasSelection(serviceName) &&
                    hasSelection(species) &&
                    hasValidPrice(basePrice) &&
                    hasSelection(pricingType);

                createButton.disabled = !formIsComplete;

                createButton.classList.toggle(
                    "btn-primary",
                    formIsComplete);

                createButton.classList.toggle(
                    "btn-secondary",
                    !formIsComplete);
            }

            serviceName.addEventListener(
                "change",
                updateCreateButton);

            species.addEventListener(
                "change",
                updateCreateButton);

            basePrice.addEventListener(
                "input",
                updateCreateButton);

            pricingType.addEventListener(
                "change",
                updateCreateButton);

            updateCreateButton();

        })();
    </script>
}
