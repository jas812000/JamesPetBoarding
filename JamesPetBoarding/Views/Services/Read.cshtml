@model JamesPetBoarding.ViewModels.ServiceDetailsVM
@{
    ViewBag.Title = "Read Service";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>View Service Profile</h2>
    <p class="lead">
        View Service information.
    </p>
</div>

<div class="row g-3 justify-content-center">

    <div class="col-md-4">
        <label class="form-label">Service ID</label>
        @Html.TextBoxFor(x => x.ServiceId, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Service Name</label>
        @Html.TextBoxFor(x => x.ServiceNameDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Species</label>
        @Html.TextBoxFor(x => x.SpeciesDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-3">
        <label class="form-label">Base Price</label>
        @Html.TextBoxFor(x => x.BasePriceDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-3">
        <label class="form-label">Pricing Type</label>
        @Html.TextBoxFor(x => x.PricingTypeDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-12">
        <label class="form-label">Notes</label>
        @Html.TextAreaFor(x => x.NotesDisplay, new { @class = "form-control", rows = "3", @readonly = "readonly" })
    </div>

    <div class="col-md-10 text-center mt-3">
        @Html.ActionLink(
            "Update Service Profile",
            "Update",
            "Services",
            new { serviceId = Model.ServiceId },
            new { @class = "btn btn-primary me-2" })

        @Html.ActionLink(
            "Delete Service Profile",
            "Delete",
            "Services",
            new { serviceId = Model.ServiceId },
            new { @class = "btn btn-danger me-2" })
            
        @Html.ActionLink(
            "Back to Search",
            "Search",
            "Services",
            null,
            new { @class = "btn btn-secondary" })

    </div>
</div>
