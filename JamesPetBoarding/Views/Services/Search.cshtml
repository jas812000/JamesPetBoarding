@model JamesPetBoarding.ViewModels.ServiceSearchVM
@{
    ViewBag.Title = "Search Services";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1>Paws &amp; Reservations, LLC</h1>
    <h2>Search Services</h2>

    <p class="lead">
        Search by one or more fields to find an existing service profile.
    </p>
</div>

@using (Html.BeginForm(
    "Search",
    "Services",
    FormMethod.Post,
    new { @class = "row g-3 justify-content-center" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(
        false,
        "",
        new { @class = "text-danger" })



        <div class="col-auto" style="width: 420px;">
        <label class="form-label">Service Name</label>

            @Html.EnumDropDownListFor(
                x => x.ServiceName,
                "Select...",
                new
                {
                    @class = "form-select",
                    style = "max-width: none;"
                })
        </div>

        <div class="col-auto" style="width: 420px;">
        <label class="form-label">Species</label>

            @Html.EnumDropDownListFor(
                x => x.Species,
                "Select...",
                new
                {
                    @class = "form-select",
                    style = "max-width: none;"
                })
        </div>

        <div class="col-auto" style="width: 420px;">
        <label class="form-label">Pricing Type</label>

            @Html.EnumDropDownListFor(
                x => x.PricingType,
                "Select...",
                new
                {
                    @class = "form-select",
                    style = "max-width: none;"
                })
        </div>

    </div>


    <div class="col-12 text-center mt-4">
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <button type="submit"
                    class="btn btn-primary"
                    style="width: 300px;">
                Search Services
            </button>

            @if (ViewBag.CanManageServices)
            {
                @Html.ActionLink(
                    "Create Service",
                    "Create",
                    "Services",
                    null,
                    new
                    {
                        @class = "btn btn-success",
                        style = "width: 300px;"
                    })
            }
        </div>

        <div class="d-flex justify-content-center gap-3 flex-wrap mt-3">
            @Html.ActionLink(
                "Clear Search",
                "Search",
                "Services",
                null,
                new
                {
                    @class = "btn btn-secondary",
                    style = "width: 300px;"
                })

            @Html.ActionLink(
                "Back to Dashboard",
                "Index",
                "Dashboard",
                null,
                new
                {
                    @class = "btn btn-secondary",
                    style = "width: 300px;"
                })
        </div>
    </div>
}

@if (Model.ServiceSummaryResults != null &&
     Model.ServiceSummaryResults.Any())
{
    <h4 class="mt-4">
        Results Found: @Model.ServiceSummaryResults.Count
    </h4>

    <div class="mt-3">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Service Name</th>
                    <th>Species</th>
                    <th>Base Price</th>
                    <th>Pricing Type</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var service in Model.ServiceSummaryResults)
                {
                    <tr>
                        <td>@service.ServiceNameDisplay</td>
                        <td>@service.SpeciesDisplay</td>
                        <td>@service.BasePriceDisplay</td>
                        <td>@service.PricingTypeDisplay</td>

                        <td>
                            @Html.ActionLink(
                                "View",
                                "Read",
                                "Services",
                                new { serviceId = service.ServiceId },
                                new
                                {
                                    @class =
                                        "btn btn-primary btn-sm me-1"
                                })

                            @if (ViewBag.CanManageServices)
                            {
                                @Html.ActionLink(
                                    "Update",
                                    "Update",
                                    "Services",
                                    new
                                    {
                                        serviceId = service.ServiceId
                                    },
                                    new
                                    {
                                        @class =
                                            "btn btn-warning btn-sm me-1"
                                    })

                                @Html.ActionLink(
                                    "Delete",
                                    "Delete",
                                    "Services",
                                    new
                                    {
                                        serviceId = service.ServiceId
                                    },
                                    new
                                    {
                                        @class =
                                            "btn btn-danger btn-sm"
                                    })
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Request.HttpMethod == "POST" &&
     Model.ServiceSummaryResults != null &&
     !Model.ServiceSummaryResults.Any())
{
    <div class="alert alert-info mt-4">
        No service profile matched the search criteria.
    </div>
}
