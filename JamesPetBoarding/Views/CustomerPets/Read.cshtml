@model JamesPetBoarding.ViewModels.CustomerPetSummaryVM
@{
    ViewBag.Title = "View Customer-Pet Relationship";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1>Paws &amp; Reservations, LLC</h1>
    <h2>View Customer-Pet Relationship</h2>
    <p class="lead">
        View the relationship between a customer and a pet.
    </p>
</div>

<div class="row g-3 justify-content-center">



            <div class="col-auto" style="width: 400px;">
        <label class="form-label">
                    Relationship ID
                </label>

                @Html.TextBoxFor(
                    x => x.CustomerPetId,
                    new
                    {
                        @class = "form-control",
                        @readonly = "readonly",
                        style = "max-width: none;"
                    })
            </div>

            <div class="col-auto" style="width: 350px;">
        <label class="form-label">
                    Customer
                </label>

                @Html.TextBoxFor(
                    x => x.CustomerNameDisplay,
                    new
                    {
                        @class = "form-control",
                        @readonly = "readonly",
                        style = "max-width: none;"
                    })
            </div>

            <div class="col-auto" style="width: 350px;">
        <label class="form-label">
                    Relationship
                </label>

                @Html.TextBoxFor(
                    x => x.RelationshipTypeDisplay,
                    new
                    {
                        @class = "form-control",
                        @readonly = "readonly",
                        style = "max-width: none;"
                    })
            </div>



    <div class="w-100"></div>



            <div class="w-100"></div>

    <div class="col-auto" style="width: 350px;">
        <label class="form-label">Pet Name</label>

                @Html.TextBoxFor(
                    x => x.PetNameDisplay,
                    new
                    {
                        @class = "form-control",
                        @readonly = "readonly",
                        style = "max-width: none;"
                    })
            </div>

            <div class="col-auto" style="width: 300px;">
        <label class="form-label">Species</label>

                @Html.TextBoxFor(
                    x => x.SpeciesDisplay,
                    new
                    {
                        @class = "form-control",
                        @readonly = "readonly",
                        style = "max-width: none;"
                    })
            </div>

            <div class="col-auto" style="width: 400px;">
        <label class="form-label">Breed</label>

                @Html.TextBoxFor(
                    x => x.BreedDisplay,
                    new
                    {
                        @class = "form-control",
                        @readonly = "readonly",
                        style = "max-width: none;"
                    })
            </div>



    <div class="col-12 text-center mt-4">
        <div class="d-flex justify-content-center gap-3 flex-wrap">

            @Html.ActionLink(
                "Update Relationship",
                "Update",
                "CustomerPets",
                new { customerPetId = Model.CustomerPetId },
                new
                {
                    @class = "btn btn-primary",
                    style = "width: 300px;"
                })

            @Html.ActionLink(
                "Remove Relationship",
                "Delete",
                "CustomerPets",
                new { customerPetId = Model.CustomerPetId },
                new
                {
                    @class = "btn btn-danger",
                    style = "width: 300px;"
                })

            @Html.ActionLink(
                "Back to Customer Profile",
                "Read",
                "Customers",
                new { customerId = Model.CustomerId },
                new
                {
                    @class = "btn btn-secondary",
                    style = "width: 300px;"
                })

        </div>
    </div>

</div>
