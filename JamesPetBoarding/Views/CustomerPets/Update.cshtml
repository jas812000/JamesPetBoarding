@model JamesPetBoarding.ViewModels.CustomerPetFormVM
@{
    ViewBag.Title = "Update Customer-Pet Relationship";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1>Paws &amp; Reservations, LLC</h1>
    <h2>Update Customer-Pet Relationship</h2>
    <p class="lead">
        Update the relationship between this customer and pet.
    </p>
</div>

@using (Html.BeginForm(
    "Update",
    "CustomerPets",
    FormMethod.Post,
    new { @class = "row g-3 justify-content-center" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    @Html.HiddenFor(x => x.CustomerId)
    @Html.HiddenFor(x => x.CustomerPetId)
    @Html.HiddenFor(x => x.PetId)



            <div class="col-auto" style="width: 350px;">
        <label class="form-label">Customer</label>

                @Html.TextBoxFor(
                    x => x.CustomerNameDisplay,
                    new
                    {
                        @class = "form-control",
                        @readonly = "readonly",
                        style = "max-width: none;"
                    })
            </div>

            <div class="col-auto" style="width: 350px;">
        <label class="form-label">Pet</label>

                @Html.TextBoxFor(
                    x => x.PetNameDisplay,
                    new
                    {
                        @class = "form-control",
                        @readonly = "readonly",
                        style = "max-width: none;"
                    })
            </div>

            <div class="col-auto" style="width: 350px;">
        <label class="form-label">Relationship</label>

                @Html.EnumDropDownListFor(
                    x => x.RelationshipType,
                    "Select...",
                    new
                    {
                        @class = "form-select",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.RelationshipType,
                    "",
                    new { @class = "text-danger" })
            </div>



    <div class="col-12 text-center mt-4">
        <div class="d-flex justify-content-center gap-3 flex-wrap">

            <button type="submit"
                    class="btn btn-primary"
                    style="width: 300px;">
                Update Relationship
            </button>

            @Html.ActionLink(
                "Back to Customer Profile",
                "Read",
                "Customers",
                new { customerId = Model.CustomerId },
                new
                {
                    @class = "btn btn-secondary",
                    style = "width: 300px;"
                })

        </div>
    </div>
}
