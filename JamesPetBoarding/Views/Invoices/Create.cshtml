@model JamesPetBoarding.ViewModels.InvoiceFormVM
@{
    ViewBag.Title = "Create Invoice";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Create Invoice</h2>
    <p class="lead">
        Select the customer, pet and optional boarding reservation to create a new invoice.
    </p>
</div>

@using (Html.BeginForm("Create", "Invoices", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    <div class="col-md-10">
        <div class="row g-3">

            <div class="col-md-4">
                <label class="form-label">Customer</label>

                @Html.DropDownListFor(
                    x => x.CustomerId,
                    Model.CustomerSelectList,
                    "Select Customer...",
                    new
                    {
                        @class = "form-select",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.CustomerId,
                    "",
                    new { @class = "text-danger" })
            </div>

            <div class="col-md-4">
                <label class="form-label">Pet</label>

                @Html.DropDownListFor(
                    x => x.PetId,
                    Model.PetSelectList,
                    "Select Pet...",
                    new
                    {
                        @class = "form-select",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.PetId,
                    "",
                    new { @class = "text-danger" })
            </div>

            <div class="col-md-4">
                <label class="form-label">Boarding</label>

                @Html.DropDownListFor(
                    x => x.BoardingId,
                    Model.BoardingSelectList,
                    "Select Boarding Reservation (Optional)...",
                    new
                    {
                        @class = "form-select",
                        style = "max-width: none;"
                    })

                @Html.ValidationMessageFor(
                    x => x.BoardingId,
                    "",
                    new { @class = "text-danger" })
            </div>

        </div>
    </div>

    <div class="col-md-10">
        <label class="form-label">Notes</label>

        @Html.TextAreaFor(
            x => x.Notes,
            new
            {
                @class = "form-control",
                rows = "4",
                placeholder = "Enter notes",
                style = "max-width: none;"
            })

        @Html.ValidationMessageFor(
            x => x.Notes,
            "",
            new { @class = "text-danger" })
    </div>

    <div class="col-12 text-center mt-4">
        <button type="submit"
                id="GenerateInvoiceButton"
                class="btn btn-secondary me-2"
                disabled>
            Generate Invoice
        </button>

        @Html.ActionLink(
            "Back to Billing",
            "Billing",
            "Staff",
            null,
            new { @class = "btn btn-secondary ms-2" })
    </div>

}

@section Scripts
{
    <script>
        (function () {

            var customer = document.getElementById("CustomerId");
            var pet = document.getElementById("PetId");
            var generateButton =
                document.getElementById("GenerateInvoiceButton");

            function hasSelection(element) {
                return element.value &&
                    element.value !==
                    "00000000-0000-0000-0000-000000000000";
            }

            function updateGenerateButton() {

                var formIsComplete =
                    hasSelection(customer) &&
                    hasSelection(pet);

                generateButton.disabled = !formIsComplete;

                generateButton.classList.toggle(
                    "btn-primary",
                    formIsComplete);

                generateButton.classList.toggle(
                    "btn-secondary",
                    !formIsComplete);
            }

            customer.addEventListener(
                "change",
                updateGenerateButton);

            pet.addEventListener(
                "change",
                updateGenerateButton);

            updateGenerateButton();

        })();
    </script>
}
