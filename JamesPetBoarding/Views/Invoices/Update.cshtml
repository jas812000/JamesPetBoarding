@model JamesPetBoarding.ViewModels.InvoiceFormVM
@{
    ViewBag.Title = "Update Invoice";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Update Invoice</h2>
    <p class="lead">
        Select the customer, pet and optional boarding reservation to update an existing invoice.
    </p>
</div>

@using (Html.BeginForm("Update", "Invoices", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    @Html.HiddenFor(x => x.InvoiceId)

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    <div class="col-md-12">
        <label class="form-label">Customer</label>
        @Html.DropDownListFor(x => x.CustomerId, Model.CustomerSelectList, "Select Customer...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.CustomerId, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-12">
        <label class="form-label">Pet</label>
        @Html.DropDownListFor(x => x.PetId, Model.PetSelectList, "Select Pet...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.PetId, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-12">
        <label class="form-label">Boarding</label>
        @Html.DropDownListFor(x => x.BoardingId, Model.BoardingSelectList, "Select Boarding Reservation (Optional)...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.BoardingId, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-12">
        <label class="form-label">Notes</label>
        @Html.TextAreaFor(x => x.Notes, new { @class = "form-control", rows = "4", placeholder = "Enter notes" })
        @Html.ValidationMessageFor(x => x.Notes, "", new { @class = "text-danger" })
    </div>

    <div class="col-12 text-center mt-4">
        <button type="submit" class="btn btn-primary me-2">Update Invoice</button>

        @Html.ActionLink(
            "Back to Invoice",
            "Read",
            "Invoices",
            new { invoiceId = Model.InvoiceId },
            new { @class = "btn btn-secondary ms-2" })
    </div>

}
