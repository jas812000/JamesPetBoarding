@model JamesPetBoarding.ViewModels.InvoiceDetailsVM
@using JamesPetBoarding.Enums
@{
    ViewBag.Title = "Read Invoice";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1>Paws &amp; Reservations, LLC</h1>
    <h2>View Invoice</h2>
    <p class="lead">
        Review invoice details, charges, payments and the current balance.
    </p>
</div>

<div class="row g-3 justify-content-center">

    <div class="col-auto" style="width: 500px;">
        <label class="form-label">Invoice ID</label>

        @Html.TextBoxFor(
            x => x.InvoiceId,
            new
            {
                @class = "form-control",
                @readonly = "readonly",
                style = "max-width: none;"
            })
    </div>

    <div class="col-auto" style="width: 400px;">
        <label class="form-label">Invoice Date/Time</label>

        @Html.TextBoxFor(
            x => x.InvoiceDateTimeDisplay,
            new
            {
                @class = "form-control",
                @readonly = "readonly",
                style = "max-width: none;"
            })
    </div>

    <div class="w-100"></div>

    <div class="col-auto" style="width: 350px;">
        <label class="form-label">Customer</label>

        @Html.TextBoxFor(
            x => x.CustomerNameDisplay,
            new
            {
                @class = "form-control",
                @readonly = "readonly",
                style = "max-width: none;"
            })
    </div>

    <div class="col-auto" style="width: 250px;">
        <label class="form-label">Pet</label>

        @Html.TextBoxFor(
            x => x.PetNameDisplay,
            new
            {
                @class = "form-control",
                @readonly = "readonly",
                style = "max-width: none;"
            })
    </div>

    <div class="col-auto" style="width: 400px;">
        <label class="form-label">Boarding</label>

        @Html.TextBoxFor(
            x => x.BoardingDisplay,
            new
            {
                @class = "form-control",
                @readonly = "readonly",
                style = "max-width: none;"
            })
    </div>

    <div class="w-100"></div>

    <div class="col-auto" style="width: 250px;">
        <label class="form-label">Status</label>

        @Html.TextBoxFor(
            x => x.StatusDisplay,
            new
            {
                @class = "form-control",
                @readonly = "readonly",
                style = "max-width: none;"
            })
    </div>

    <div class="col-auto" style="width: 250px;">
        <label class="form-label">Subtotal</label>

        @Html.TextBoxFor(
            x => x.SubtotalDisplay,
            new
            {
                @class = "form-control",
                @readonly = "readonly",
                style = "max-width: none;"
            })
    </div>

    <div class="col-auto" style="width: 250px;">
        <label class="form-label">Tax</label>

        @Html.TextBoxFor(
            x => x.TaxAmountDisplay,
            new
            {
                @class = "form-control",
                @readonly = "readonly",
                style = "max-width: none;"
            })
    </div>

    <div class="col-auto" style="width: 250px;">
        <label class="form-label">Discount</label>

        @Html.TextBoxFor(
            x => x.DiscountAmountDisplay,
            new
            {
                @class = "form-control",
                @readonly = "readonly",
                style = "max-width: none;"
            })
    </div>

    <div class="col-auto" style="width: 250px;">
        <label class="form-label">Total</label>

        @Html.TextBoxFor(
            x => x.TotalAmountDisplay,
            new
            {
                @class = "form-control",
                @readonly = "readonly",
                style = "max-width: none;"
            })
    </div>

    <div class="w-100"></div>

    <div class="col-auto" style="width: 350px;">
        <label class="form-label">Amount Paid</label>

        @Html.TextBoxFor(
            x => x.AmountPaidDisplay,
            new
            {
                @class = "form-control",
                @readonly = "readonly",
                style = "max-width: none;"
            })
    </div>

    <div class="col-auto" style="width: 350px;">
        <label class="form-label">Balance</label>

        @Html.TextBoxFor(
            x => x.BalanceDisplay,
            new
            {
                @class = "form-control",
                @readonly = "readonly",
                style = "max-width: none;"
            })
    </div>

    @if (Model.InvoiceStatus == InvoiceStatusEnum.Void)
    {
        <div class="w-100"></div>

        <div class="col-auto" style="width: 1000px;">
            <h4 class="mt-3">Void Information</h4>
        </div>

        <div class="w-100"></div>

        <div class="col-auto" style="width: 300px;">
            <label class="form-label">Void Date/Time</label>

            @Html.TextBoxFor(
                x => x.VoidDateTimeDisplay,
                new
                {
                    @class = "form-control",
                    @readonly = "readonly",
                    style = "max-width: none;"
                })
        </div>

        <div class="col-auto" style="width: 300px;">
            <label class="form-label">Voided By</label>

            @Html.TextBoxFor(
                x => x.VoidedByEmployeeDisplay,
                new
                {
                    @class = "form-control",
                    @readonly = "readonly",
                    style = "max-width: none;"
                })
        </div>

        <div class="col-auto" style="width: 400px;">
            <label class="form-label">Void Reason</label>

            @Html.TextBoxFor(
                x => x.VoidReasonDisplay,
                new
                {
                    @class = "form-control",
                    @readonly = "readonly",
                    style = "max-width: none;"
                })
        </div>

        <div class="w-100"></div>

        <div class="col-auto" style="width: 1000px;">
            <label class="form-label">Void Notes</label>

            @Html.TextAreaFor(
                x => x.VoidNotes,
                new
                {
                    @class = "form-control",
                    rows = "3",
                    @readonly = "readonly",
                    style = "max-width: none;"
                })
        </div>
    }

    <div class="w-100"></div>

    <div class="col-auto" style="width: 1000px;">
        <label class="form-label">Notes</label>

        @Html.TextAreaFor(
            x => x.NotesDisplay,
            new
            {
                @class = "form-control",
                rows = "4",
                @readonly = "readonly",
                style = "max-width: none;"
            })
    </div>

    <div class="w-100"></div>

    <div class="col-auto mt-4" style="width: 1100px;">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">Invoice Items</h3>

            @if (Model.InvoiceStatus != InvoiceStatusEnum.Void)
            {
                @Html.ActionLink(
                    "Add Invoice Item",
                    "Create",
                    "InvoiceItems",
                    new { invoiceId = Model.InvoiceId },
                    new
                    {
                        @class = "btn btn-success",
                        style = "width: 220px;"
                    })
            }
        </div>

        @if (Model.InvoiceItems != null &&
             Model.InvoiceItems.Any())
        {
            <div class="table-responsive">

                <table class="table table-striped table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Description</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Line Total</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var invoiceItem in Model.InvoiceItems)
                        {
                            <tr>
                                <td>@invoiceItem.Description</td>
                                <td>@invoiceItem.QuantityDisplay</td>
                                <td>@invoiceItem.UnitPriceDisplay</td>
                                <td>@invoiceItem.LineTotalDisplay</td>

                                <td>
                                    @Html.ActionLink(
                                        "View",
                                        "Read",
                                        "InvoiceItems",
                                        new
                                        {
                                            invoiceItemId =
                                                invoiceItem.InvoiceItemId
                                        },
                                        new
                                        {
                                            @class =
                                                "btn btn-primary btn-sm me-1"
                                        })

                                    @if (Model.InvoiceStatus !=
                                         InvoiceStatusEnum.Void)
                                    {
                                        @Html.ActionLink(
                                            "Update",
                                            "Update",
                                            "InvoiceItems",
                                            new
                                            {
                                                invoiceItemId =
                                                    invoiceItem.InvoiceItemId
                                            },
                                            new
                                            {
                                                @class =
                                                    "btn btn-warning btn-sm me-1"
                                            })

                                        @Html.ActionLink(
                                            "Delete",
                                            "Delete",
                                            "InvoiceItems",
                                            new
                                            {
                                                invoiceItemId =
                                                    invoiceItem.InvoiceItemId
                                            },
                                            new
                                            {
                                                @class =
                                                    "btn btn-danger btn-sm"
                                            })
                                    }
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>

            </div>
        }
        else
        {
            <div class="alert alert-info mb-0">
                No invoice items have been added to this invoice.
            </div>
        }

    </div>

    <div class="w-100"></div>

    <div class="col-auto mt-4" style="width: 1100px;">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">Payments</h3>

            @if (Model.InvoiceStatus != InvoiceStatusEnum.Void)
            {
                @Html.ActionLink(
                    "Add Payment",
                    "Create",
                    "Payments",
                    new { invoiceId = Model.InvoiceId },
                    new
                    {
                        @class = "btn btn-success",
                        style = "width: 220px;"
                    })
            }
        </div>

        @if (Model.Payments != null &&
             Model.Payments.Any())
        {
            <div class="table-responsive">

                <table class="table table-striped table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Payment Date</th>
                            <th>Payment Method</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Processed By</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var payment in Model.Payments)
                        {
                            <tr>
                                <td>@payment.PaymentDateTimeDisplay</td>
                                <td>@payment.PaymentMethodDisplay</td>
                                <td>@payment.AmountDisplay</td>
                                <td>@payment.StatusDisplay</td>
                                <td>@payment.ProcessedByEmployeeDisplay</td>

                                <td>
                                    @Html.ActionLink(
                                        "View",
                                        "Read",
                                        "Payments",
                                        new
                                        {
                                            paymentId = payment.PaymentId
                                        },
                                        new
                                        {
                                            @class =
                                                "btn btn-primary btn-sm me-1"
                                        })

                                    @if (!payment.IsVoided &&
                                         Model.InvoiceStatus !=
                                         InvoiceStatusEnum.Void)
                                    {
                                        @Html.ActionLink(
                                            "Void",
                                            "Void",
                                            "Payments",
                                            new
                                            {
                                                paymentId = payment.PaymentId
                                            },
                                            new
                                            {
                                                @class =
                                                    "btn btn-danger btn-sm"
                                            })
                                    }
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>

            </div>
        }
        else
        {
            <div class="alert alert-info mb-0">
                No payments have been added for this invoice.
            </div>
        }

    </div>

    <div class="w-100"></div>

    <div class="col-12 text-center mt-4">

        @if (Model.InvoiceStatus != InvoiceStatusEnum.Void)
        {
            <div class="d-flex justify-content-center gap-3 flex-wrap">

                @Html.ActionLink(
                    "Update Invoice",
                    "Update",
                    "Invoices",
                    new { invoiceId = Model.InvoiceId },
                    new
                    {
                        @class = "btn btn-primary",
                        style = "width: 280px;"
                    })

                @Html.ActionLink(
                    "Void Invoice",
                    "Void",
                    "Invoices",
                    new { invoiceId = Model.InvoiceId },
                    new
                    {
                        @class = "btn btn-danger",
                        style = "width: 280px;"
                    })

                @Html.ActionLink(
                    "Receipt",
                    "Receipt",
                    "Invoices",
                    new { invoiceId = Model.InvoiceId },
                    new
                    {
                        @class = "btn btn-secondary",
                        style = "width: 280px;"
                    })

            </div>

            <div class="d-flex justify-content-center mt-3">

                @Html.ActionLink(
                    "Back to Invoice Search",
                    "Search",
                    "Invoices",
                    null,
                    new
                    {
                        @class = "btn btn-secondary",
                        style = "width: 280px;"
                    })

            </div>
        }
        else
        {
            <div class="d-flex justify-content-center gap-3 flex-wrap">

                @Html.ActionLink(
                    "Receipt",
                    "Receipt",
                    "Invoices",
                    new { invoiceId = Model.InvoiceId },
                    new
                    {
                        @class = "btn btn-secondary",
                        style = "width: 300px;"
                    })

                @Html.ActionLink(
                    "Back to Invoice Search",
                    "Search",
                    "Invoices",
                    null,
                    new
                    {
                        @class = "btn btn-secondary",
                        style = "width: 300px;"
                    })

            </div>
        }

    </div>

</div>
