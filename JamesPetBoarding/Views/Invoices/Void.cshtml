@model JamesPetBoarding.ViewModels.InvoiceVoidVM
@{
    ViewBag.Title = "Void Invoice";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1>Paws &amp; Reservations, LLC</h1>
    <h2>Void Invoice</h2>
    <p class="lead">
        Review the invoice information and provide a reason
        for voiding this invoice.
    </p>
</div>

@using (Html.BeginForm(
    "Void",
    "Invoices",
    FormMethod.Post,
    new { @class = "row g-3 justify-content-center" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(x => x.InvoiceId)

    @Html.ValidationSummary(
        false,
        "",
        new { @class = "text-danger" })

    <div class="col-auto" style="width: 500px;">
        <label class="form-label">Invoice ID</label>

        <input type="text"
               class="form-control"
               value="@Model.InvoiceId"
               readonly="readonly"
               style="max-width: none;" />
    </div>

    <div class="col-auto" style="width: 400px;">
        <label class="form-label">Invoice Date/Time</label>

        @Html.TextBoxFor(
            x => x.InvoiceDateTimeDisplay,
            new
            {
                @class = "form-control",
                @readonly = "readonly",
                style = "max-width: none;"
            })
    </div>

    <div class="w-100"></div>

    <div class="col-auto" style="width: 350px;">
        <label class="form-label">Customer</label>

        @Html.TextBoxFor(
            x => x.CustomerNameDisplay,
            new
            {
                @class = "form-control",
                @readonly = "readonly",
                style = "max-width: none;"
            })
    </div>

    <div class="col-auto" style="width: 250px;">
        <label class="form-label">Pet</label>

        @Html.TextBoxFor(
            x => x.PetNameDisplay,
            new
            {
                @class = "form-control",
                @readonly = "readonly",
                style = "max-width: none;"
            })
    </div>

    <div class="col-auto" style="width: 400px;">
        <label class="form-label">Boarding</label>

        @Html.TextBoxFor(
            x => x.BoardingDisplay,
            new
            {
                @class = "form-control",
                @readonly = "readonly",
                style = "max-width: none;"
            })
    </div>

    <div class="w-100"></div>

    <div class="col-auto" style="width: 250px;">
        <label class="form-label">Status</label>

        @Html.TextBoxFor(
            x => x.StatusDisplay,
            new
            {
                @class = "form-control",
                @readonly = "readonly",
                style = "max-width: none;"
            })
    </div>

    <div class="col-auto" style="width: 300px;">
        <label class="form-label">Total</label>

        @Html.TextBoxFor(
            x => x.TotalAmountDisplay,
            new
            {
                @class = "form-control",
                @readonly = "readonly",
                style = "max-width: none;"
            })
    </div>

    <div class="col-auto" style="width: 300px;">
        <label class="form-label">Amount Paid</label>

        @Html.TextBoxFor(
            x => x.AmountPaidDisplay,
            new
            {
                @class = "form-control",
                @readonly = "readonly",
                style = "max-width: none;"
            })
    </div>

    <div class="col-auto" style="width: 300px;">
        <label class="form-label">Balance</label>

        @Html.TextBoxFor(
            x => x.BalanceDisplay,
            new
            {
                @class = "form-control",
                @readonly = "readonly",
                style = "max-width: none;"
            })
    </div>

    <div class="w-100"></div>

    <div class="col-auto" style="width: 500px;">
        <label class="form-label">Void Reason</label>

        @Html.EnumDropDownListFor(
            x => x.VoidReason,
            "Select...",
            new
            {
                @class = "form-select",
                style = "max-width: none;"
            })

        @Html.ValidationMessageFor(
            x => x.VoidReason,
            "",
            new { @class = "text-danger" })
    </div>

    <div class="w-100"></div>

    <div class="col-auto" style="width: 1000px;">
        <label class="form-label">Void Notes</label>

        @Html.TextAreaFor(
            x => x.VoidNotes,
            new
            {
                @class = "form-control",
                rows = "4",
                placeholder = "Enter void notes",
                style = "max-width: none;"
            })

        @Html.ValidationMessageFor(
            x => x.VoidNotes,
            "",
            new { @class = "text-danger" })
    </div>

    <div class="w-100"></div>

    <div class="col-12 text-center mt-4">
        <div class="d-flex justify-content-center gap-3 flex-wrap">

            <button type="submit"
                    class="btn btn-danger"
                    style="width: 300px;">
                Void Invoice
            </button>

            @Html.ActionLink(
                "Back to Invoice",
                "Read",
                "Invoices",
                new { invoiceId = Model.InvoiceId },
                new
                {
                    @class = "btn btn-secondary",
                    style = "width: 300px;"
                })

        </div>
    </div>
}
