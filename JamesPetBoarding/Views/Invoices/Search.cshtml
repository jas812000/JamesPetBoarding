@model JamesPetBoarding.ViewModels.InvoiceSearchVM
@using JamesPetBoarding.Enums
@{
    ViewBag.Title = "Search Invoices";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1>Paws &amp; Reservations, LLC</h1>
    <h2>Search Invoices</h2>
    <p class="lead">
        Search by one or more fields to find an existing invoice.
    </p>
</div>

@using (Html.BeginForm(
    "Search",
    "Invoices",
    FormMethod.Post,
    new { @class = "row g-3 justify-content-center" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(
        false,
        "",
        new { @class = "text-danger" })

    <div class="col-auto" style="width: 350px;">
        <label class="form-label">Customer</label>

        @Html.DropDownListFor(
            x => x.CustomerId,
            Model.CustomerSelectList,
            "Select Customer...",
            new
            {
                @class = "form-select",
                style = "max-width: none;"
            })
    </div>

    <div class="col-auto" style="width: 300px;">
        <label class="form-label">Pet</label>

        @Html.DropDownListFor(
            x => x.PetId,
            Model.PetSelectList,
            "Select Pet...",
            new
            {
                @class = "form-select",
                style = "max-width: none;"
            })
    </div>

    <div class="col-auto" style="width: 450px;">
        <label class="form-label">Boarding</label>

        @Html.DropDownListFor(
            x => x.BoardingId,
            Model.BoardingSelectList,
            "Select Boarding...",
            new
            {
                @class = "form-select",
                style = "max-width: none;"
            })
    </div>

    <div class="w-100"></div>

    <div class="col-auto" style="width: 300px;">
        <label class="form-label">Invoice Status</label>

        @Html.EnumDropDownListFor(
            x => x.InvoiceStatus,
            "Select Status...",
            new
            {
                @class = "form-select",
                style = "max-width: none;"
            })
    </div>

    <div class="w-100"></div>

    <div class="col-12 text-center mt-4">

        <div class="d-flex justify-content-center gap-3 flex-wrap">

            <button type="submit"
                    class="btn btn-primary"
                    style="width: 300px;">
                Search Invoices
            </button>

            @Html.ActionLink(
                "Create Invoice",
                "Create",
                "Invoices",
                null,
                new
                {
                    @class = "btn btn-success",
                    style = "width: 300px;"
                })

        </div>

        <div class="d-flex justify-content-center gap-3 flex-wrap mt-3">

            @Html.ActionLink(
                "Clear Search",
                "Search",
                "Invoices",
                null,
                new
                {
                    @class = "btn btn-secondary",
                    style = "width: 300px;"
                })

            @Html.ActionLink(
                "Back to Billing",
                "Billing",
                "Staff",
                null,
                new
                {
                    @class = "btn btn-secondary",
                    style = "width: 300px;"
                })

        </div>

    </div>
}

@if (Model.InvoiceSearchResults != null &&
     Model.InvoiceSearchResults.Any())
{
    <h4 class="mt-5">
        Results Found: @Model.InvoiceSearchResults.Count
    </h4>

    <div class="table-responsive mt-3">

        <table class="table table-striped table-bordered align-middle">
            <thead>
                <tr>
                    <th>Customer Name</th>
                    <th>Pet Name</th>
                    <th>Boarding</th>
                    <th>Invoice Status</th>
                    <th>Invoice Date</th>
                    <th>Total Amount</th>
                    <th>Balance</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var invoice in Model.InvoiceSearchResults)
                {
                    <tr>
                        <td>@invoice.CustomerNameDisplay</td>
                        <td>@invoice.PetNameDisplay</td>
                        <td>@invoice.BoardingDisplay</td>
                        <td>@invoice.StatusDisplay</td>
                        <td>@invoice.InvoiceDateTimeDisplay</td>
                        <td>@invoice.TotalAmountDisplay</td>
                        <td>@invoice.BalanceDisplay</td>

                        <td>
                            @Html.ActionLink(
                                "View",
                                "Read",
                                "Invoices",
                                new
                                {
                                    invoiceId = invoice.InvoiceId
                                },
                                new
                                {
                                    @class =
                                        "btn btn-primary btn-sm me-1"
                                })

                            @if (invoice.InvoiceStatus !=
                                 InvoiceStatusEnum.Void)
                            {
                                @Html.ActionLink(
                                    "Update",
                                    "Update",
                                    "Invoices",
                                    new
                                    {
                                        invoiceId = invoice.InvoiceId
                                    },
                                    new
                                    {
                                        @class =
                                            "btn btn-warning btn-sm me-1"
                                    })

                                @Html.ActionLink(
                                    "Void",
                                    "Void",
                                    "Invoices",
                                    new
                                    {
                                        invoiceId = invoice.InvoiceId
                                    },
                                    new
                                    {
                                        @class =
                                            "btn btn-danger btn-sm me-1"
                                    })
                            }

                            @Html.ActionLink(
                                "Receipt",
                                "Receipt",
                                "Invoices",
                                new
                                {
                                    invoiceId = invoice.InvoiceId
                                },
                                new
                                {
                                    @class =
                                        "btn btn-secondary btn-sm"
                                })
                        </td>
                    </tr>
                }

            </tbody>
        </table>

    </div>
}

@if (Request.HttpMethod == "POST" &&
     Model.InvoiceSearchResults != null &&
     !Model.InvoiceSearchResults.Any())
{
    <div class="alert alert-info mt-4">
        No invoices matched the search criteria.
    </div>
}

@section Scripts
{
    <script>
        (function () {
            var customer = document.getElementById("CustomerId");
            var pet = document.getElementById("PetId");
            var boarding = document.getElementById("BoardingId");
            var searchButton =
                document.querySelector('button[type="submit"]');

            var selectionsUrl =
                '@Url.Action("GetInvoiceSelections", "Invoices")';

            var requestNumber = 0;

            function selectedValue(element) {
                var value = element.value;

                return value &&
                    value !== "00000000-0000-0000-0000-000000000000"
                    ? value
                    : "";
            }

            function contains(items, value) {
                return items.some(function (item) {
                    return item.Value.toLowerCase() === value.toLowerCase();
                });
            }

            function render(element, placeholder, items, value) {
                element.innerHTML = "";

                var first = document.createElement("option");
                first.value = "";
                first.textContent = placeholder;
                element.appendChild(first);

                items.forEach(function (item) {
                    var option = document.createElement("option");
                    option.value = item.Value;
                    option.textContent = item.Text;
                    element.appendChild(option);
                });

                element.value =
                    value && contains(items, value) ? value : "";
            }

            function loadSelections(changedField) {
                var customerId = selectedValue(customer);
                var petId = selectedValue(pet);
                var boardingId = selectedValue(boarding);

                if (changedField === "customer" ||
                    changedField === "pet") {
                    boardingId = "";
                    boarding.value = "";
                }

                var currentRequest = ++requestNumber;
                searchButton.disabled = true;

                var parameters = new URLSearchParams();
                parameters.append("includeInactive", "true");

                if (customerId) {
                    parameters.append("customerId", customerId);
                }

                if (petId) {
                    parameters.append("petId", petId);
                }

                if (boardingId) {
                    parameters.append("boardingId", boardingId);
                }

                fetch(selectionsUrl + "?" + parameters.toString())
                    .then(function (response) {
                        if (!response.ok) {
                            throw new Error("Unable to load selections.");
                        }

                        return response.json();
                    })
                    .then(function (result) {
                        if (currentRequest !== requestNumber) {
                            return;
                        }

                        if (result.Error) {
                            throw new Error(result.Error);
                        }

                        if (changedField === "customer" &&
                            petId &&
                            !contains(result.Pets, petId)) {
                            pet.value = "";
                            loadSelections("customer");
                            return;
                        }

                        if (changedField === "pet" &&
                            customerId &&
                            !contains(result.Customers, customerId)) {
                            customer.value = "";
                            loadSelections("pet");
                            return;
                        }

                        if (boardingId) {
                            customerId = result.CustomerId;
                            petId = result.PetId;
                        }

                        render(
                            customer,
                            "Select Customer...",
                            result.Customers,
                            customerId
                        );

                        render(
                            pet,
                            "Select Pet...",
                            result.Pets,
                            petId
                        );

                        render(
                            boarding,
                            "Select Boarding...",
                            result.Boardings,
                            boardingId
                        );

                        searchButton.disabled = false;
                    })
                    .catch(function () {
                        if (currentRequest !== requestNumber) {
                            return;
                        }

                        searchButton.disabled = false;
                        alert(
                            "Unable to load search selections. Please try again."
                        );
                    });
            }

            customer.addEventListener("change", function () {
                loadSelections("customer");
            });

            pet.addEventListener("change", function () {
                loadSelections("pet");
            });

            boarding.addEventListener("change", function () {
                loadSelections("boarding");
            });
        })();
    </script>
}
