@model JamesPetBoarding.ViewModels.PetSearchVM
@{
    ViewBag.Title = "Search Pets";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Search Pets</h2>
    <p class="lead">
        Search by one or more fields to find an existing pet profile.
    </p>
</div>

@using (Html.BeginForm("Search", "Pets", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    <div class="col-auto" style="width: 420px;">
        <label class="form-label">Pet Name</label>

        @Html.TextBoxFor(
            x => x.PetName,
            new
            {
                @class = "form-control",
                style = "max-width: none;"
            })

        @Html.ValidationMessageFor(
            x => x.PetName,
            "",
            new { @class = "text-danger" })
    </div>

    <div class="col-auto" style="width: 420px;">
        <label class="form-label">Species</label>

        @Html.EnumDropDownListFor(
            x => x.Species,
            "Select...",
            new
            {
                @class = "form-select",
                style = "max-width: none;"
            })

        @Html.ValidationMessageFor(
            x => x.Species,
            "",
            new { @class = "text-danger" })
    </div>

    <div class="col-auto" style="width: 420px;">
        <label class="form-label">Breed</label>

        @Html.TextBoxFor(
            x => x.Breed,
            new
            {
                @class = "form-control",
                style = "max-width: none;"
            })

        @Html.ValidationMessageFor(
            x => x.Breed,
            "",
            new { @class = "text-danger" })
    </div>

    <div class="col-auto" style="width: 420px;">
        <label class="form-label">Sex</label>

        @Html.EnumDropDownListFor(
            x => x.Sex,
            "Select...",
            new
            {
                @class = "form-select",
                style = "max-width: none;"
            })

        @Html.ValidationMessageFor(
            x => x.Sex,
            "",
            new { @class = "text-danger" })
    </div>

    <div class="col-auto" style="width: 420px;">
        <label class="form-label">Active Status</label>

        @Html.DropDownListFor(
            x => x.IsActive,
            new List<SelectListItem>
            {
                new SelectListItem
                {
                    Text = "All Pets",
                    Value = ""
                },
                new SelectListItem
                {
                    Text = "Active",
                    Value = "true"
                },
                new SelectListItem
                {
                    Text = "Inactive",
                    Value = "false"
                }
            },
            new
            {
                    @class = "form-select",
                style = "max-width: none;"
            })

        <small class="text-muted">
            Select All Pets, Active or Inactive.
        </small>

        @Html.ValidationMessageFor(
            x => x.IsActive,
            "",
            new { @class = "text-danger" })
    </div>

    <div class="col-12 text-center mt-4">
        <button type="submit" class="btn btn-primary me-2">Search Pets</button>

        @Html.ActionLink(
            "Create Pet",
            "Create",
            "Pets",
            null,
            new { @class = "btn btn-success ms-2" })

        @Html.ActionLink(
            "Clear Search",
            "Search",
            "Pets",
            null,
            new { @class = "btn btn-secondary ms-2" })

        @Html.ActionLink(
            "Back to Dashboard",
            "Index",
            "Dashboard",
            null,
            new { @class = "btn btn-secondary ms-2" })
    </div>
}

@if (Model.PetSummaryResults != null && Model.PetSummaryResults.Any())
{
<h4 class="mt-4">
    Results Found: @Model.PetSummaryResults.Count
</h4>

<div class="mt-3">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Pet Name</th>
                <th>Species</th>
                <th>Breed</th>
                <th>Sex</th>
                <th>Active Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var pet in Model.PetSummaryResults)
                            {
            <tr>
                <td>@pet.PetNameDisplay</td>
                <td>@pet.SpeciesDisplay</td>
                <td>@pet.BreedDisplay</td>
                <td>@pet.SexDisplay</td>
                <td>@pet.ActiveStatusDisplay</td>

                <td>
                    @Html.ActionLink(
                        "View",
                        "Read",
                        "Pets",
                        new { petId = pet.PetId },
                        new { @class = "btn btn-primary btn-sm me-1" })

                    @Html.ActionLink(
                        "Update",
                        "Update",
                        "Pets",
                        new { petId = pet.PetId },
                        new { @class = "btn btn-warning btn-sm me-1" })
                </td>
            </tr>
                            }
        </tbody>
    </table>
</div>
}

@if (Request.HttpMethod == "POST" &&
     Model.PetSummaryResults != null &&
     !Model.PetSummaryResults.Any())
{
    <div class="alert alert-info mt-4">
        No pets matched the search criteria.
    </div>
}
