@model JamesPetBoarding.ViewModels.PetFormVM
@{
    ViewBag.Title = "Create Pet";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1>Paws &amp; Reservations, LLC</h1>
    <h2>Create Pet Profile</h2>
    <p class="lead">
        Enter pet information to create a new pet profile.
    </p>
</div>

@using (Html.BeginForm("Create", "Pets", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    <div class="col-auto" style="width: 350px;">
        <label class="form-label">Pet Name</label>
        @Html.TextBoxFor(x => x.PetName, new { @class = "form-control", style = "max-width: none;" })
        @Html.ValidationMessageFor(x => x.PetName, "", new { @class = "text-danger" })
    </div>

    <div class="col-auto" style="width: 250px;">
        <label class="form-label">Species</label>
        @Html.EnumDropDownListFor(x => x.Species, "Select...", new { @class = "form-select", style = "max-width: none;" })
        @Html.ValidationMessageFor(x => x.Species, "", new { @class = "text-danger" })
    </div>

    <div class="col-auto" style="width: 350px;">
        <label class="form-label">Breed</label>
        @Html.TextBoxFor(x => x.Breed, new { @class = "form-control", style = "max-width: none;" })
        @Html.ValidationMessageFor(x => x.Breed, "", new { @class = "text-danger" })
    </div>

    <div class="w-100"></div>

    <div class="col-auto" style="width: 250px;">
        <label class="form-label">Sex</label>
        @Html.EnumDropDownListFor(x => x.Sex, "Select...", new { @class = "form-select", style = "max-width: none;" })
        @Html.ValidationMessageFor(x => x.Sex, "", new { @class = "text-danger" })
    </div>

    <div class="col-auto" style="width: 300px;">
        <label class="form-label">Birth Date</label>
        @Html.TextBoxFor(
            x => x.BirthDate,
            "{0:yyyy-MM-dd}",
            new { @class = "form-control", type = "date", style = "max-width: none;" })
        @Html.ValidationMessageFor(x => x.BirthDate, "", new { @class = "text-danger" })
    </div>

    <div class="col-auto" style="width: 250px;">
        <label class="form-label">Weight (lbs)</label>
        @Html.TextBoxFor(x => x.Weight, new { @class = "form-control", style = "max-width: none;" })
        @Html.ValidationMessageFor(x => x.Weight, "", new { @class = "text-danger" })
    </div>

    <div class="w-100"></div>

    <div class="col-auto" style="width: 600px;">
        <label class="form-label">Veterinarian</label>
        @Html.DropDownListFor(
            x => x.VetId,
            Model.VeterinarianSelectList,
            "Select...",
            new { @class = "form-select", style = "max-width: none;" })
        @Html.ValidationMessageFor(x => x.VetId, "", new { @class = "text-danger" })
    </div>

    <div class="w-100"></div>

    <div class="col-auto" style="width: 900px;">
        <label class="form-label">Notes</label>
        @Html.TextAreaFor(
            x => x.Notes,
            new
            {
                @class = "form-control",
                rows = "4",
                placeholder = "Enter notes",
                style = "max-width: none;"
            })
        @Html.ValidationMessageFor(x => x.Notes, "", new { @class = "text-danger" })
    </div>

    <div class="w-100"></div>

    <div class="col-12 text-center mt-4">
        <div class="d-flex justify-content-center gap-3 flex-wrap">

            <button type="submit"
                    id="CreatePetButton"
                    class="btn btn-secondary"
                    style="width: 300px;"
                    disabled>
                Create Pet Profile
            </button>

            @Html.ActionLink(
                "Cancel",
                "Search",
                "Pets",
                null,
                new
                {
                    @class = "btn btn-secondary",
                    style = "width: 300px;"
                })

        </div>
    </div>
}

@section Scripts
{
    <script>
        (function () {
            var petName = document.getElementById("PetName");
            var species = document.getElementById("Species");
            var breed = document.getElementById("Breed");
            var sex = document.getElementById("Sex");
            var birthDate = document.getElementById("BirthDate");
            var weight = document.getElementById("Weight");
            var createButton = document.getElementById("CreatePetButton");

            function hasText(element) {
                return element.value.trim().length > 0;
            }

            function hasSelection(element) {
                return element.value !== "";
            }

            function hasValidDate(element) {
                return element.value &&
                    !element.value.startsWith("0001-01-01");
            }

            function hasValidWeight(element) {
                var weightValue = parseFloat(element.value);

                return !isNaN(weightValue) &&
                    weightValue > 0;
            }

            function updateCreateButton() {
                var formIsComplete =
                    hasText(petName) &&
                    hasSelection(species) &&
                    hasText(breed) &&
                    hasSelection(sex) &&
                    hasValidDate(birthDate) &&
                    hasValidWeight(weight);

                createButton.disabled = !formIsComplete;

                createButton.classList.toggle("btn-success", formIsComplete);
                createButton.classList.toggle("btn-secondary", !formIsComplete);
            }

            petName.addEventListener("input", updateCreateButton);
            species.addEventListener("change", updateCreateButton);
            breed.addEventListener("input", updateCreateButton);
            sex.addEventListener("change", updateCreateButton);
            birthDate.addEventListener("input", updateCreateButton);
            weight.addEventListener("input", updateCreateButton);

            updateCreateButton();
        })();
    </script>
}
