@model JamesPetBoarding.ViewModels.DietFormVM
@{
    ViewBag.Title = "Create Diet";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Create Diet Profile</h2>
    <p class="lead">
        Enter diet information to create a new diet profile for this pet.
    </p>
</div>

@using (Html.BeginForm("Create", "Diets", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    @Html.HiddenFor(x => x.PetId)

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    <div class="col-auto" style="width: 350px;">
        <label class="form-label">Pet Name</label>
        @Html.TextBoxFor(x => x.PetNameDisplay, new { @class = "form-control", @readonly = "readonly", style = "max-width: none;" })
    </div>

    <div class="col-auto" style="width: 350px;">
        <label class="form-label">Food Name</label>
        @Html.TextBoxFor(x => x.FoodName, new { @class = "form-control", style = "max-width: none;" })
        @Html.ValidationMessageFor(x => x.FoodName, "", new { @class = "text-danger" })
    </div>

    <div class="col-auto" style="width: 300px;">
        <label class="form-label">Amount</label>
        @Html.TextBoxFor(x => x.Amount, new { @class = "form-control", style = "max-width: none;" })
        @Html.ValidationMessageFor(x => x.Amount, "", new { @class = "text-danger" })
    </div>

    <div class="w-100"></div>

    <div class="col-auto" style="width: 300px;">
        <label class="form-label">Frequency</label>
        @Html.EnumDropDownListFor(x => x.Frequency, "Select...", new { @class = "form-select", style = "max-width: none;" })
        @Html.ValidationMessageFor(x => x.Frequency, "", new { @class = "text-danger" })
    </div>

    <div class="w-100"></div>

    <div class="col-auto" style="width: 1000px;">
        <label class="form-label">Notes</label>
        @Html.TextAreaFor(x => x.Notes, new { @class = "form-control", rows = "4", placeholder = "Enter notes", style = "max-width: none;" })
        @Html.ValidationMessageFor(x => x.Notes, "", new { @class = "text-danger" })
    </div>

    <div class="col-12 text-center mt-4">
        <div class="d-flex justify-content-center gap-3 flex-wrap">
        <button type="submit" class="btn btn-success" style="width: 300px;">Create Diet Profile</button>

        @Html.ActionLink(
            "Cancel",
            "Read",
            "Pets",
           new { petId = Model.PetId },
            new { @class = "btn btn-secondary ms-2", style = "width: 300px;" })

        </div>
    </div>
}
