@model JamesPetBoarding.ViewModels.BoardingUnitFormVM
@{
    ViewBag.Title = "Update Boarding Unit";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Update Boarding Unit Profile</h2>
    <p class="lead">
        Update boarding unit profile information and profile details.
    </p>
</div>


@using (Html.BeginForm("Update", "BoardingUnits", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    @Html.HiddenFor(x => x.BoardingUnitId)


    <div class="col-md-4">
        <label class="form-label">Unit Type</label>
        @Html.EnumDropDownListFor(x => x.UnitType, "Select...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.UnitType, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Unit Name</label>
        @Html.EnumDropDownListFor(x => x.UnitName, "Select...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.UnitName, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Unit Number</label>
        @Html.TextBoxFor(x => x.UnitNumber, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.UnitNumber, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Species Allowed</label>
        @Html.EnumDropDownListFor(x => x.SpeciesAllowed, "Select...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.SpeciesAllowed, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Size Category</label>
        @Html.EnumDropDownListFor(x => x.SizeCategory, "Select...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.SizeCategory, "", new { @class = "text-danger" })
    </div>

    <div class="col-12">
        <label class="form-label">Notes</label>
        @Html.TextAreaFor(x => x.Notes, new { @class = "form-control", rows = "4", placeholder = "Enter notes" })
        @Html.ValidationMessageFor(x => x.Notes, "", new { @class = "text-danger" })
    </div>

    <div class="col-12 text-center mt-4">
        <button type="submit" class="btn btn-success me-2">Update Boarding Unit Profile</button>

        @Html.ActionLink(
            "Cancel",
            "Read",
            "BoardingUnits",
            new { boardingUnitId = Model.BoardingUnitId },
            new { @class = "btn btn-secondary ms-2" })
    </div>

}