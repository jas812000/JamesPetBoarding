@model JamesPetBoarding.ViewModels.PaymentSearchVM
@using JamesPetBoarding.Enums
@{
    ViewBag.Title = "Search Payments";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Search Payments</h2>
    <p class="lead">
        Search by one or more fields to find an existing Payment.
    </p>
</div>

@using (Html.BeginForm("Search", "Payments", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    @Html.DropDownListFor(x => x.InvoiceId, Model.InvoiceSelectList, "Select Invoice...", new { @class = "form-select" })

    @Html.DropDownListFor(x => x.CustomerId, Model.CustomerSelectList, "Select Customer...", new { @class = "form-select" })

    @Html.DropDownListFor(x => x.PetId, Model.PetSelectList, "Select Pet...", new { @class = "form-select" })

    @Html.DropDownListFor(x => x.ProcessedByEmployeeId, Model.EmployeeSelectList, "Select Processed Employee...", new { @class = "form-select" })

    @Html.TextBoxFor(x => x.StartPaymentDateTime, new { @class = "form-control", type = "date" })

    @Html.TextBoxFor(x => x.EndPaymentDateTime, new { @class = "form-control", type = "date" })

    @Html.TextBoxFor(x => x.TransactionReference, new { @class = "form-control", placeholder = "Transaction Reference" })

    @Html.EnumDropDownListFor(x => x.PaymentMethod, "Select Payment Method...", new { @class = "form-select" })

    @Html.DropDownListFor(
        x => x.IsVoided,
        new List<SelectListItem>
        {
            new SelectListItem
            {
                Text = "Processed",
                Value = "false"
            },
            new SelectListItem
            {
                Text = "Voided",
                Value = "true"
            }
        },
        "Select Payment Status...",
        new { @class = "form-select" })


    <div class="col-12 text-center mt-4">
        <button type="submit" class="btn btn-primary me-2">Search Payments</button>

        @Html.ActionLink(
            "Clear Search",
            "Search",
            "Payments",
            null,
            new { @class = "btn btn-secondary ms-2" })

        @Html.ActionLink(
            "Back to Billing",
            "Billing",
            "Staff",
            null,
            new { @class = "btn btn-secondary ms-2" })
    </div>

}

@if (Model.PaymentSearchResults != null && Model.PaymentSearchResults.Any())
{
    <h4 class="mt-4">
        Results Found: @Model.PaymentSearchResults.Count
    </h4>

    <div class="mt-3">

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Invoice</th>
                    <th>Customer</th>
                    <th>Pet</th>
                    <th>Amount</th>
                    <th>Payment Method</th>
                    <th>Payment Date</th>
                    <th>Processed By</th>
                    <th>Transaction Reference</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var payment in Model.PaymentSearchResults)
                {
                    <tr>
                        <td>@payment.InvoiceDisplay</td>
                        <td>@payment.CustomerNameDisplay</td>
                        <td>@payment.PetNameDisplay</td>
                        <td>@payment.AmountDisplay</td>
                        <td>@payment.PaymentMethodDisplay</td>
                        <td>@payment.PaymentDateTimeDisplay</td>
                        <td>@payment.ProcessedByEmployeeDisplay</td>
                        <td>@payment.TransactionReferenceDisplay</td>
                        <td>@payment.StatusDisplay</td>

                        <td>
                            @Html.ActionLink(
                                 "View",
                                 "Read",
                                 "Payments",
                                 new { paymentId = payment.PaymentId },
                                 new { @class = "btn btn-primary btn-sm me-1" })


                            @if (!payment.IsVoided)
                            {

                                @Html.ActionLink(
                                    "Update",
                                    "Update",
                                    "Payments",
                                    new { paymentId = payment.PaymentId },
                                    new { @class = "btn btn-warning btn-sm me-1" })

                                @Html.ActionLink(
                                    "Void",
                                    "Void",
                                    "Payments",
                                    new { paymentId = payment.PaymentId },
                                    new { @class = "btn btn-danger btn-sm me-1" })

                            }

                            @Html.ActionLink(
                                "Invoice",
                                "Read",
                                "Invoices",
                                new { invoiceId = payment.InvoiceId },
                                new { @class = "btn btn-secondary btn-sm" })

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Request.HttpMethod == "POST" &&
    Model.PaymentSearchResults != null &&
    !Model.PaymentSearchResults.Any())
{
    <div class="alert alert-info mt-4">
        No payments matched the search criteria.
    </div>
}
