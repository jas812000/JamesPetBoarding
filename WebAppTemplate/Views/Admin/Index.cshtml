@{
    ViewBag.Title = "Admin Dashboard";
}

<div class="text-center border-bottom pb-4 mb-5">
    <h1>Paws &amp; Reservations, LLC</h1>
    <h2>Admin Dashboard</h2>
</div>

<div class="border-bottom mb-4">
    <h3>Staff Operations</h3>
</div>

<div class="row g-4 justify-content-center">

    <div class="col-md-5">
        @Html.ActionLink(
            "Boarding Management",
            "BoardingManagement",
            "Staff",
            null,
            new { @class = "btn btn-primary w-100 py-5" })
    </div>

    <div class="col-md-5">
        @Html.ActionLink(
            "Pet Search",
            "Search",
            "Pets",
            null,
            new { @class = "btn btn-primary w-100 py-5" })
    </div>

    <div class="col-md-5">
        @Html.ActionLink(
            "Customer Search",
            "Search",
            "Customers",
            null,
            new { @class = "btn btn-primary w-100 py-5" })
    </div>

    <div class="col-md-5">
        @Html.ActionLink(
            "Billing",
            "Billing",
            "Staff",
            null,
            new { @class = "btn btn-primary w-100 py-5" })
    </div>

</div>

<div class="border-bottom mt-5 mb-4">
    <h3>Administration</h3>
</div>

<div class="row g-4 justify-content-center">

    <div class="col-md-5">
        @Html.ActionLink(
            "Boarding Units",
            "Search",
            "BoardingUnits",
            null,
            new { @class = "btn btn-primary w-100 py-5" })
    </div>

    <div class="col-md-5">
        @Html.ActionLink(
            "Services",
            "Search",
            "Services",
            null,
            new { @class = "btn btn-primary w-100 py-5" })
    </div>

    <div class="col-md-5">
        @Html.ActionLink(
            "Vaccines",
            "Search",
            "Vaccines",
            null,
            new { @class = "btn btn-primary w-100 py-5" })
    </div>

    <div class="col-md-5">
        @Html.ActionLink(
            "Reports",
            "Index",
            "Reports",
            null,
            new { @class = "btn btn-primary w-100 py-5" })
    </div>

    @if (ViewBag.CanManageEmployees)
    {
        <div class="col-md-5">
            @Html.ActionLink(
                "Employee Management",
                "Search",
                "Employees",
                null,
                new { @class = "btn btn-primary w-100 py-5" })
        </div>
    }
    else if (ViewBag.IsSupervisor)
    {
        <div class="col-md-5">
            @Html.ActionLink(
                "Employee Directory",
                "Search",
                "Employees",
                null,
                new { @class = "btn btn-primary w-100 py-5" })
        </div>
    }

</div>

<div class="text-center border-top mt-5 pt-4">

    @using (Html.BeginForm("LogOff", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-secondary px-5 py-3">
            Logout
        </button>
    }

</div>