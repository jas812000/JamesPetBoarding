@{
    ViewBag.Title = "Contact";
}

<main>
    <section class="py-5" aria-labelledby="contactTitle">
        <h1 id="contactTitle">Contact Us</h1>

        <p class="lead">
            We are happy to answer questions about our services, availability,
            or your pet’s care needs.
        </p>

        <p>
            Contact us directly or use our online message form. A member of our
            team will respond within one to two business days.
        </p>
    </section>

    <section class="row g-4" aria-label="Contact information">
        <div class="col-md-6">
            <article class="card h-100">
                <div class="card-body">
                    <h2 class="card-title h4">Contact Information</h2>

                    <address class="card-text">
                        <strong>Paws &amp; Reservations, LLC</strong><br />
                        4821 Shady Creek Lane<br />
                        Dallas, Texas 75201
                    </address>

                    <p class="card-text">
                        <strong>Phone:</strong><br />
                        <a href="tel:+12145550192">(214) 555-0192</a>
                    </p>

                    <p class="card-text mb-0">
                        <strong>Email:</strong><br />
                        <a href="mailto:info@pawsandreservations.com">
                            info@pawsandreservations.com
                        </a>
                    </p>
                </div>
            </article>
        </div>

        <div class="col-md-6">
            <article class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title h4">Send Us a Message</h2>

                    <p class="card-text">
                        Use our online form for general questions, service inquiries,
                        or additional information about caring for your pet.
                    </p>

                    <p class="card-text">
                        Please do not use the form for urgent matters because messages
                        may not be reviewed immediately.
                    </p>

                    <a class="btn btn-primary mt-auto align-self-start"
                       href="@Url.Action("Index", "ContactUsSubmission")">
                        Open Contact Form
                    </a>
                </div>
            </article>
        </div>
    </section>

    <section class="row mt-5" aria-labelledby="visitContactTitle">
        <div class="col-12">
            <h2 id="visitContactTitle">Visit or Call Us</h2>
        </div>

        <div class="col-md-6">
            <h3 class="h5">Business Hours</h3>

            <p>
                Monday–Friday: 7:00 AM–7:00 PM<br />
                Saturday–Sunday: 8:00 AM–5:00 PM
            </p>

            <a class="btn btn-outline-dark"
               href="@Url.Action("Hours", "Home")">
                View Complete Hours
            </a>
        </div>

        <div class="col-md-6">
            <h3 class="h5">Urgent Matters</h3>

            <p>
                If your matter is urgent, call us directly at
                <a href="tel:+12145550192">(214) 555-0192</a>.
            </p>

            <p>
                If your pet is experiencing a medical emergency, contact your
                veterinarian or the nearest emergency veterinary hospital.
            </p>
        </div>
    </section>
    <section class="mt-5 pt-4 border-top" aria-label="Page navigation">
        <a class="btn btn-outline-secondary"
           href="@Url.Action("Index", "Home")">
            &larr; Return to Home
        </a>
    </section>
</main>