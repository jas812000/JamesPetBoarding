
@model JamesPetBoarding.ViewModels.CustomerSearchVM
@{
    ViewBag.Title = "Search Customers";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Search Customers</h2>
    <p class="lead">
        Search by one or more fields to find an existing customer profile.
    </p>
</div>

@using (Html.BeginForm("Search", "Customers", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    <div class="col-md-4">
        <label class="form-label">First Name</label>
        @Html.TextBoxFor(x => x.FirstName, new { @class = "form-control" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Last Name</label>
        @Html.TextBoxFor(x => x.LastName, new { @class = "form-control" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Phone</label>
        @Html.TextBoxFor(x => x.Phone, new { @class = "form-control" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Email</label>
        @Html.TextBoxFor(x => x.Email, new { @class = "form-control" })
    </div>

    <div class="col-6">
        <label class="form-label">Active Status</label>
        @Html.DropDownListFor(
            x => x.IsActive,
            new List<SelectListItem>
            {
                new SelectListItem { Text = "All Customers", Value = "" },
                new SelectListItem { Text = "Active", Value = "true" },
                new SelectListItem { Text = "Inactive", Value = "false" }
            },
            new { @class = "form-select" })

        <small class="text-muted">Select All Customers, Active or Inactive.</small>
    </div>

    <div class="col-12 text-center mt-4">
        <button type="submit" class="btn btn-primary me-2">Search</button>

        @Html.ActionLink("Cancel", "Index", "Customers", null, new { @class = "btn btn-secondary ms-2" })
    </div>

}

@if (Model.Customers != null && Model.Customers.Any())
{
    <h4 class="mt-4">
        Results Found: @Model.Customers.Count
    </h4>

    <div class="mt-3">

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Customer Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Active Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var customer in Model.Customers)
                {
                    <tr>
                        <td>@customer.CustomerNameDisplay</td>
                        <td>@customer.PhoneDisplay</td>
                        <td>@customer.EmailDisplay</td>
      
                        <td>
                            @if (customer.IsActive)
                            { 
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>

                        <td>
                            @Html.ActionLink(
                               "View",
                               "Read",
                               "Customers",
                               new { customerId = customer.CustomerId },
                               new { @class = "btn btn-primary btn-sm me-1" })

                            @Html.ActionLink(
                               "Update",
                               "Update",
                               "Customers",
                               new { customerId = customer.CustomerId },
                               new { @class = "btn btn-warning btn-sm me-1" })

                            @if (customer.IsActive)
                            {
                                @Html.ActionLink(
                                "Deactivate",
                                "Delete",
                                "Customers",
                                new { customerId = customer.CustomerId },
                                new { @class = "btn btn-danger btn-sm" })
                            }
                            else
                            {
                                @Html.ActionLink(
                                   "Reactivate",
                                   "Reactivate",
                                   "Customers",
                                   new { customerId = customer.CustomerId },
                                   new { @class = "btn btn-success btn-sm" })
                            }

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.Customers != null && !Model.Customers.Any())
{
    <div class="alert alert-info mt-4">
        No customers matched the search criteria.
    </div>
}




