@model JamesPetBoarding.ViewModels.CustomerReactivateVM
@{
    ViewBag.Title = "Reactivate Customer";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Reactivate Customer Profile</h2>
    <p class="lead">
        Review customer information and reactivate the customer's profile.
    </p>
</div>


@using (Html.BeginForm("Reactivate", "Customers", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    @Html.HiddenFor(x => x.CustomerId)

    <div class="col-md-6">
        <label class="form-label">Customer ID</label>
        @Html.TextBoxFor(x => x.CustomerId, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Customer Name</label>
        @Html.TextBoxFor(x => x.CustomerNameDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-12">
        <label class="form-label">Address</label>
        @Html.TextBoxFor(x => x.AddressDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-6">
        <label class="form-label">City, State, Zip Code</label>
        @Html.TextBoxFor(x => x.CityStateZipDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Phone</label>
        @Html.TextBoxFor(x => x.PhoneDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Email</label>
        @Html.TextBoxFor(x => x.EmailDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-8">
        <label class="form-label">Notes</label>
        @Html.TextAreaFor(x => x.NotesDisplay, new { @class = "form-control", rows = "3", @readonly = "readonly" })
    </div>

    <div class="col-md-8">
        <h4>Deactivation History</h4>
    </div>

    <div class="col-md-4">
        <label class="form-label">Inactive Reason</label>
        @Html.TextBoxFor(x => x.InactiveReasonDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Inactivated Date</label>
        @Html.TextBoxFor(x => x.InactivatedDateDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-8">
        <label class="form-label">Inactive Notes</label>
        @Html.TextAreaFor(x => x.InactiveNotesDisplay, new { @class = "form-control", rows = "3", @readonly = "readonly" })
    </div>

    <div class="col-md-8">
        <div class="alert alert-success">
            This action will reactivate the customer's profile and restore access to future services and bookings.
        </div>
    </div>

    <div class="col-md-8">
        <label class="form-label">Reactivated Notes</label>
        @Html.TextAreaFor(x => x.ReactivatedNotes, new { @class = "form-control", rows = "3", placeholder = "Enter reactivation notes" })
        @Html.ValidationMessageFor(x => x.ReactivatedNotes, "", new { @class = "text-danger" })
    </div>

    <div class="col-12 text-center mt-4">
        <button type="submit" class="btn btn-success me-2">Reactivate</button>

        @Html.ActionLink("Cancel", "Read", "Customers",
            new { customerId = Model.CustomerId },
            new { @class = "btn btn-secondary ms-2" }
        )
    </div>
}
