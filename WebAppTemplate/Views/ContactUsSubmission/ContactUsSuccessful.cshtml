
@{
    ViewBag.Title = "Thank You";
}

<h2>Thank you for contacting Paws & Reservations.</h2>

<p>
    We have received your message and a member of our team will reach out to you in 1-2 business days.
</p>

<p>
    If your matter is urgent, please call us directly at (214) 555-0192.

    You will be redirected to the Home Page in 5 seconds...
</p>

<p>
    @Html.ActionLink(
        "Return to Home", 
        "Index", 
        "Home", 
        null, 
        new { @class = "btn btn-primary" })
