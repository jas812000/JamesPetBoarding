
@model JamesPetBoarding.ViewModels.ContactUsSubmissionVM

@{
    ViewBag.Title = "ContactUs";
}

<h1>Get In Touch</h1>

<p>We understand your pets are part of your family. If you have questions, concerns,
    or would like additional information about our boarding and pet services, please
    complete the form below and a member of our team will be happy to assist you.
</p>

@using (Html.BeginForm("Index", "ContactUsSubmission", FormMethod.Post))
{

    if (!ViewData.ModelState.IsValid) 
    {
        @Html.ValidationSummary(
            false,
            "Please correct the following errors before submitting the form:",
            new { @class = "text-danger" }
        )
    }

    <div class="mb-3">
        <label for="FormControlInputLastName" class="form-label">Last Name</label>
        @Html.TextBoxFor(x => x.LastName, new { @class = "form-control", placeholder = "Doe" })
        <div class="text-danger mb-2">
            @Html.ValidationMessageFor(x => x.LastName)
        </div>

        <label for="FormControlInputFirstName" class="form-label">First Name</label>
        @Html.TextBoxFor(x => x.FirstName, new { @class = "form-control", placeholder = "John" })
        <div class="text-danger mb-2">
            @Html.ValidationMessageFor(x => x.FirstName)
        </div>

        <label for="FormControlInputPhone" class="form-label">Phone Number</label>
        @Html.TextBoxFor(x => x.Phone, new { @class = "form-control", placeholder = "410-555-1212" })
        <div class="text-danger mb-2">
            @Html.ValidationMessageFor(x => x.Phone)
        </div>

        <label for="FormControlInputEmail" class="form-label">Email Address</label>
        @Html.TextBoxFor(x => x.Email, new { @class = "form-control", placeholder = "jdoe@example.com", type = "email" })
        <div class="text-danger mb-2">
            @Html.ValidationMessageFor(x => x.Email)
        </div>
    </div>
    <div class="mb-3">
        <label for="FormControlMessage" class="form-label">Message</label>
        @Html.TextAreaFor(x => x.Message, 5, 50, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.Message, "", new { @class = "text-danger" })
    </div>
    <button type="Submit" class="btn btn-primary">Submit</button>
}



