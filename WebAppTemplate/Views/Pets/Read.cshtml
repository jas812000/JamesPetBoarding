@model JamesPetBoarding.ViewModels.PetDetailsVM
@{
    ViewBag.Title = "Read Pet";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>View Pet Profile</h2>
    <p class="lead">
        View pet information and status.
    </p>
</div>

<div class="row g-3 justify-content-center">

    <div class="col-md-4">
        <label class="form-label">Pet ID</label>
        @Html.TextBoxFor(x => x.PetId, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Pet Name</label>
        @Html.TextBoxFor(x => x.PetNameDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Active Status</label>
        @Html.TextBoxFor(x => x.ActiveStatusDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Veterinarian ID</label>
        @Html.TextBoxFor(x => x.VetId, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Veterinarian Name</label>
        @Html.TextBoxFor(x => x.VeterinarianDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-2">
        <label class="form-label">Species</label>
        @Html.TextBoxFor(x => x.SpeciesDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Breed</label>
        @Html.TextBoxFor(x => x.BreedDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-2">
        <label class="form-label">Sex</label>
        @Html.TextBoxFor(x => x.SexDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Birth Date</label>
        @Html.TextBoxFor(x => x.BirthDateDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-2">
        <label class="form-label">Age</label>
        @Html.TextBoxFor(x => x.AgeDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Weight</label>
        @Html.TextBoxFor(x => x.WeightDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-12">
        <label class="form-label">Notes</label>
        @Html.TextAreaFor(x => x.NotesDisplay, new { @class = "form-control", rows = "3", @readonly = "readonly" })
    </div>

    @if (!Model.IsActive)
    {
        <div class="col-12">
            <h4 class="mt-4">Deactivation Information</h4>
        </div>

        <div class="col-md-4">
            <label class="form-label">Inactive Reason</label>
            @Html.TextBoxFor(x => x.InactiveReasonDisplay, new { @class = "form-control", @readonly = "readonly" })
        </div>

        <div class="col-md-4">
            <label class="form-label">Inactivated Date</label>
            @Html.TextBoxFor(x => x.InactivatedDateDisplay, new { @class = "form-control", @readonly = "readonly" })
        </div>

        <div class="col-md-8">
            <label class="form-label">Inactive Notes</label>
            @Html.TextAreaFor(x => x.InactiveNotesDisplay, new { @class = "form-control", rows = "3", @readonly = "readonly" })
        </div>
    }

    @if (Model.ReactivatedDateDisplay != "Not Applicable")
    {
        <div class="col-12">
            <h4 class="mt-4">Reactivation Information</h4>
        </div>

        <div class="col-md-4">
            <label class="form-label">Reactivated Date</label>
            @Html.TextBoxFor(x => x.ReactivatedDateDisplay, new { @class = "form-control", @readonly = "readonly" })
        </div>

        <div class="col-md-8">
            <label class="form-label">Reactivated Notes</label>
            @Html.TextAreaFor(x => x.ReactivatedNotesDisplay, new { @class = "form-control", rows = "3", @readonly = "readonly" })
        </div>
    }

    <div class="col-md-10 mt-4">
        <h4>Diets</h4>

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th scope="col">Food Name</th>
                    <th scope="col">Amount</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Diets.Any())
                {
                    foreach (var diet in Model.Diets)
                    {
                        <tr>

                            <td>@diet.FoodName</td>
                            <td>@diet.Amount</td>
                            <td>
                                @Html.ActionLink(
                                     "Read",
                                     "Read",
                                     "Diets",
                                     new { dietId = diet.DietId },
                                     new { @class = "btn btn-primary btn-sm me-2" })

                                @Html.ActionLink(
                                    "Update",
                                    "Update",
                                    "Diets",
                                    new { dietId = diet.DietId },
                                    new { @class = "btn btn-primary btn-sm me-2" })

                                @Html.ActionLink(
                                    "Delete",
                                    "Delete",
                                    "Diets",
                                    new { dietId = diet.DietId },
                                    new { @class = "btn btn-danger btn-sm me-2" })

                            </td>
                        </tr>
                    }

                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center">
                            No diets found.
                        </td>
                    </tr>
                }

            </tbody>
        </table>

    </div>

    <div class="col-md-10 text-center mt-3">
        @Html.ActionLink(
            "Create Diet",
            "Create",
            "Diets",
            new { petId = Model.PetId },
            new { @class = "btn btn-success" })
    </div>

    <div class="col-md-10 mt-4">
        <h4>Medications</h4>

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th scope="col">Medication Name</th>
                    <th scope="col">Dosage</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Medications.Any())
                {
                    foreach (var medication in Model.Medications)
                    {
                        <tr>

                            <td>@medication.MedicationName</td>
                            <td>@medication.Dosage</td>
                            <td>
                                @Html.ActionLink(
                                    "Read",
                                    "Read",
                                    "Medications",
                                    new { medicationId = medication.MedicationId },
                                     new { @class = "btn btn-primary btn-sm me-2" })

                                @Html.ActionLink(
                                    "Update",
                                    "Update",
                                    "Medications",
                                    new { medicationId = medication.MedicationId },
                                    new { @class = "btn btn-primary btn-sm me-2" })

                                @Html.ActionLink(
                                    "Delete",
                                    "Delete",
                                    "Medications",
                                    new { medicationId = medication.MedicationId },
                                    new { @class = "btn btn-danger btn-sm me-2" })

                            </td>
                        </tr>
                    }

                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center">
                            No medications found.
                        </td>
                    </tr>
                }

            </tbody>
        </table>

    </div>

    <div class="col-md-10 text-center mt-3">
        @Html.ActionLink(
            "Create Medication",
            "Create",
            "Medications",
            new { petId = Model.PetId },
            new { @class = "btn btn-success" })
    </div>

    <div class="col-md-10 mt-4">
        <h4>Vaccines</h4>

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th scope="col">Vaccine Name</th>
                    <th scope="col">Date Given</th>
                    <th scope="col">Expiration Date</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.PetVaccines.Any())
                {
                    foreach (var petVaccine in Model.PetVaccines)
                    {
                        <tr>

                            <td>@petVaccine.VaccineNameDisplay</td>
                            <td>@petVaccine.DateGivenDisplay</td>
                            <td>@petVaccine.ExpirationDateDisplay</td>
                            <td>
                                @Html.ActionLink(
                                     "Read",
                                     "Read",
                                     "PetVaccines",
                                     new { petVaccineId = petVaccine.PetVaccineId },
                                     new { @class = "btn btn-primary btn-sm me-2" })

                                @Html.ActionLink(
                                    "Update",
                                    "Update",
                                    "PetVaccines",
                                    new { petVaccineId = petVaccine.PetVaccineId },
                                    new { @class = "btn btn-primary btn-sm me-2" })

                                @Html.ActionLink(
                                    "Delete",
                                    "Delete",
                                    "PetVaccines",
                                    new { petVaccineId = petVaccine.PetVaccineId },
                                    new { @class = "btn btn-danger btn-sm me-2" })

                            </td>
                        </tr>
                    }

                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center">
                            No vaccine records found.
                        </td>
                    </tr>
                }

            </tbody>
        </table>

    </div>

    <div class="col-md-10 text-center mt-3">
        @Html.ActionLink(
            "Create Pet Vaccine",
            "Create",
            "PetVaccines",
            new { petId = Model.PetId },
            new { @class = "btn btn-success" })
    </div>

    <div class="col-md-10 text-center mt-4">
        @Html.ActionLink(
            "Update Pet",
            "Update",
            "Pets",
            new { petId = Model.PetId },
            new { @class = "btn btn-primary me-2" })

        @if (Model.IsActive)
        {
            @Html.ActionLink(
                "Deactivate Pet",
                "Delete",
                "Pets",
                new { petId = Model.PetId },
                new { @class = "btn btn-danger me-2" })
        }
        else
        {
            @Html.ActionLink(
                "Reactivate Pet",
                "Reactivate",
                "Pets",
                new { petId = Model.PetId },
                new { @class = "btn btn-success me-2" })
        }

        @Html.ActionLink(
            "Back to Pet Search",
            "Search",
            "Pets",
            null,
            new { @class = "btn btn-secondary ms-2" })

    </div>

</div>















