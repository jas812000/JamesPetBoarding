@model JamesPetBoarding.ViewModels.PetReactivateVM
@{
    ViewBag.Title = "Reactivate Pet";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Reactivate Pet Profile</h2>
    <p class="lead">
        Review pet information and reactivate the pet's profile.
    </p>
</div>

@using (Html.BeginForm("Reactivate", "Pets", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    @Html.HiddenFor(x => x.PetId)

    <div class="col-md-4">
        <label class="form-label">Pet ID</label>
        @Html.TextBoxFor(x => x.PetId, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Pet Name</label>
        @Html.TextBoxFor(x => x.PetNameDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-2">
        <label class="form-label">Species</label>
        @Html.TextBoxFor(x => x.SpeciesDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-2">
        <label class="form-label">Sex</label>
        @Html.TextBoxFor(x => x.SexDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-3">
        <label class="form-label">Breed</label>
        @Html.TextBoxFor(x => x.BreedDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-3">
        <label class="form-label">Birth Date</label>
        @Html.TextBoxFor(x => x.BirthDateDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-3">
        <label class="form-label">Age</label>
        @Html.TextBoxFor(x => x.AgeDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-3">
        <label class="form-label">Active Status</label>
        @Html.TextBoxFor(x => x.ActiveStatusDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-12">
        <label class="form-label">Notes</label>
        @Html.TextAreaFor(x => x.NotesDisplay, new { @class = "form-control", rows = "4", @readonly = "readonly" })
    </div>

    <div class="col-12">
        <h4>Deactivation History</h4>
    </div>

    <div class="col-md-4">
        <label class="form-label">Inactivation Reason</label>
        @Html.TextBoxFor(x => x.InactivationReasonDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Inactivation Date</label>
        @Html.TextBoxFor(x => x.InactivationDateDisplay, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="col-md-8">
        <label class="form-label">Inactivation Notes</label>
        @Html.TextAreaFor(x => x.InactivationNotesDisplay, new { @class = "form-control", rows = "3", @readonly = "readonly" })
    </div>

    <div class="col-md-8">
        <div class="alert alert-success">
            This action will reactivate the pet's profile and restore access to future services and boardings.
        </div>
    </div>

    <div class="col-md-8">
        <label class="form-label">Reactivation Notes</label>
        @Html.TextAreaFor(x => x.ReactivationNotes, new { @class = "form-control", rows = "3", placeholder = "Enter reactivation notes" })
        @Html.ValidationMessageFor(x => x.ReactivationNotes, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-12 text-center mt-4">
        <button type="submit" class="btn btn-success me-2">Reactivate Pet Profile</button>

        @Html.ActionLink(
            "Cancel", 
            "Read", 
            "Pets",
            new { petId = Model.PetId },
            new { @class = "btn btn-secondary ms-2" }
        )
    </div>
}