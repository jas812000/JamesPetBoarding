@model JamesPetBoarding.ViewModels.EmployeeFormVM
@{
    ViewBag.Title = "Create Employee";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Create Employee Profile</h2>
    <p class="lead">
        Enter employee information to create a new employee profile.
    </p>
</div>


@using (Html.BeginForm("Create", "Employees", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })


    <div class="col-md-4">
        <label class="form-label">Last Name</label>
        @Html.TextBoxFor(x => x.LastName, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.LastName, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-4">
        <label class="form-label">First Name</label>
        @Html.TextBoxFor(x => x.FirstName, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.FirstName, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Role</label>
        @Html.EnumDropDownListFor(x => x.Role, "Select...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.Role, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Email Address</label>
        @Html.TextBoxFor(x => x.Email, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.Email, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Phone Number</label>
        @Html.TextBoxFor(x => x.Phone, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.Phone, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-12">
        <label class="form-label">Notes</label>
        @Html.TextAreaFor(x => x.Notes, new { @class = "form-control", rows = "4", placeholder = "Enter notes" })
        @Html.ValidationMessageFor(x => x.Notes, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-12 text-center mt-4">
        <button type="submit" class="btn btn-primary me-2">Create Employee Profile</button>

        @Html.ActionLink(
            "Cancel",
            "Search",
            "Employees",
            null,
            new { @class = "btn btn-secondary ms-2" })
    </div>

}
