@model JamesPetBoarding.ViewModels.EmployeeProfileUpdateVM
@{
    ViewBag.Title = "Update My Profile";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Update My Profile</h2>
    <p class="lead">
        Update My profile information.
    </p>
</div>

@using (Html.BeginForm("UpdateMyProfile", "Employees", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    @Html.HiddenFor(x => x.EmployeeId)


    <div class="col-md-6">
        <label class="form-label">Email Address</label>
        @Html.TextBoxFor(x => x.Email, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.Email, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Phone Number</label>
        @Html.TextBoxFor(x => x.Phone, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.Phone, "", new { @class = "text-danger" })
    </div>

    <div class="col-12 text-center mt-4">
        <button type="submit" class="btn btn-success me-2">Update My Profile</button>

        @Html.ActionLink(
             "Cancel",
             "MyProfile",
             "Employees",
             null,
             new { @class = "btn btn-secondary ms-2" })
    </div>
}
