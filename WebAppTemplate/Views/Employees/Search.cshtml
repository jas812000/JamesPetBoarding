@model JamesPetBoarding.ViewModels.EmployeeSearchVM
@{
    ViewBag.Title = "Search Employees";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Search Employees</h2>
    <p class="lead">
        Search by one or more fields to find an existing employee profile.
    </p>
</div>

@using (Html.BeginForm("Search", "Employees", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    <div class="col-md-4">
        <label class="form-label">First Name</label>
        @Html.TextBoxFor(x => x.FirstName, new { @class = "form-control" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Last Name</label>
        @Html.TextBoxFor(x => x.LastName, new { @class = "form-control" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Email Address</label>
        @Html.TextBoxFor(x => x.Email, new { @class = "form-control" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Phone Number</label>
        @Html.TextBoxFor(x => x.Phone, new { @class = "form-control" })
    </div>

    <div class="col-md-2">
        <label class="form-label">Role</label>
        @Html.EnumDropDownListFor(x => x.Role, "Select...", new { @class = "form-select" })
    </div>

    <div class="col-6">
        <label class="form-label">Active Status</label>
        @Html.DropDownListFor(
             x => x.IsActive,
             new List<SelectListItem>
             {
                new SelectListItem { Text = "All Employees", Value = "" },
                new SelectListItem { Text = "Active", Value = "true" },
                new SelectListItem { Text = "Inactive", Value = "false" }
             },
             new { @class = "form-select" })

        <small class="text-muted">Select All Employees, Active or Inactive.</small>
    </div>

    <div class="col-12 text-center mt-4">
        <button type="submit" class="btn btn-primary me-2">Search Employees</button>

        @if (ViewBag.CanManageEmployees)
        {
            @Html.ActionLink(
                "Create Employee",
                "Create",
                "Employees",
                null,
                new { @class = "btn btn-success ms-2" })
        }
    </div>
}

@if (Model.EmployeeSearchResults != null && Model.EmployeeSearchResults.Any())
{
    <h4 class="mt-4">
        Results Found: @Model.EmployeeSearchResults.Count
    </h4>

    <div class="mt-3">

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Employee Name</th>
                    <th>Role</th>
                    <th>Email Address</th>
                    <th>Phone Number</th>
                    <th>Active Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var employee in Model.EmployeeSearchResults)
                {
                    <tr>
                        <td>@employee.EmployeeNameDisplay</td>
                        <td>@employee.RoleDisplay</td>
                        <td>@employee.EmailDisplay</td>
                        <td>@employee.PhoneDisplay</td>
                        <td>@employee.ActiveStatusDisplay</td>

                        <td>
                            @Html.ActionLink(
                                 "View",
                                 "Read",
                                 "Employees",
                                 new { employeeId = employee.EmployeeId },
                                 new { @class = "btn btn-primary btn-sm me-1" })

                            @if (ViewBag.CanManageEmployees)
                            {
                                @Html.ActionLink(
                                     "Update",
                                     "Update",
                                     "Employees",
                                     new { employeeId = employee.EmployeeId },
                                     new { @class = "btn btn-warning btn-sm me-1" })

                                @if (employee.IsActive)
                                {
                                    @Html.ActionLink(
                                         "Deactivate",
                                         "Delete",
                                         "Employees",
                                         new { employeeId = employee.EmployeeId },
                                         new { @class = "btn btn-danger btn-sm" })
                                }
                                else
                                {
                                    @Html.ActionLink(
                                         "Reactivate",
                                         "Reactivate",
                                         "Employees",
                                         new { employeeId = employee.EmployeeId },
                                         new { @class = "btn btn-success btn-sm" })
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Request.HttpMethod == "POST" && 
    Model.EmployeeSearchResults != null && 
    !Model.EmployeeSearchResults.Any())
{
    <div class="alert alert-info mt-4">
        No employee matched the search criteria.
    </div>
}