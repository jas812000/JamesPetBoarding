@model JamesPetBoarding.ViewModels.SpeciesReportVM

@{
    ViewBag.Title = "Species Report";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Species Report</h2>
    <p class="lead">
        Enter one or more optional filters to generate a species report.
    </p>
</div>

@using (Html.BeginForm("SpeciesReport", "Reports", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })


    <div class="col-md-6">
        <label class="form-label">Species</label>
        @Html.EnumDropDownListFor(x => x.SpeciesReportFilter.Species, "Select...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.SpeciesReportFilter.Species, "", new { @class = "text-danger" })
    </div>


    <div class="col-md-6">
        <label class="form-label">Active Status</label>
        @Html.EnumDropDownListFor(x => x.SpeciesReportFilter.ActiveStatus, "Select...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.SpeciesReportFilter.ActiveStatus, "", new { @class = "text-danger" })
    </div>


    <div class="col-md-8 text-center mt-4">
        <button type="submit" class="btn btn-primary me-2">Generate Report</button>

        @Html.ActionLink(
             "Back to Reports",
             "Index",
             "Reports",
             null,
             new { @class = "btn btn-secondary ms-2" })
    </div>
}


@if (Request.HttpMethod == "POST" && ViewData.ModelState.IsValid)
{
    <hr class="my-5" />

    <div class="text-center mb-4">
        <h3>Report Summary</h3>
    </div>

    <div class="row g-3 justify-content-center mb-4">

        <div class="col-md-3">
            <div class="border rounded p-3 text-center">
                <h5>Total Pets</h5>
                <p class="fs-4 mb-0">@Model.TotalPetCount</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="border rounded p-3 text-center">
                <h5>Active Pets</h5>
                <p class="fs-4 mb-0">@Model.ActivePetCount</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="border rounded p-3 text-center">
                <h5>Inactive Pets</h5>
                <p class="fs-4 mb-0">@Model.InactivePetCount</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="border rounded p-3 text-center">
                <h5>Current Boarders</h5>
                <p class="fs-4 mb-0">@Model.CurrentBoarderCount</p>
            </div>
        </div>

    </div>

    if (Model.SpeciesReportRows != null && Model.SpeciesReportRows.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Species</th>
                        <th>Total Pets</th>
                        <th>Active Pets</th>
                        <th>Inactive Pets</th>
                        <th>Current Boarders</th>
                        <th>Total Boardings</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (JamesPetBoarding.ViewModels.SpeciesReportRowVM species in Model.SpeciesReportRows)
                    {
                        <tr>
                            <td>@species.SpeciesDisplay</td>

                            <td>@species.TotalPetCount</td>

                            <td>@species.ActivePetCount</td>

                            <td>@species.InactivePetCount</td>

                            <td>@species.CurrentBoarderCount</td>

                            <td>@species.TotalBoardingCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            No pets matched the selected species report filters.
        </div>
    }
}
