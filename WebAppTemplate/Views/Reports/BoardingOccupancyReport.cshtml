@model JamesPetBoarding.ViewModels.BoardingOccupancyReportVM
@{
    ViewBag.Title = "Boarding Occupancy Report";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Boarding Occupancy Report</h2>
    <p class="lead">
        Enter one or more optional filters to generate a boarding occupancy report.
    </p>
</div>


@using (Html.BeginForm("BoardingOccupancyReport", "Reports", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })


    <div class="col-md-6">
        <label class="form-label">Report Date</label>
        @Html.TextBoxFor(x => x.BoardingOccupancyReportFilter.ReportDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
        @Html.ValidationMessageFor(x => x.BoardingOccupancyReportFilter.ReportDate, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Unit Type</label>
        @Html.EnumDropDownListFor(x => x.BoardingOccupancyReportFilter.UnitType, "Select...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.BoardingOccupancyReportFilter.UnitType, "", new { @class = "text-danger" })
    </div>


    <div class="col-md-6">
        <label class="form-label">Species Allowed</label>
        @Html.EnumDropDownListFor(x => x.BoardingOccupancyReportFilter.SpeciesAllowed, "Select...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.BoardingOccupancyReportFilter.SpeciesAllowed, "", new { @class = "text-danger" })
    </div>


    <div class="col-md-6">
        <label class="form-label">Size Category</label>
        @Html.EnumDropDownListFor(x => x.BoardingOccupancyReportFilter.SizeCategory, "Select...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.BoardingOccupancyReportFilter.SizeCategory, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-8 text-center mt-4">
        <button type="submit" class="btn btn-primary me-2">Generate Report</button>

        @Html.ActionLink(
             "Back to Reports",
             "Index",
             "Reports",
             null,
             new { @class = "btn btn-secondary ms-2" })
    </div>
}


@if (Model.BoardingOccupancyReportRows != null && Model.BoardingOccupancyReportRows.Any())
{
    <div class="border rounded p-4 mt-5 mb-4">
        <h3 class="text-center mb-4">Boarding Occupancy Summary</h3>

        <div class="row text-center justify-content-center">
            <div class="col-md-3 mb-3">
                <strong>Total Units</strong>
                <div>@Model.TotalUnitCount</div>
            </div>

            <div class="col-md-3 mb-3">
                <strong>Occupied Units</strong>
                <div>@Model.OccupiedUnitCount</div>
            </div>

            <div class="col-md-3 mb-3">
                <strong>Available Units</strong>
                <div>@Model.AvailableUnitCount</div>
            </div>

            <div class="col-md-3 mb-3">
                <strong>Occupancy Percentage</strong>
                <div>@Model.OccupancyPercentage.ToString("0.00")%</div>
            </div>
        </div>
    </div>

    using (Html.BeginForm("ExportBoardingOccupancyReportPdf", "Reports", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(x => x.BoardingOccupancyReportFilter.ReportDate)
        @Html.HiddenFor(x => x.BoardingOccupancyReportFilter.UnitType)
        @Html.HiddenFor(x => x.BoardingOccupancyReportFilter.SpeciesAllowed)
        @Html.HiddenFor(x => x.BoardingOccupancyReportFilter.SizeCategory)

        <div class="text-center mb-4">
            <button type="submit" class="btn btn-success">
                Export PDF
            </button>
        </div>
    }

    <div class="table-responsive mt-4">
        <table class="table table-striped table-bordered align-middle">
            <thead>
                <tr>
                    <th>Unit Name</th>
                    <th>Unit Number</th>
                    <th>Unit Type</th>
                    <th>Species Allowed</th>
                    <th>Size Category</th>
                    <th>Occupancy Status</th>
                    <th>Pet</th>
                    <th>Customer</th>
                    <th>Check-In Date</th>
                    <th>Check-Out Date</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var boardingUnit in Model.BoardingOccupancyReportRows)
                {
                    <tr>
                        <td>@boardingUnit.UnitNameDisplay</td>
                        <td>@boardingUnit.UnitNumberDisplay</td>
                        <td>@boardingUnit.UnitTypeDisplay</td>
                        <td>@boardingUnit.SpeciesAllowedDisplay</td>
                        <td>@boardingUnit.SizeCategoryDisplay</td>
                        <td>@boardingUnit.OccupancyStatusDisplay</td>

                        <td>
                            @if (boardingUnit.PetId.HasValue)
                            {
                                @boardingUnit.PetNameDisplay
                            }
                            else
                            {
                                <span>N/A</span>
                            }
                        </td>

                        <td>
                            @if (boardingUnit.CustomerId.HasValue)
                            {
                                @boardingUnit.CustomerNameDisplay
                            }
                            else
                            {
                                <span>N/A</span>
                            }
                        </td>

                        <td>@boardingUnit.CheckInDateDisplay</td>
                        <td>@boardingUnit.CheckOutDateDisplay</td>

                        <td>
                            @if (boardingUnit.BoardingId.HasValue)
                            {
                                @Html.ActionLink(
                                    "View",
                                    "Read",
                                    "Boardings",
                                    new { boardingId = boardingUnit.BoardingId.Value },
                                    new { @class = "btn btn-sm btn-outline-primary" })
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (Model.HasSearched)
{
    <div class="alert alert-info text-center mt-4">
        No boarding units matched the selected report filters.
    </div>
}