@model JamesPetBoarding.ViewModels.PetReportVM

@{
    ViewBag.Title = "Pet Report";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Pet Report</h2>
    <p class="lead">
        Enter one or more optional filters to generate a pet report.
    </p>
</div>

@using (Html.BeginForm("PetReport", "Reports", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })


    <div class="col-md-6">
        <label class="form-label">Customer</label>
        @Html.DropDownListFor(x => x.PetReportFilter.CustomerId, Model.CustomerSelectList, "Select Customer...", new { @class = "form-select", id = "CustomerId" })
        @Html.ValidationMessageFor(x => x.PetReportFilter.CustomerId, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Pet</label>
        @Html.DropDownListFor(x => x.PetReportFilter.PetId, Model.PetSelectList, "Select Pet...", new { @class = "form-select", id = "PetId" })
        @Html.ValidationMessageFor(x => x.PetReportFilter.PetId, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Veterinarian</label>
        @Html.DropDownListFor(x => x.PetReportFilter.VetId, Model.VeterinarianSelectList, "Select Veterinarian...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.PetReportFilter.VetId, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Active Status</label>
        @Html.EnumDropDownListFor(x => x.PetReportFilter.ActiveStatus, "Select...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.PetReportFilter.ActiveStatus, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Pet Name Search</label>
        @Html.TextBoxFor(x => x.PetReportFilter.PetName, new { @class = "form-control", placeholder = "Roxy" })
        @Html.ValidationMessageFor(x => x.PetReportFilter.PetName, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Species</label>
        @Html.EnumDropDownListFor(x => x.PetReportFilter.Species, "Select...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.PetReportFilter.Species, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Breed</label>
        @Html.TextBoxFor(x => x.PetReportFilter.Breed, new { @class = "form-control", placeholder = "Shih Tzu" })
        @Html.ValidationMessageFor(x => x.PetReportFilter.Breed, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Sex</label>
        @Html.EnumDropDownListFor(x => x.PetReportFilter.Sex, "Select...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.PetReportFilter.Sex, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Birth Date</label>
        @Html.TextBoxFor(x => x.PetReportFilter.BirthDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
        @Html.ValidationMessageFor(x => x.PetReportFilter.BirthDate, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Weight Unit</label>
        @Html.EnumDropDownListFor(x => x.PetReportFilter.WeightUnit, new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.PetReportFilter.WeightUnit, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-8 text-center mt-4">
        <button type="submit" class="btn btn-primary me-2">Generate Report</button>

        @Html.ActionLink(
             "Cancel",
             "Index",
             "Reports",
             null,
             new { @class = "btn btn-secondary ms-2" })
    </div>
}

@if (Request.HttpMethod == "POST" && ViewData.ModelState.IsValid)
{
    <hr class="my-5" />

    <div class="text-center mb-4">
        <h3>Report Summary</h3>
    </div>

    <div class="row g-3 justify-content-center mb-4">

        <div class="col-md-4">
            <div class="border rounded p-3 text-center">
                <h5>Total Pets</h5>
                <p class="fs-4 mb-0">@Model.TotalCount</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="border rounded p-3 text-center">
                <h5>Active Pets</h5>
                <p class="fs-4 mb-0">@Model.ActiveCount</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="border rounded p-3 text-center">
                <h5>Inactive Pets</h5>
                <p class="fs-4 mb-0">@Model.InactiveCount</p>
            </div>
        </div>

    </div>

    if (Model.PetReportRows != null && Model.PetReportRows.Count > 0)
    {

        using (Html.BeginForm("ExportPetReportPdf", "Reports", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(x => x.PetReportFilter.CustomerId)
            @Html.HiddenFor(x => x.PetReportFilter.PetId)
            @Html.HiddenFor(x => x.PetReportFilter.VetId)
            @Html.HiddenFor(x => x.PetReportFilter.ActiveStatus)
            @Html.HiddenFor(x => x.PetReportFilter.PetName)
            @Html.HiddenFor(x => x.PetReportFilter.Species)
            @Html.HiddenFor(x => x.PetReportFilter.Breed)
            @Html.HiddenFor(x => x.PetReportFilter.Sex)
            @Html.HiddenFor(x => x.PetReportFilter.BirthDate)
            @Html.HiddenFor(x => x.PetReportFilter.WeightUnit)

            <div class="text-center mb-4">
                <button type="submit" class="btn btn-success">
                    Export PDF
                </button>
            </div> 
        }

        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Pet</th>
                        <th>Status</th>
                        <th>Customer</th>
                        <th>Veterinarian</th>
                        <th>Species</th>
                        <th>Breed</th>
                        <th>Sex</th>
                        <th>Birth Date</th>
                        <th>Age</th>
                        <th>Weight</th>
                        <th>Notes</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (JamesPetBoarding.ViewModels.PetReportRowVM pet in Model.PetReportRows)
                    {
                        <tr>
                            <td>@pet.PetNameDisplay</td>

                            <td>@pet.ActiveStatusDisplay</td>

                            <td>@pet.CustomerNameDisplay</td>

                            <td>@pet.VeterinarianNameDisplay</td>

                            <td>@pet.SpeciesDisplay</td>

                            <td>@pet.BreedDisplay</td>

                            <td>@pet.SexDisplay</td>

                            <td>@pet.BirthDateDisplay</td>

                            <td>@pet.AgeDisplay</td>

                            <td>@pet.WeightDisplay</td>

                            <td>@pet.NotesDisplay</td>

                            <td>
                                @Html.ActionLink(
                                    "View Pet",
                                    "Read",
                                    "Pets",
                                    new { petId = pet.PetId },
                                    new { @class = "btn btn-sm btn-primary" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
        No pets matched the selected report filters.
        </div>
    }
}

@section Scripts
{
    <script>
        $(document).ready(function () {

            $("#CustomerId").change(function () {

                var customerId = $(this).val();

                if (customerId) {

                    $.getJSON(
                        '@Url.Action("GetPetsByCustomer", "Reports")',
                        { customerId: customerId },
                        function (pets) {

                            var petDropdown = $("#PetId");

                            petDropdown.empty();
                            petDropdown.append(
                                $("<option>").val("").text("Select Pet...")
                            );

                            $.each(pets, function (index, pet) {
                                petDropdown.append(
                                    $("<option>").val(pet.Value).text(pet.Text)
                                );
                            });
                        }
                    );
                }
                else {

                    $.getJSON(
                        '@Url.Action("GetAllPets", "Reports")',
                        function (pets) {

                            var petDropdown = $("#PetId");

                            petDropdown.empty();
                            petDropdown.append(
                                $("<option>").val("").text("Select Pet...")
                            );

                            $.each(pets, function (index, pet) {
                                petDropdown.append(
                                    $("<option>").val(pet.Value).text(pet.Text)
                                );
                            });
                        }
                    );
                }
            });


            $("#PetId").change(function () {

                var petId = $(this).val();

                if (petId) {

                    $.getJSON(
                        '@Url.Action("GetCustomersByPet", "Reports")',
                        { petId: petId },
                        function (customers) {

                            var customerDropdown = $("#CustomerId");

                            customerDropdown.empty();
                            customerDropdown.append(
                                $("<option>").val("").text("Select Customer...")
                            );

                            $.each(customers, function (index, customer) {
                                customerDropdown.append(
                                    $("<option>").val(customer.Value).text(customer.Text)
                                );
                            });
                        }
                    );
                }
                else {

                    $.getJSON(
                        '@Url.Action("GetAllCustomers", "Reports")',
                        function (customers) {

                            var customerDropdown = $("#CustomerId");

                            customerDropdown.empty();
                            customerDropdown.append(
                                $("<option>").val("").text("Select Customer...")
                            );

                            $.each(customers, function (index, customer) {
                                customerDropdown.append(
                                    $("<option>").val(customer.Value).text(customer.Text)
                                );
                            });
                        }
                    );
                }
            });

        });
    </script>
}