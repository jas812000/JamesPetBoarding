@model JamesPetBoarding.ViewModels.OutstandingBalanceReportVM
@{
    ViewBag.Title = "Outstanding Balance Report";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Outstanding Balance Report</h2>
    <p class="lead">
        Enter one or more optional filters to generate an outstanding balance report.
    </p>
</div>


@using (Html.BeginForm("OutstandingBalanceReport", "Reports", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })


    <div class="col-md-6">
        <label class="form-label">Invoice Start Date</label>
        @Html.TextBoxFor(x => x.OutstandingBalanceReportFilter.InvoiceStartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
        @Html.ValidationMessageFor(x => x.OutstandingBalanceReportFilter.InvoiceStartDate, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Invoice End Date</label>
        @Html.TextBoxFor(x => x.OutstandingBalanceReportFilter.InvoiceEndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
        @Html.ValidationMessageFor(x => x.OutstandingBalanceReportFilter.InvoiceEndDate, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Customer Name</label>
        @Html.DropDownListFor(x => x.OutstandingBalanceReportFilter.CustomerId, Model.CustomerSelectList, "Select Customer...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.OutstandingBalanceReportFilter.CustomerId, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Pet Name</label>
        @Html.DropDownListFor(x => x.OutstandingBalanceReportFilter.PetId, Model.PetSelectList, "Select Pet...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.OutstandingBalanceReportFilter.PetId, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Minimum Balance</label>
        @Html.TextBoxFor(x => x.OutstandingBalanceReportFilter.MinimumBalance, new { @class = "form-control", step = "0.01", min = "0", type = "number" })
        @Html.ValidationMessageFor(x => x.OutstandingBalanceReportFilter.MinimumBalance, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Invoice Status</label>
        @Html.EnumDropDownListFor(x => x.OutstandingBalanceReportFilter.InvoiceStatus, "Select...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.OutstandingBalanceReportFilter.InvoiceStatus, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-8 text-center mt-4">
        <button type="submit" class="btn btn-primary me-2">Generate Report</button>

        @Html.ActionLink(
             "Back to Reports",
             "Index",
             "Reports",
             null,
             new { @class = "btn btn-secondary ms-2" })
    </div>
}


@if (Model.OutstandingBalanceReportRows != null && Model.OutstandingBalanceReportRows.Any())
{
    <div class="border rounded p-4 mt-5 mb-4">
        <h3 class="text-center mb-4">Outstanding Balance Summary</h3>

        <div class="row text-center justify-content-center">
            <div class="col-md-4 mb-3">
                <strong>Invoice Count</strong>
                <div>@Model.InvoiceCount</div>
            </div>

            <div class="col-md-4 mb-3">
                <strong>Total Outstanding Balance</strong>
                <div>@Model.TotalOutstandingBalanceDisplay</div>
            </div>
        </div>
    </div>

    using (Html.BeginForm("ExportOutstandingBalanceReportPdf", "Reports", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(x => x.OutstandingBalanceReportFilter.InvoiceStartDate)
        @Html.HiddenFor(x => x.OutstandingBalanceReportFilter.InvoiceEndDate)
        @Html.HiddenFor(x => x.OutstandingBalanceReportFilter.CustomerId)
        @Html.HiddenFor(x => x.OutstandingBalanceReportFilter.PetId)
        @Html.HiddenFor(x => x.OutstandingBalanceReportFilter.MinimumBalance)
        @Html.HiddenFor(x => x.OutstandingBalanceReportFilter.InvoiceStatus)

        <div class="text-center mb-4">
            <button type="submit" class="btn btn-success">
                Export PDF
            </button>
        </div>
    }

    <div class="table-responsive mt-4">
        <table class="table table-striped table-bordered align-middle">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Pet</th>
                    <th>Invoice Date</th>
                    <th>Invoice Status</th>
                    <th>Total Amount</th>
                    <th>Amount Paid</th>
                    <th>Last Payment Date</th>
                    <th>Outstanding Balance</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var outstandingBalanceRow in Model.OutstandingBalanceReportRows)
                {
                    <tr>
                        <td>@outstandingBalanceRow.CustomerNameDisplay</td>
                        <td>@outstandingBalanceRow.PetNameDisplay</td>
                        <td>@outstandingBalanceRow.InvoiceDateTimeDisplay</td>
                        <td>@outstandingBalanceRow.InvoiceStatusDisplay</td>
                        <td>@outstandingBalanceRow.TotalAmountDisplay</td>
                        <td>@outstandingBalanceRow.AmountPaidDisplay</td>
                        <td>@outstandingBalanceRow.LastPaymentDateTimeDisplay</td>
                        <td>@outstandingBalanceRow.OutstandingBalanceDisplay</td>

                        <td>
                            @Html.ActionLink(
                                "View",
                                "Read",
                                "Invoices",
                                new { invoiceId = outstandingBalanceRow.InvoiceId },
                                new { @class = "btn btn-sm btn-outline-primary" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (Model.HasSearched)
{
    <div class="alert alert-info text-center mt-4">
        No outstanding balances matched the selected report filters.
    </div>
}