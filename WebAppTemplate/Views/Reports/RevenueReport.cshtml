@model JamesPetBoarding.ViewModels.RevenueReportVM

@{
    ViewBag.Title = "Revenue Report";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Revenue Report</h2>
    <p class="lead">
        Enter one or more optional filters to generate a revenue report.
    </p>
</div>

@using (Html.BeginForm("RevenueReport", "Reports", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })


    <div class="col-md-6">
        <label class="form-label">Invoice Start Date</label>
        @Html.TextBoxFor(x => x.RevenueReportFilter.InvoiceStartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
        @Html.ValidationMessageFor(x => x.RevenueReportFilter.InvoiceStartDate, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Invoice End Date</label>
        @Html.TextBoxFor(x => x.RevenueReportFilter.InvoiceEndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
        @Html.ValidationMessageFor(x => x.RevenueReportFilter.InvoiceEndDate, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Invoice Type</label>
        @Html.EnumDropDownListFor(x => x.RevenueReportFilter.InvoiceType, "Select...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.RevenueReportFilter.InvoiceType, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6">
        <label class="form-label">Invoice Status</label>
        @Html.EnumDropDownListFor(x => x.RevenueReportFilter.InvoiceStatus, "Select...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.RevenueReportFilter.InvoiceStatus, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-8 text-center mt-4">
        <button type="submit" class="btn btn-primary me-2">Generate Report</button>

        @Html.ActionLink(
             "Cancel",
             "Index",
             "Reports",
             null,
             new { @class = "btn btn-secondary ms-2" })
    </div>
}

@if (Model.RevenueReportRows != null && Model.RevenueReportRows.Any())
{
    <div class="border rounded p-4 mt-5 mb-4">
        <h3 class="text-center mb-4">Revenue Summary</h3>

        <div class="row text-center">
            <div class="col-md-3 mb-3">
                <strong>Total Invoice Count</strong>
                <div>@Model.TotalInvoiceCount</div>
            </div>

            <div class="col-md-3 mb-3">
                <strong>Total Invoiced</strong>
                <div>@Model.TotalInvoicedDisplay</div>
            </div>

            <div class="col-md-3 mb-3">
                <strong>Total Received</strong>
                <div>@Model.TotalReceivedDisplay</div>
            </div>

            <div class="col-md-3 mb-3">
                <strong>Total Outstanding</strong>
                <div>@Model.TotalOutstandingDisplay</div>
            </div>

            <div class="col-md-3 mb-3">
                <strong>Average Invoice Value</strong>
                <div>@Model.AverageInvoiceValueDisplay</div>
            </div>

            <div class="col-md-3 mb-3">
                <strong>Average Amount Received</strong>
                <div>@Model.AverageAmountReceivedDisplay</div>
            </div>

            <div class="col-md-3 mb-3">
                <strong>Total Voided Invoice Count</strong>
                <div>@Model.TotalVoidedInvoiceCount</div>
            </div>

            <div class="col-md-3 mb-3">
                <strong>Total Voided Amount</strong>
                <div>@Model.TotalVoidedAmountDisplay</div>
            </div>
        </div>
    </div>

    <div class="table-responsive mt-4">
        <table class="table table-striped table-bordered align-middle">
            <thead>
                <tr>
                    <th>Invoice Date</th>
                    <th>Invoice Type</th>
                    <th>Customer</th>
                    <th>Pet</th>
                    <th>Status</th>
                    <th>Subtotal</th>
                    <th>Tax</th>
                    <th>Discount</th>
                    <th>Total</th>
                    <th>Amount Paid</th>
                    <th>Balance</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var revenueReportRow in Model.RevenueReportRows)
                {
                    <tr>
                        <td>@revenueReportRow.InvoiceDateTimeDisplay</td>
                        <td>@revenueReportRow.InvoiceTypeDisplay</td>
                        <td>@revenueReportRow.CustomerNameDisplay</td>
                        <td>@revenueReportRow.PetNameDisplay</td>
                        <td>@revenueReportRow.StatusDisplay</td>
                        <td>@revenueReportRow.SubtotalDisplay</td>
                        <td>@revenueReportRow.TaxAmountDisplay</td>
                        <td>@revenueReportRow.DiscountAmountDisplay</td>
                        <td>@revenueReportRow.TotalAmountDisplay</td>
                        <td>@revenueReportRow.AmountPaidDisplay</td>
                        <td>@revenueReportRow.BalanceDisplay</td>

                        <td>
                            @Html.ActionLink(
                                "View",
                                "Read",
                                "Invoices",
                                new { invoiceId = revenueReportRow.InvoiceId },
                                new { @class = "btn btn-sm btn-outline-primary" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (Model.HasSearched)
{
    <div class="alert alert-info text-center mt-4">
        No invoices matched the selected revenue report filters.
    </div>
}
