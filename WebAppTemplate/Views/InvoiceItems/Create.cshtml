@model JamesPetBoarding.ViewModels.InvoiceItemFormVM
@{
    ViewBag.Title = "Create Invoice Item";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Create Invoice Item</h2>
    <p class="lead">
        Enter boarding and/or service information to create a new invoice item.
    </p>
</div>

@using (Html.BeginForm("Create", "InvoiceItems", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })


    @Html.HiddenFor(x => x.InvoiceId)
    <div class="col-md-12">
        <label class="form-label">Invoice</label>
        <input type="text"
               class="form-control"
               value="@Model.InvoiceDisplay"
               readonly="readonly" />
        @Html.ValidationMessageFor(x => x.InvoiceId, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-12">
        <label class="form-label">Boarding</label>
        @Html.DropDownListFor(x => x.BoardingId, Model.BoardingSelectList, "Select Boarding...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.BoardingId, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-12">
        <label class="form-label">Service</label>
        @Html.DropDownListFor(x => x.ServiceId, Model.ServiceSelectList, "Select Service...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.ServiceId, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Invoice Item Type</label>
        @Html.EnumDropDownListFor(x => x.ItemType, "Select...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.ItemType, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Description</label>
        @Html.TextBoxFor(x => x.Description, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.Description, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Quantity</label>
        @Html.TextBoxFor(x => x.Quantity, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.Quantity, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Unit Price</label>
        @Html.TextBoxFor(x => x.UnitPrice, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.UnitPrice, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-12">
        <label class="form-label">Notes</label>
        @Html.TextAreaFor(x => x.Notes, new { @class = "form-control", rows = "4", placeholder = "Enter notes" })
        @Html.ValidationMessageFor(x => x.Notes, "", new { @class = "text-danger" })
    </div>

    <div class="col-12 text-center mt-4">
        <button type="submit" class="btn btn-primary me-2">Create Invoice Item</button>

        @Html.ActionLink(
            "Back to Invoice",
            "Read",
            "Invoices",
            new { invoiceId = Model.InvoiceId },
            new { @class = "btn btn-secondary ms-2" })
    </div>

}
