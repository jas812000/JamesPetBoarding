@model JamesPetBoarding.ViewModels.ServiceSearchVM
@{
    ViewBag.Title = "Search Services";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Search Services</h2>
    <p class="lead">
        Search by one or more fields to find an existing service profile.
    </p>
</div>

@using (Html.BeginForm("Search", "Services", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    <div class="col-md-2">
        <label class="form-label">Service Name</label>
        @Html.EnumDropDownListFor(x => x.ServiceName, "Select...", new { @class = "form-select" })
    </div>

    <div class="col-md-2">
        <label class="form-label">Species</label>
        @Html.EnumDropDownListFor(x => x.Species, "Select...", new { @class = "form-select" })
    </div>

    <div class="col-md-2">
        <label class="form-label">Pricing Type</label>
        @Html.EnumDropDownListFor(x => x.PricingType, "Select...", new { @class = "form-select" })
    </div>

    <div class="col-12 text-center mt-4">
        <button type="submit" class="btn btn-primary me-2">Search Services</button>

        @if (ViewBag.CanManageServices)
        {
            @Html.ActionLink(
                "Create Service",
                "Create",
                "Services",
                null,
                new { @class = "btn btn-success ms-2" })
        }
    </div>

}

@if (Model.ServiceSummaryResults != null && Model.ServiceSummaryResults.Any())
{
    <h4 class="mt-4">
        Results Found: @Model.ServiceSummaryResults.Count
    </h4>

    <div class="mt-3">

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Service Name</th>
                    <th>Species</th>
                    <th>Base Price</th>
                    <th>Pricing Type</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var service in Model.ServiceSummaryResults)
                {
                    <tr>
                        <td>@service.ServiceNameDisplay</td>
                        <td>@service.SpeciesDisplay</td>
                        <td>@service.BasePriceDisplay</td>
                        <td>@service.PricingTypeDisplay</td>

                        <td>
                            @Html.ActionLink(
                                 "View",
                                 "Read",
                                 "Services",
                                 new { serviceId = service.ServiceId },
                                 new { @class = "btn btn-primary btn-sm me-1" })

                            @if (ViewBag.CanManageServices)
                            {
                                @Html.ActionLink(
                                    "Update",
                                    "Update",
                                    "Services",
                                    new { serviceId = service.ServiceId },
                                    new { @class = "btn btn-warning btn-sm me-1" })

                                @Html.ActionLink(
                                    "Delete",
                                    "Delete",
                                    "Services",
                                    new { serviceId = service.ServiceId },
                                    new { @class = "btn btn-danger btn-sm" })
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Request.HttpMethod == "POST" &&
    Model.ServiceSummaryResults != null &&
    !Model.ServiceSummaryResults.Any())
{
    <div class="alert alert-info mt-4">
        No service profile matched the search criteria.
    </div>
}
