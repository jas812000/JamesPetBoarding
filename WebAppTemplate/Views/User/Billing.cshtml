@{
    ViewBag.Title = "Billing";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="text-center border-bottom pb-4 mb-5">
    <h1>Paws &amp; Reservations, LLC</h1>
    <h2>Billing</h2>
</div>

<div class="row g-4 justify-content-center">

    <div class="col-md-5">
        @Html.ActionLink(
            "Create Invoice",
            "Create",
            "Invoices",
            null,
            new { @class = "btn btn-primary w-100 py-4" })
    </div>

    <div class="col-md-5">
        @Html.ActionLink(
            "Search Invoices",
            "Search",
            "Invoices",
            null,
            new { @class = "btn btn-primary w-100 py-4" })
    </div>

    <div class="col-md-5">
        @Html.ActionLink(
            "Search Payments",
            "Search",
            "Payments",
            null,
            new { @class = "btn btn-primary w-100 py-4" })
    </div>

</div>

<div class="text-center mt-5">
    @Html.ActionLink(
        "Back to Dashboard",
        "Index",
        "User",
        null,
        new { @class = "btn btn-secondary" })
</div>