@model JamesPetBoarding.ViewModels.VaccineSearchVM
@{
    ViewBag.Title = "Search Vaccines";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Search Vaccines</h2>
    <p class="lead">
        Search by one or more fields to find an existing vaccine profile.
    </p>
</div>

@using (Html.BeginForm("Search", "Vaccines", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    <div class="col-md-4">
        <label class="form-label">Vaccine Name</label>
        @Html.TextBoxFor(x => x.VaccineName, new { @class = "form-control" })
    </div>

    <div class="col-md-2">
        <label class="form-label">Species</label>
        @Html.EnumDropDownListFor(x => x.Species, "Select...", new { @class = "form-select" })
    </div>

    <div class="col-6">
        <label class="form-label">Vaccine Required</label>
        @Html.DropDownListFor(
             x => x.RequiredFlag,
             new List<SelectListItem>
             {
                new SelectListItem { Text = "All Vaccines", Value = "" },
                new SelectListItem { Text = "Required", Value = "true" },
                new SelectListItem { Text = "Not Required", Value = "false" }
             },
             new { @class = "form-select" })

        <small class="text-muted">Select All Vaccines, Required or Not Required.</small>
    </div>

    <div class="col-12 text-center mt-4">
        <button type="submit" class="btn btn-primary me-2">Search Vaccines</button>

        @Html.ActionLink(
            "Create Vaccine", 
            "Create", 
            "Vaccines", 
            null, 
            new { @class = "btn btn-success ms-2" })
    </div>

}

@if (Model.VaccineSummaryResults != null && Model.VaccineSummaryResults.Any())
{
    <h4 class="mt-4">
        Results Found: @Model.VaccineSummaryResults.Count
    </h4>

    <div class="mt-3">

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Vaccine Name</th>
                    <th>Species</th>
                    <th>Required Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var vaccine in Model.VaccineSummaryResults)
                {
                    <tr>
                        <td>@vaccine.VaccineName</td>
                        <td>@vaccine.SpeciesDisplay</td>
                        <td>@vaccine.RequiredDisplay</td>

                        <td>
                            @Html.ActionLink(
                                 "View",
                                 "Read",
                                 "Vaccines",
                                 new { vaccineId = vaccine.VaccineId },
                                 new { @class = "btn btn-primary btn-sm me-1" })

                            @Html.ActionLink(
                                 "Update",
                                 "Update",
                                 "Vaccines",
                                 new { vaccineId = vaccine.VaccineId },
                                 new { @class = "btn btn-warning btn-sm me-1" })

                            @Html.ActionLink(
                                 "Delete",
                                 "Delete",
                                 "Vaccines",
                                 new { vaccineId = vaccine.VaccineId },
                                 new { @class = "btn btn-danger btn-sm" })

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.VaccineSummaryResults != null && !Model.VaccineSummaryResults.Any())
{
    <div class="alert alert-info mt-4">
        No vaccines matched the search criteria.
    </div>
}
