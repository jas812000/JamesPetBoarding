@model JamesPetBoarding.ViewModels.VaccineFormVM
@{
    ViewBag.Title = "Create Vaccine";
}

<div class="text-center border-bottom pb-4 mb-4">
    <h1> Paws &amp; Reservations, LLC</h1>
    <h2>Create Vaccine Profile</h2>
    <p class="lead">
        Enter vaccine information to create a new vaccine profile.
    </p>
</div>


@using (Html.BeginForm("Create", "Vaccines", FormMethod.Post, new { @class = "row g-3 justify-content-center" }))
{

    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })


    <div class="col-md-4">
        <label class="form-label">Vaccine Name</label>
        @Html.TextBoxFor(x => x.VaccineName, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.VaccineName, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-2">
        <label class="form-label">Species</label>
        @Html.EnumDropDownListFor(x => x.Species, "Select...", new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.Species, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-4">
        <label class="form-label">Required Status</label>
        @Html.DropDownListFor(x => x.RequiredFlag,
            new List<SelectListItem>
            {
                new SelectListItem { Text = "Select...", Value = "" },
                new SelectListItem { Text = "Required", Value = "true" },
                new SelectListItem { Text = "Not Required", Value = "false" },
            },
            new { @class = "form-select" })
        @Html.ValidationMessageFor(x => x.RequiredFlag, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-8">
        <label class="form-label">Notes</label>
        @Html.TextAreaFor(x => x.Notes, new { @class = "form-control", rows = "4", placeholder = "Enter notes" })
        @Html.ValidationMessageFor(x => x.Notes, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-8 text-center mt-4">
        <button type="submit" class="btn btn-primary me-2">Create Vaccine Profile</button>

        @Html.ActionLink("Cancel", "Search", "Vaccines", null, new { @class = "btn btn-secondary ms-2" })
    </div>

}
